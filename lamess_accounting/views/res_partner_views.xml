<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_accounting" model="ir.ui.view">
        <field name="name">res.partner.form.accounting</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="lamess_membership.view_partner_form_membership"/>
        <field name="arch" type="xml">
            <page name="lamess_network" position="inside">
                <group string="Wallet">
                    <group>
                        <field name="x_wallet_balance" string="Wallet Balance (€)"/>
                        <field name="x_ytd_gross_withdrawals" string="YTD Gross Withdrawals (€)"/>
                    </group>
                </group>
                <group string="Autofattura (fiscale)" invisible="not x_is_networker">
                    <group>
                        <field name="x_inps_rate_pct"/>
                        <field name="x_vat_exempt"/>
                    </group>
                    <group>
                        <field name="x_autoinv_letter"/>
                        <field name="x_autoinv_last_seq_year" readonly="1"/>
                        <field name="x_autoinv_last_seq_number" readonly="1"/>
                    </group>
                </group>
            </page>
            <div class="oe_button_box" name="button_box" position="inside">
                <button name="action_open_payout_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        string="Richieste prelievo"
                        invisible="not x_is_networker">
                    <field name="x_payout_request_count" widget="statinfo" string="Richieste"/>
                </button>
                <button name="action_request_payout"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        string="Richiedi prelievo"
                        invisible="not x_is_networker"/>
            </div>
        </field>
    </record>
</odoo>
