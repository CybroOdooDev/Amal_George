          <group>
            <group>
              <field name="x_name"/>
              <field name="x_studio_contract_id"/>
              <field name="x_studio_date"/>
            </group>
            <group>
              <field name="x_studio_amount"/>
              <field name="x_studio_late_fee_amount"/>
              <field name="x_studio_total_amount"/>
              <field name="x_studio_invoice_id"/>
              <field name="x_studio_payment_state"/>
