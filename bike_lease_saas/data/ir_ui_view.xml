<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- ============================================================ -->
  <!-- 1. FLEET VEHICLE & MODEL INHERITED EXTENSIONS                -->
  <!-- ============================================================ -->

  <!-- Inherit Fleet Vehicle Form View to Add Lease Specific Info & Smart Buttons -->
  <record id="fleet_vehicle_view_form_inherit_bike_lease" model="ir.ui.view">
    <field name="name">fleet.vehicle.form.inherit.bike.lease</field>
    <field name="model">fleet.vehicle</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='model_id']" position="attributes">
        <attribute name="domain">[('vehicle_type', '=', 'bike')] if context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly') else []</attribute>
        <attribute name="context">{'default_vehicle_type': 'bike' if (context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')) else False, 'bike_lease_readonly': bool(context.get('bike_lease_readonly'))}</attribute>
      </xpath>
      <xpath expr="//page[@name='page_tax_info']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='order_date']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='write_off_date']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='manager_id']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='location']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='plan_to_change_vehicle']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//label[@for='plan_to_change_vehicle']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="%(action_bike_contracts)d" type="action" class="oe_stat_button" icon="fa-book">
          <div class="o_stat_info">
            <span class="o_stat_text">Lease Contracts</span>
          </div>
        </button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Lease Information &amp; Documents" name="lease_info">
          <group>
            <group string="Lease Expiries">
              <field name="x_studio_insurance_expiry"/>
              <field name="x_studio_registration_expiry"/>
            </group>
            <group string="Surcharges &amp; Availability">
              <field name="x_studio_status" widget="badge" decoration-success="x_studio_status == 'Available'" decoration-info="x_studio_status == 'Leased'" decoration-warning="x_studio_status in ('Reserved', 'Maintenance')" decoration-danger="x_studio_status == 'Retired'"/>
              <field name="x_studio_has_additional_charge" widget="boolean_toggle"/>
              <field name="x_studio_additional_daily_charge" invisible="not x_studio_has_additional_charge"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Inherit Fleet Vehicle Model Form View -->
  <record id="fleet_vehicle_model_view_form_inherit_bike_lease" model="ir.ui.view">
    <field name="name">fleet.vehicle.model.form.inherit.bike.lease</field>
    <field name="model">fleet.vehicle.model</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='vehicle_type']" position="attributes">
        <attribute name="readonly">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//sheet" position="inside">
        <group string="Bike Leasing Specifications">
          <group>
            <field name="x_studio_bike_type"/>
            <field name="x_studio_engine_capacity_cc_"/>
          </group>
          <group>
            <field name="x_studio_value" string="Catalog List Price"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 2. LEASE PLANS (x_lease_plans) VIEWS                         -->
  <!-- ============================================================ -->
  <record id="view_x_lease_plans_list" model="ir.ui.view">
    <field name="name">x_lease_plans.list</field>
    <field name="model">x_lease_plans</field>
    <field name="arch" type="xml">
      <list string="Lease Plans">
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name" string="Plan Name"/>
        <field name="x_studio_lease_duration" string="Duration"/>
        <field name="x_studio_duration_unit" string="Unit"/>
        <field name="x_studio_payment_frequency" string="Payment Frequency"/>
        <field name="x_studio_value" string="Lease Amount"/>
        <field name="x_studio_security_deposit" string="Security Deposit"/>
        <field name="x_studio_late_fee_type" string="Late Fee Type"/>
      </list>
    </field>
  </record>

  <record id="view_x_lease_plans_form" model="ir.ui.view">
    <field name="name">x_lease_plans.form</field>
    <field name="model">x_lease_plans</field>
    <field name="arch" type="xml">
      <form string="Lease Plan">
        <sheet>
          <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="x_active"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
            <h1>
              <field name="x_name" required="1" placeholder="Plan Name..."/>
            </h1>
          </div>
          <group>
            <group string="Duration &amp; Frequency">
              <field name="x_studio_lease_duration" required="1"/>
              <field name="x_studio_duration_unit" required="1"/>
              <field name="x_studio_payment_frequency" required="1"/>
            </group>
            <group string="Pricing &amp; Security Deposit">
              <field name="x_studio_currency_id" invisible="1"/>
              <field name="x_studio_value" required="1"/>
              <field name="x_studio_security_deposit" required="1"/>
              <field name="x_studio_initial_payment"/>
            </group>
          </group>
          <group string="Late Fee Configuration">
            <group>
              <field name="x_studio_late_fee_type" required="1"/>
              <field name="x_studio_late_fee" invisible="x_studio_late_fee_type != 'Fixed Amount'"/>
              <field name="x_studio_late_fee_percentage" invisible="x_studio_late_fee_type != 'Percentage'"/>
            </group>
          </group>
          <group string="Description">
            <field name="x_studio_description" placeholder="Plan terms and conditions description..." nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_x_lease_plans_search" model="ir.ui.view">
    <field name="name">x_lease_plans.search</field>
    <field name="model">x_lease_plans</field>
    <field name="arch" type="xml">
      <search string="Lease Plans">
        <field name="x_name"/>
        <filter string="Archived" name="archived" domain="[('x_active', '=', False)]"/>
      </search>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 3. LEASE APPLICATIONS (x_lease_application) VIEWS            -->
  <!-- ============================================================ -->
  <record id="view_x_lease_application_list" model="ir.ui.view">
    <field name="name">x_lease_application.list</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <list string="Lease Applications" default_order="id desc">
        <field name="x_name" string="Application No."/>
        <field name="x_studio_partner_id" string="Customer"/>
        <field name="x_studio_date" string="Application Date"/>
        <field name="x_studio_bike_model" string="Model"/>
        <field name="x_studio_bike" string="Vehicle"/>
        <field name="x_studio_lease_plan" string="Plan"/>
        <field name="x_studio_selection_1" widget="badge" decoration-info="x_studio_selection_1 in ('Draft', 'Submitted', 'Under Review')" decoration-success="x_studio_selection_1 in ('Approved', 'Converted to Contract')" decoration-danger="x_studio_selection_1 == 'Rejected'" decoration-muted="x_studio_selection_1 == 'Cancelled'"/>
      </list>
    </field>
  </record>

  <record id="view_x_lease_application_form" model="ir.ui.view">
    <field name="name">x_lease_application.form</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <form string="Lease Application">
        <header>
          <button name="%(action_app_approve)d" type="action" string="Approve Application" class="oe_highlight" invisible="x_studio_selection_1 not in ('Draft', 'Submitted', 'Under Review')"/>
          <button name="%(action_open_reject_wizard)d" type="action" string="Reject Application" invisible="x_studio_selection_1 in ('Converted to Contract', 'Rejected', 'Cancelled')"/>
          <field name="x_studio_selection_1" widget="statusbar" statusbar_visible="Draft,Submitted,Under Review,Approved,Converted to Contract,Rejected"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="x_name" readonly="1"/>
            </h1>
          </div>
          <group>
            <group string="Applicant Information">
              <field name="x_studio_partner_id" required="1" readonly="x_studio_selection_1 not in ('Draft', 'Submitted')"/>
              <field name="x_studio_partner_phone"/>
              <field name="x_studio_partner_email"/>
              <field name="x_studio_date" required="1" readonly="x_studio_selection_1 not in ('Draft', 'Submitted')"/>
            </group>
            <group string="Vehicle &amp; Plan Selection">
              <field name="x_studio_bike_model" required="1" readonly="x_studio_selection_1 not in ('Draft', 'Submitted')" domain="[('vehicle_type', '=', 'bike')]" context="{'default_vehicle_type': 'bike', 'bike_lease_readonly': True}"/>
              <field name="x_studio_bike" options="{'no_create': True}" readonly="x_studio_selection_1 not in ('Draft', 'Submitted')" domain="[('vehicle_type', '=', 'bike'), ('model_id', '=', x_studio_bike_model)] if x_studio_bike_model else [('vehicle_type', '=', 'bike')]"/>
              <field name="x_studio_lease_plan" required="1" readonly="x_studio_selection_1 not in ('Draft', 'Submitted')"/>
              <field name="x_studio_lease_start_date" readonly="x_studio_selection_1 not in ('Draft', 'Submitted')"/>
            </group>
          </group>
          <notebook>
            <page string="Customer Documents" name="documents">
              <group>
                <field name="x_studio_customer_documents" filename="x_studio_customer_documents_filename"/>
                <field name="x_studio_customer_documents_filename" invisible="1"/>
              </group>
            </page>
            <page string="Rejection Details" name="rejection" invisible="x_studio_selection_1 != 'Rejected'">
              <group>
                <field name="x_studio_rejection_reason_ids" widget="many2many_tags" readonly="1"/>
                <field name="x_studio_reason" readonly="1"/>
              </group>
            </page>
            <page string="Contract Reference" name="contract_ref" invisible="not x_studio_contract_id">
              <group>
                <field name="x_studio_contract_id" readonly="1"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_x_lease_application_kanban" model="ir.ui.view">
    <field name="name">x_lease_application.kanban</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <kanban default_group_by="x_studio_selection_1" class="o_kanban_small_column">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike_model"/>
        <field name="x_studio_lease_plan"/>
        <field name="x_studio_selection_1"/>
        <templates>
          <t t-name="card" class="oe_kanban_global_click p-3 border shadow-sm rounded-3 bg-white mb-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <strong class="text-primary"><field name="x_name"/></strong>
              <field name="x_studio_selection_1" widget="badge"/>
            </div>
            <div class="text-dark fw-bold mb-1"><field name="x_studio_partner_id"/></div>
            <div class="text-muted small"><field name="x_studio_bike_model"/> - <field name="x_studio_lease_plan"/></div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_x_lease_application_search" model="ir.ui.view">
    <field name="name">x_lease_application.search</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <search string="Lease Applications">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike_model"/>
        <field name="x_studio_bike"/>
        <filter string="Draft" name="draft" domain="[('x_studio_selection_1', '=', 'Draft')]"/>
        <filter string="Approved" name="approved" domain="[('x_studio_selection_1', '=', 'Approved')]"/>
        <filter string="Converted" name="converted" domain="[('x_studio_selection_1', '=', 'Converted to Contract')]"/>
      </search>
    </field>
  </record>

  <record id="view_x_lease_application_calendar" model="ir.ui.view">
    <field name="name">x_lease_application.calendar</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <calendar string="Lease Applications" date_start="x_studio_date" color="x_studio_partner_id">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_selection_1"/>
      </calendar>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 4. LEASE CONTRACTS (x_lease_contract) VIEWS                   -->
  <!-- ============================================================ -->
  <record id="view_x_lease_contract_list" model="ir.ui.view">
    <field name="name">x_lease_contract.list</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <list string="Lease Contracts" default_order="id desc">
        <field name="x_name" string="Contract No."/>
        <field name="x_studio_partner_id" string="Customer"/>
        <field name="x_studio_date" string="Start Date"/>
        <field name="x_studio_end_date" string="End Date"/>
        <field name="x_studio_bike" string="Vehicle"/>
        <field name="x_studio_lease_plan" string="Plan"/>
        <field name="x_studio_deposit_paid" string="Deposit Paid"/>
        <field name="x_studio_selection_1" widget="badge" decoration-info="x_studio_selection_1 == 'Draft'" decoration-success="x_studio_selection_1 == 'Active'" decoration-muted="x_studio_selection_1 in ('Closed', 'Cancelled')"/>
      </list>
    </field>
  </record>

  <record id="view_x_lease_contract_form" model="ir.ui.view">
    <field name="name">x_lease_contract.form</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <form string="Lease Contract">
        <header>
          <button name="%(action_pay_security_deposit)d" type="action" string="Create Security Deposit Invoice" class="oe_highlight" invisible="x_studio_selection_1 != 'Draft'"/>
          <button name="%(action_cnt_cancel)d" type="action" string="Cancel Contract" class="btn-secondary" invisible="x_studio_selection_1 != 'Draft'"/>
          <button name="%(action_open_return_wizard)d" type="action" string="Return &amp; Inspect Vehicle" class="btn-warning" invisible="x_studio_selection_1 != 'Active'"/>
          <button name="%(action_cnt_renew)d" type="action" string="Renew Contract" class="btn-info" invisible="x_studio_selection_1 not in ('Active', 'Closed')"/>
          <field name="x_studio_selection_1" widget="statusbar" statusbar_visible="Draft,Active,Completed,Cancelled"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="x_name" readonly="1"/>
            </h1>
          </div>
          <group>
            <group string="Contract &amp; Customer Details">
              <field name="x_studio_partner_id" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
              <field name="x_studio_partner_phone"/>
              <field name="x_studio_partner_email"/>
              <field name="x_studio_application_id" readonly="1"/>
            </group>
            <group string="Lease Dates &amp; Vehicle">
              <field name="x_studio_date" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
              <field name="x_studio_end_date" required="1"/>
              <field name="x_studio_bike_model" readonly="1" domain="[('vehicle_type', '=', 'bike')]"/>
              <field name="x_studio_bike" required="1" options="{'no_create': True}" readonly="x_studio_selection_1 != 'Draft'" domain="[('vehicle_type', '=', 'bike')]"/>
              <field name="x_studio_lease_plan" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Installments &amp; Invoices" name="installments">
              <field name="x_studio_installment_ids" readonly="x_studio_selection_1 == 'Closed'">
                <list string="Installments" editable="bottom">
                  <field name="x_name"/>
                  <field name="x_studio_date"/>
                  <field name="x_studio_amount"/>
                  <field name="x_studio_late_fee_amount"/>
                  <field name="x_studio_total_amount"/>
                  <field name="x_studio_invoice_id" readonly="1"/>
                  <field name="x_studio_payment_state" widget="badge"/>
                  <field name="x_studio_is_overdue" widget="boolean_toggle"/>
                </list>
              </field>
            </page>
            <page string="Deposit &amp; Financial Settlement" name="settlement">
              <group>
                <group string="Deposit Status">
                  <field name="x_studio_deposit_invoice_id" readonly="1"/>
                  <field name="x_studio_deposit_paid" readonly="1"/>
                  <field name="x_studio_return_invoice_id" readonly="1"/>
                </group>
                <group string="Return Inspection Settlement">
                  <field name="x_studio_bike_returned" readonly="1"/>
                  <field name="x_studio_repair_charge" readonly="1"/>
                  <field name="x_studio_refund_amount" readonly="1"/>
                  <field name="x_studio_extra_charge" readonly="1"/>
                  <field name="x_studio_service_needed" readonly="1"/>
                </group>
              </group>
            </page>
            <page string="Inspection Issues" name="issues" invisible="not x_studio_issue_ids">
              <field name="x_studio_issue_ids" widget="many2many_tags" readonly="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_x_lease_contract_kanban" model="ir.ui.view">
    <field name="name">x_lease_contract.kanban</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <kanban default_group_by="x_studio_selection_1" class="o_kanban_small_column">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike"/>
        <field name="x_studio_lease_plan"/>
        <field name="x_studio_selection_1"/>
        <templates>
          <t t-name="card" class="oe_kanban_global_click p-3 border shadow-sm rounded-3 bg-white mb-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <strong class="text-primary"><field name="x_name"/></strong>
              <field name="x_studio_selection_1" widget="badge"/>
            </div>
            <div class="text-dark fw-bold mb-1"><field name="x_studio_partner_id"/></div>
            <div class="text-muted small"><field name="x_studio_bike"/> - <field name="x_studio_lease_plan"/></div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_x_lease_contract_search" model="ir.ui.view">
    <field name="name">x_lease_contract.search</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <search string="Lease Contracts">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike"/>
        <filter string="Active" name="active" domain="[('x_studio_selection_1', '=', 'Active')]"/>
        <filter string="Closed" name="closed" domain="[('x_studio_selection_1', '=', 'Closed')]"/>
      </search>
    </field>
  </record>

  <record id="view_x_lease_contract_calendar" model="ir.ui.view">
    <field name="name">x_lease_contract.calendar</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <calendar string="Lease Contracts" date_start="x_studio_date" date_stop="x_studio_end_date" color="x_studio_partner_id">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_selection_1"/>
      </calendar>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 5. LEASE INSTALLMENTS (x_lease_installment) VIEWS           -->
  <!-- ============================================================ -->
  <record id="view_x_lease_installment_list" model="ir.ui.view">
    <field name="name">x_lease_installment.list</field>
    <field name="model">x_lease_installment</field>
    <field name="arch" type="xml">
      <list string="Lease Installments" default_order="x_studio_date asc">
        <field name="x_name"/>
        <field name="x_studio_contract_id"/>
        <field name="x_studio_date"/>
        <field name="x_studio_amount"/>
        <field name="x_studio_late_fee_amount"/>
        <field name="x_studio_total_amount"/>
        <field name="x_studio_invoice_id"/>
        <field name="x_studio_payment_state" widget="badge"/>
        <field name="x_studio_is_overdue" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_x_lease_installment_form" model="ir.ui.view">
    <field name="name">x_lease_installment.form</field>
    <field name="model">x_lease_installment</field>
    <field name="arch" type="xml">
      <form string="Lease Installment">
        <sheet>
          <group>
            <group>
              <field name="x_name"/>
              <field name="x_studio_contract_id"/>
              <field name="x_studio_date"/>
            </group>
            <group>
              <field name="x_studio_amount"/>
              <field name="x_studio_late_fee_amount"/>
              <field name="x_studio_total_amount"/>
              <field name="x_studio_invoice_id"/>
              <field name="x_studio_payment_state"/>
              <field name="x_studio_is_overdue"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 6. WIZARDS & CRITERIA VIEWS                                  -->
  <!-- ============================================================ -->

  <!-- Rejection Reasons List -->
  <record id="view_x_rejection_reason_list" model="ir.ui.view">
    <field name="name">x_rejection_reason.list</field>
    <field name="model">x_rejection_reason</field>
    <field name="arch" type="xml">
      <list string="Rejection Reasons" editable="bottom">
        <field name="x_name"/>
      </list>
    </field>
  </record>

  <!-- Reject Application Wizard Form -->
  <record id="view_x_lease_application_reject_wizard_form" model="ir.ui.view">
    <field name="name">x_lease_application_reject_wizard.form</field>
    <field name="model">x_lease_application_reject_wizard</field>
    <field name="arch" type="xml">
      <form string="Reject Application">
        <group>
          <field name="x_studio_application_id" invisible="1"/>
          <field name="x_studio_rejection_reason_ids" widget="many2many_checkboxes"/>
          <field name="x_studio_reason" placeholder="Enter rejection reason details..."/>
        </group>
        <footer>
          <button name="%(action_confirm_reject_app)d" type="action" string="Confirm Rejection" class="btn-danger"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Bike Return Wizard Form -->
  <record id="view_x_bike_return_wizard_form" model="ir.ui.view">
    <field name="name">x_bike_return_wizard.form</field>
    <field name="model">x_bike_return_wizard</field>
    <field name="arch" type="xml">
      <form string="Return &amp; Inspection Wizard">
        <sheet>
          <group>
            <group string="Contract Information">
              <field name="x_studio_contract_id" readonly="1"/>
              <field name="x_studio_bike_returned" widget="boolean_toggle"/>
            </group>
            <group string="Service &amp; Repair Charges">
              <field name="x_studio_service_needed" widget="boolean_toggle"/>
              <field name="x_studio_repair_charge"/>
            </group>
          </group>
          <group string="Inspection Issues Checklist">
            <field name="x_studio_issue_ids" widget="many2many_checkboxes"/>
          </group>
        </sheet>
        <footer>
          <button name="%(action_confirm_return_wizard)d" type="action" string="Process Return &amp; Settlement" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Bike Issue List -->
  <record id="view_x_bike_issue_list" model="ir.ui.view">
    <field name="name">x_bike_issue.list</field>
    <field name="model">x_bike_issue</field>
    <field name="arch" type="xml">
      <list string="Bike Inspection Issues" editable="bottom">
        <field name="x_name"/>
      </list>
    </field>
  </record>
</odoo>
