<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add the SOP link to the Execution Steps list embedded on the BMR form. -->
    <record id="pharma_bmr_form_sop" model="ir.ui.view">
        <field name="name">pharma.bmr.form.sop</field>
        <field name="model">pharma.bmr</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_bmr_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='step_ids']/list/field[@name='description']" position="after">
                <field name="sop_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
