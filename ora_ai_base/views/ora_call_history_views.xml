<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ora_call_history_view_list" model="ir.ui.view">
        <field name="name">ora.call.history.view.list</field>
        <field name="model">ora.call.history</field>
        <field name="arch" type="xml">
            <list string="Call History" create="0" edit="0">
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="assistant_id"/>
                <field name="partner_id"/>
                <field name="call_type"/>
                <field name="duration" widget="integer"/>
                <field name="status" widget="badge" decoration-success="status == 'completed'" decoration-warning="status == 'started'" decoration-danger="status == 'failed'"/>
                <field name="order_id"/>
                <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="create_date" string="Date"/>
            </list>
        </field>
    </record>

    <record id="ora_call_history_view_form" model="ir.ui.view">
        <field name="name">ora.call.history.view.form</field>
        <field name="model">ora.call.history</field>
        <field name="arch" type="xml">
            <form string="Call Details" create="0">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="started,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="assistant_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="call_type" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="vapi_call_id" readonly="1"/>
                            <field name="duration" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="recording_url" widget="url" readonly="1" invisible="not recording_url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conversation Transcript" name="transcript">
                            <field name="transcript" readonly="1" placeholder="Transcript will appear here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ora_call_history_view_search" model="ir.ui.view">
        <field name="name">ora.call.history.view.search</field>
        <field name="model">ora.call.history</field>
        <field name="arch" type="xml">
            <search string="Search Calls">
                <field name="name"/>
                <field name="vapi_call_id"/>
                <field name="assistant_id"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter string="Completed Calls" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="With Sale Order" name="has_order" domain="[('order_id', '!=', False)]"/>
                <separator/>
                <group>
                    <filter string="Assistant" name="group_assistant" context="{'group_by': 'assistant_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Call Type" name="group_type" context="{'group_by': 'call_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ora_call_history_action" model="ir.actions.act_window">
        <field name="name">Call History</field>
        <field name="res_model">ora.call.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ora_call_history_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No voice call logs yet!
            </p>
            <p>
                As users interact with your AI Voice Assistants via WebRTC or phone calls, call transcripts, duration, and generated sale orders will be logged here.
            </p>
        </field>
    </record>
</odoo>
