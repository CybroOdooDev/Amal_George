<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add the "QA Release" action to the Manufacturing Order. In core the
         batch only reaches "Ready for QA Release"; this button (and the release
         it triggers) ships with the optional traceability tier. -->
    <record id="mrp_production_form_pharma_qa_release" model="ir.ui.view">
        <field name="name">mrp.production.form.pharma.qa.release</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="pharma_qa_release_exists" invisible="1"/>
                <button name="action_qa_release" type="object"
                        string="QA Release" class="btn-primary"
                        invisible="not qa_release_eligible or pharma_qa_release_exists"
                        groups="pharmaceutical_base.group_pharma_role_qa"/>
            </xpath>
        </field>
    </record>
</odoo>
