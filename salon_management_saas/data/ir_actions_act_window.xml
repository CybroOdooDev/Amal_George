  </record>
  <!--
    Today's Bookings Window Action:
    Filters the appointments list to show only today's active appointments
    (status is not in Draft or Cancelled) and disables record creation from this view.
  -->
  <record id="action_today_confirmed_bookings" model="ir.actions.act_window">
    <field name="name">Today's Bookings</field>
    <field name="res_model">x_appointment</field>
    <field name="view_mode">list,form,calendar,map,pivot,graph</field>
    <field name="domain">[('x_studio_selection_1', 'not in', ['Draft', 'Cancelled']), ('x_studio_date', '=', context_today().strftime('%Y-%m-%d'))]</field>
    <field name="context">{'default_x_studio_selection_1': 'Confirmed', 'create': False}</field>
  </record>
  <record id="action_salon_dashboard" model="ir.actions.act_window">
    <field name="name">Dashboard</field>
    <field name="res_model">x_appointment</field>
    <field name="view_mode">graph,pivot,kanban</field>
    <field name="context">{'graph_measure': 'x_studio_value', 'graph_mode': 'bar', 'graph_groupbys': ['x_studio_date']}</field>
  </record>
  <record id="action_salon_dashboard_client" model="ir.actions.client">
    <field name="name">Dashboard</field>
    <field name="tag">salon_dashboard_client_action</field>
  </record>
