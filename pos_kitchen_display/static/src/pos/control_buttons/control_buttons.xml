<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_display.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]" position="before">
            <button t-att-class="buttonClass" t-on-click="clickBooking">
                <i class="fa fa-calendar me-1"/>Booking
            </button>
            <button t-att-class="buttonClass" t-on-click="clickViewBookings">
                <i class="fa fa-list-alt me-1"/>View Bookings
            </button>
        </xpath>
    </t>
</templates>
