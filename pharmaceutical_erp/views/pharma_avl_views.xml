<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── pharma.avl — list view ────────────────────────────────────────── -->
    <record id="pharma_avl_list_view" model="ir.ui.view">
        <field name="name">pharma.avl.list</field>
        <field name="model">pharma.avl</field>
        <field name="arch" type="xml">
            <list string="Approved Vendor List" decoration-danger="status == 'blocked'"
                  decoration-warning="status == 'under_review'">
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'under_review'"
                       decoration-danger="status == 'blocked'"/>
                <field name="approval_date"/>
                <field name="approved_by"/>
                <field name="expiry_date"/>
                <field name="vendor_item_code" optional="show"/>
                <field name="lead_time_days" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ─── pharma.avl — form view ────────────────────────────────────────── -->
    <record id="pharma_avl_form_view" model="ir.ui.view">
        <field name="name">pharma.avl.form</field>
        <field name="model">pharma.avl</field>
        <field name="arch" type="xml">
            <form string="Approved Vendor">
                <header>
                    <button name="write" type="object" string="Approve"
                            class="btn-primary"
                            context="{'default_status': 'approved'}"
                            invisible="status == 'approved'"
                            groups="pharmaceutical_erp.group_pharma_qa_manager"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="vendor_id" placeholder="Vendor…"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Product / Vendor">
                            <field name="product_id"/>
                            <field name="vendor_id"/>
                            <field name="vendor_item_code"/>
                            <field name="lead_time_days"/>
                        </group>
                        <group string="Approval">
                            <field name="status"/>
                            <field name="approval_date"/>
                            <field name="approved_by"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional qualification remarks…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── pharma.avl — search view ──────────────────────────────────────── -->
    <record id="pharma_avl_search_view" model="ir.ui.view">
        <field name="name">pharma.avl.search</field>
        <field name="model">pharma.avl</field>
        <field name="arch" type="xml">
            <search string="Search AVL">
                <field name="product_id"/>
                <field name="vendor_id"/>
                <filter name="approved" string="Approved" domain="[('status','=','approved')]"/>
                <filter name="under_review" string="Under Review" domain="[('status','=','under_review')]"/>
                <filter name="blocked" string="Blocked" domain="[('status','=','blocked')]"/>
            </search>
        </field>
    </record>

    <!-- ─── pharma.avl — action ────────────────────────────────────────────── -->
    <record id="pharma_avl_action" model="ir.actions.act_window">
        <field name="name">Approved Vendor List</field>
        <field name="res_model">pharma.avl</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pharma_avl_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approved vendors yet.
            </p>
            <p>Add vendors to the Approved Vendor List to allow purchasing of pharma materials.</p>
        </field>
    </record>

</odoo>
