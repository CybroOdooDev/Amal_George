<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_display.BookingPopup">
        <Dialog size="'lg'" title="'Schedule Table Booking'">
            <div class="booking-container d-flex flex-column h-100">
                <div class="booking-form-body flex-grow-1 overflow-auto pe-1 mt-2">
                    <div t-if="state.errors.server" class="alert alert-danger d-flex align-items-center mb-3">
                        <i class="fa fa-exclamation-triangle me-2" />
                        <span t-out="state.errors.server" />
                    </div>

                    <div class="row">
                        <!-- LEFT COLUMN: Booking Info -->
                        <div class="col-md-6 border-end pe-4">
                            <h5 class="mb-3 text-primary"><i class="fa fa-info-circle me-2"/>Booking Information</h5>

                            <!-- Customer Name (Read-Only) -->
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Customer Name</label>
                                <input type="text" 
                                       class="form-control form-control-lg bg-light" 
                                       t-att-value="state.formData.partner_name" 
                                       readonly="1" />
                            </div>

                            <!-- Phone Number -->
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Phone Number</label>
                                <input type="tel" 
                                       class="form-control form-control-lg" 
                                       placeholder="e.g. +1 555-0199" 
                                       t-model="state.formData.phone" />
                            </div>

                            <div class="row">
                                <!-- Booking Date & Time -->
                                <div class="col-md-6 form-group mb-3">
                                    <label class="form-label fw-bold">Date &amp; Time <span class="text-danger">*</span></label>
                                    <input type="datetime-local" 
                                           t-attf-class="form-control form-control-lg #{state.errors.booking_date ? 'is-invalid' : ''}" 
                                           t-model="state.formData.booking_date" />
                                    <div t-if="state.errors.booking_date" class="invalid-feedback" t-out="state.errors.booking_date" />
                                </div>

                                <!-- Number of Guests -->
                                <div class="col-md-6 form-group mb-3">
                                    <label class="form-label fw-bold">Number of Guests</label>
                                    <input type="number" 
                                           t-attf-class="form-control form-control-lg #{state.errors.guests ? 'is-invalid' : ''}" 
                                           min="1" 
                                           t-model="state.formData.guests" />
                                    <div t-if="state.errors.guests" class="invalid-feedback" t-out="state.errors.guests" />
                                </div>
                            </div>

                            <!-- Table -->
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Table Selection</label>
                                <select class="form-select form-select-lg" t-model="state.formData.table_id">
                                    <t t-foreach="tables" t-as="table" t-key="table.id">
                                        <option t-att-value="table.id" t-out="getTableDisplay(table.id)" />
                                    </t>
                                </select>
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: Products Pre-ordering -->
                        <div class="col-md-6 ps-4">
                            <h5 class="mb-3 text-primary"><i class="fa fa-shopping-basket me-2"/>Pre-order Products</h5>

                            <!-- Search Product -->
                            <div class="position-relative mb-3">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="fa fa-search text-muted"/>
                                    </span>
                                    <input type="text" 
                                           class="form-control form-control-lg border-start-0 ps-0" 
                                           placeholder="Search product to add..." 
                                           t-model="state.productSearchQuery" />
                                </div>

                                <!-- Search Results Dropdown -->
                                <div t-if="searchedProducts.length > 0" class="position-absolute w-100 bg-white border rounded shadow-lg mt-1" style="z-index: 1050; max-height: 250px; overflow-y: auto;">
                                    <ul class="list-group list-group-flush mb-0">
                                        <t t-foreach="searchedProducts" t-as="product" t-key="product.id">
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center cursor-pointer" 
                                                t-on-click="() => this.addProduct(product)">
                                                <span class="fw-semibold" t-out="product.display_name"/>
                                                <span class="badge bg-primary rounded-pill"><i class="fa fa-plus"/></span>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </div>

                            <!-- Selected Products List -->
                            <div class="selected-products-container border rounded bg-light p-2" style="min-height: 250px; max-height: 320px; overflow-y: auto;">
                                <div t-if="state.selectedProducts.length === 0" class="d-flex flex-column align-items-center justify-content-center h-100 text-muted py-5">
                                    <i class="fa fa-clipboard fa-2x mb-2 text-muted opacity-50"/>
                                    <span>No pre-ordered products added</span>
                                </div>

                                <table t-else="" class="table table-sm table-hover align-middle mb-0 bg-white border rounded">
                                    <thead>
                                        <tr class="table-light">
                                            <th class="ps-2">Product</th>
                                            <th class="text-center" style="width: 130px;">Qty</th>
                                            <th class="text-center" style="width: 50px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.selectedProducts" t-as="item" t-key="item.product_id">
                                            <tr>
                                                <td class="ps-2 fw-semibold text-truncate" style="max-width: 160px;" t-out="item.product_name"/>
                                                <td>
                                                    <div class="input-group input-group-sm justify-content-center">
                                                        <button class="btn btn-outline-secondary px-2" type="button" t-on-click="() => this.updateQty(item.product_id, -1)">-</button>
                                                        <input type="text" class="form-control text-center bg-white" t-att-value="item.qty" readonly="1" style="max-width: 45px; font-weight: bold;"/>
                                                        <button class="btn btn-outline-secondary px-2" type="button" t-on-click="() => this.updateQty(item.product_id, 1)">+</button>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-link text-danger p-0" t-on-click="() => this.removeProduct(item.product_id)">
                                                        <i class="fa fa-trash"/>
                                                    </button>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FOOTER BUTTONS -->
                <t t-set-slot="footer">
                    <button class="btn btn-secondary btn-lg px-4 me-2" t-on-click="close">Cancel</button>
                    <button class="btn btn-primary btn-lg px-4 btn-booking-save" t-on-click="saveBooking">Save Booking</button>
                </t>
            </div>
        </Dialog>
    </t>
</templates>
