<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lamess_commission_settlement_list" model="ir.ui.view">
        <field name="name">lamess.commission.settlement.list</field>
        <field name="model">lamess.commission.settlement</field>
        <field name="arch" type="xml">
            <list string="Settlement commissioni" default_order="period_id desc, partner_id">
                <field name="period_id"/>
                <field name="partner_id"/>
                <field name="gross_amount" sum="Totale"/>
                <field name="runtime_line_count"/>
                <field name="state"/>
                <field name="posted_at"/>
                <field name="posted_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_lamess_commission_settlement_form" model="ir.ui.view">
        <field name="name">lamess.commission.settlement.form</field>
        <field name="model">lamess.commission.settlement</field>
        <field name="arch" type="xml">
            <form string="Settlement commissioni">
                <header>
                    <button name="action_confirm" type="object" string="Conferma" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post_to_wallet" type="object" string="Accredita wallet" class="btn-success" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Annulla" class="btn-secondary" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,posted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Periodo">
                            <field name="period_id"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="runtime_line_count" readonly="1"/>
                        </group>
                        <group string="Importi">
                            <field name="gross_amount" readonly="1"/>
                            <field name="payout_allocated_amount" readonly="1"/>
                            <field name="payout_request_count" readonly="1"/>
                            <field name="confirmed_at" readonly="1"/>
                            <field name="posted_at" readonly="1"/>
                            <field name="posted_by_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Righe bonus">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list default_order="bonus_type, id" editable="bottom">
                                    <field name="bonus_type"/>
                                    <field name="family_id"/>
                                    <field name="runtime_line_id"/>
                                    <field name="movement_id"/>
                                    <field name="base_pv"/>
                                    <field name="percentage"/>
                                    <field name="amount_eur" sum="Totale"/>
                                    <field name="rule_ref"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payout">
                            <button name="action_open_payout_requests" type="object" string="Apri richieste payout" class="btn-secondary"/>
                            <field name="payout_trace_line_ids" readonly="1">
                                <list>
                                    <field name="payout_request_id"/>
                                    <field name="partner_id"/>
                                    <field name="allocated_amount" sum="Totale collegato"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lamess_commission_settlement_search" model="ir.ui.view">
        <field name="name">lamess.commission.settlement.search</field>
        <field name="model">lamess.commission.settlement</field>
        <field name="arch" type="xml">
            <search string="Settlement commissioni">
                <field name="period_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <filter string="Bozze" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confermati" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Accreditati" name="posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter string="Raggruppa per periodo" name="group_period" context="{'group_by': 'period_id'}"/>
                <filter string="Raggruppa per consulente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Raggruppa per stato" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_lamess_commission_settlement" model="ir.actions.act_window">
        <field name="name">Settlement commissioni</field>
        <field name="res_model">lamess.commission.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lamess_commission_settlement_search"/>
    </record>

    <menuitem id="menu_lamess_commission_settlement"
              name="Settlement commissioni"
              parent="lamess_commission.menu_lamess_network_root"
              action="action_lamess_commission_settlement"
              sequence="25"
              groups="base.group_system,lamess_network.group_network_manager,lamess_network.group_network_finance"/>
</odoo>
