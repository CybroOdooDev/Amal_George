    <!-- Cold-chain raw material. None of the materials above need
         refrigeration — their storage_conditions (printed on the CoA) all say
         "below 25°C" — so the cold-chain storage class gets a material that
         genuinely requires 2-8 °C rather than repurposing one of them. -->
    <record id="product_rm_pancreatin_api" model="product.template">
        <field name="name">Pancreatin USP</field>
        <field name="default_code">RM-0009</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="tracking">lot</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="product_type_pharma">api</field>
        <field name="pharmacopoeial_ref">usp</field>
        <field name="storage_conditions">Store refrigerated at 2-8°C, protect from moisture.</field>
        <field name="is_favorite">True</field>
    </record>

