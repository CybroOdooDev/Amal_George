<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Defines a list view for languages -->
    <record id="ora_language_view_tree" model="ir.ui.view">
        <field name="name">ora.language.list.view</field>
        <field name="model">ora.language</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Languages">
                <field name="name" required="1"/>
                <field name="code" required="1"/>
                <field name="voice"/>
                <field name="first_msg"/>
            </list>
        </field>
    </record>

    <!-- Defines a form view for languages -->
    <record id="ora_language_view_form" model="ir.ui.view">
        <field name="name">ora.language.form.view</field>
        <field name="model">ora.language</field>
        <field name="arch" type="xml">
            <form string="Voice Assistant Language">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. English, French, Spanish" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. en, fr, es" required="1"/>
                            <field name="voice" placeholder="e.g. ElevenLabs or provider voice ID"/>
                        </group>
                        <group>
                            <field name="first_msg" placeholder="Default welcome message in this language"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Defines a search view for languages -->
    <record id="ora_language_view_search" model="ir.ui.view">
        <field name="name">ora.language.search.view</field>
        <field name="model">ora.language</field>
        <field name="arch" type="xml">
            <search string="Search Languages">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <!-- Action to open language list and form -->
    <record id="ora_language_action" model="ir.actions.act_window">
        <field name="name">Languages</field>
        <field name="res_model">ora.language</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new supported language!
            </p>
            <p>
                Configure languages, voices, and default welcome greetings used by the AI voice assistant.
            </p>
        </field>
    </record>
</odoo>

