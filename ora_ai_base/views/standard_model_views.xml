<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Smart Button -->
    <record id="view_order_form_inherit_ora_ai" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ora.ai</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_voice_calls" type="object" class="oe_stat_button" icon="phone" invisible="voice_call_count == 0">
                    <field name="voice_call_count" widget="statinfo" string="Voice Calls"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Account Move (Invoice) Smart Button -->
    <record id="view_move_form_inherit_ora_ai" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ora.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_voice_calls" type="object" class="oe_stat_button" icon="phone" invisible="voice_call_count == 0">
                    <field name="voice_call_count" widget="statinfo" string="Voice Calls"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Res Partner Smart Button -->
    <record id="view_partner_form_inherit_ora_ai" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ora.ai</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_voice_calls" type="object" class="oe_stat_button" icon="phone" invisible="voice_call_count == 0">
                    <field name="voice_call_count" widget="statinfo" string="Voice Calls"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

