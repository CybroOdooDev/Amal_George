<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- Custom Bike Vehicle Kanban View (Grid view, not pipeline grouped by state) -->
  <record id="view_fleet_vehicle_bike_kanban" model="ir.ui.view">
    <field name="name">fleet.vehicle.bike.kanban</field>
    <field name="model">fleet.vehicle</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" sample="1">
        <field name="id"/>
        <field name="name"/>
        <field name="model_id"/>
        <field name="license_plate"/>
        <field name="x_studio_status"/>
        <field name="x_studio_additional_daily_charge"/>
        <field name="x_studio_has_additional_charge"/>
        <templates>
          <t t-name="card" class="oe_kanban_global_click p-3 border shadow-sm rounded-3 bg-white mb-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <strong class="text-primary fs-6"><field name="name"/></strong>
              <field name="x_studio_status" widget="badge" readonly="1" decoration-success="x_studio_status == 'Available'" decoration-info="x_studio_status == 'Leased'" decoration-warning="x_studio_status in ('Reserved', 'Maintenance')" decoration-danger="x_studio_status == 'Retired'"/>
            </div>
            <div class="text-dark fw-bold mb-1"><field name="model_id"/></div>
            <div class="text-muted small mb-2">License Plate: <field name="license_plate"/></div>
            <t t-if="record.x_studio_has_additional_charge.raw_value">
              <div class="text-success small fw-semibold">
                Daily Charge: $<field name="x_studio_additional_daily_charge"/>
              </div>
            </t>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="bikes_27d7695f-da5f-4714-8a0d-33597178054d" model="ir.actions.act_window">
    <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            ]]></field>
    <field name="name">Bikes</field>
    <field name="res_model">fleet.vehicle</field>
    <field name="view_mode">kanban,list,form,pivot,graph</field>
    <field name="domain">[('vehicle_type', '=', 'bike')]</field>
    <field name="context">{'default_vehicle_type': 'bike', 'bike_lease_readonly': True, 'studio': True}</field>
  </record>

