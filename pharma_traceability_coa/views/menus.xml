<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Traceability / CoA / Audit Trail menus.

        This module is NOT a standalone application. Its menus are grafted onto
        the core Pharmaceutical ERP "Quality" app and the native Inventory
        "Traceability" menu, exactly where the core placeholders reserve them.
        Enabling the "Traceability, CoA & Audit Trail" setting installs this
        module and makes these entries appear; disabling it (uninstall) removes
        them.
    -->

    <!-- Certificates of Analysis — top level of the core Quality app -->
    <menuitem id="menu_pharma_coa_top" name="Certificates of Analysis"
        parent="pharmaceutical_base.menu_pharma_quality_root"
        action="pharma_traceability_coa.action_pharma_coa"
        groups="base.group_user" sequence="10"/>

    <!-- QA Release Queue — inside the Quality Control section -->
    <menuitem id="menu_pharma_qa_release_queue" name="QA Release Queue"
        parent="pharmaceutical_base.menu_pharma_quality"
        action="pharma_traceability_coa.pharma_qa_release_action"
        groups="pharmaceutical_base.group_pharma_qa_manager"
        sequence="70"/>

    <!-- Audit Trail — top level of the core Quality app -->
    <menuitem id="menu_pharma_audit_trail" name="Audit Trail"
        parent="pharmaceutical_base.menu_pharma_quality_root"
        action="pharma_traceability_coa.action_pharma_audit_trail"
        groups="pharmaceutical_base.group_audit_trail_feature"
        sequence="40"/>

    <!-- Batch Genealogy — under the native Inventory Traceability menu -->
    <menuitem id="menu_pharma_batch_genealogy" name="Batch Genealogy"
        parent="pharmaceutical_base.menu_pharma_traceability"
        action="pharma_traceability_coa.pharma_batch_genealogy_action"
        groups="base.group_user" sequence="10"/>
</odoo>
