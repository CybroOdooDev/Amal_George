<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- ============================================================ -->
  <!-- 1. FLEET VEHICLE & MODEL INHERITED EXTENSIONS                -->
  <!-- ============================================================ -->

  <!-- Inherit Fleet Vehicle Form View to Add Lease Specific Info & Smart Buttons -->
  <record id="fleet_vehicle_view_form_inherit_bike_lease" model="ir.ui.view">
    <field name="name">fleet.vehicle.form.inherit.bike.lease</field>
    <field name="model">fleet.vehicle</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='state_id']" position="replace">
        <field name="x_studio_company_bike_state_ids" invisible="1"/>
        <button name="%(action_bike_set_available)d" type="action" string="Set Available" class="btn-success" invisible="not (context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')) or state_id.name != 'Maintenance'"/>
        <button name="%(action_bike_send_maintenance)d" type="action" string="Send to Maintenance" class="btn-warning" invisible="not (context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')) or state_id.name not in ('Available', 'Retired')"/>
        <button name="%(action_bike_retire)d" type="action" string="Retire Bike" class="btn-danger" invisible="not (context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')) or state_id.name != 'Maintenance'"/>
        <field name="state_id" widget="statusbar" options="{'clickable': '1'}" domain="[('id', 'in', x_studio_company_bike_state_ids)]"/>
      </xpath>
      <xpath expr="//field[@name='model_id']" position="attributes">
        <attribute name="domain">[('vehicle_type', '=', 'bike')] if context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly') else []</attribute>
        <attribute name="context">{'default_vehicle_type': 'bike' if (context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')) else False, 'bike_lease_readonly': bool(context.get('bike_lease_readonly'))}</attribute>
      </xpath>
      <xpath expr="//button[field[@name='contract_count']]" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//page[@name='page_tax_info']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='order_date']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='write_off_date']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='manager_id']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='location']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='plan_to_change_vehicle']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//label[@for='plan_to_change_vehicle']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//group[field[@name='driver_id']]" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='future_driver_id']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='next_assignation_date']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='transmission']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//label[@for='power']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//div[field[@name='power']]" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//label[@for='horsepower']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//div[field[@name='horsepower']]" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//label[@for='vehicle_range']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//div[field[@name='vehicle_range']]" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//label[@for='co2']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//div[field[@name='co2']]" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//field[@name='co2_standard']" position="attributes">
        <attribute name="invisible">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="%(action_bike_contracts)d" type="action" class="oe_stat_button" icon="fa-book">
          <div class="o_stat_info">
            <span class="o_stat_text">Lease Contracts</span>
          </div>
        </button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Lease Information &amp; Documents" name="lease_info" invisible="not (context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly'))">
          <group>
            <group string="Lease Expiries">
              <field name="x_studio_insurance_expiry"/>
              <field name="x_studio_registration_expiry"/>
            </group>
            <group string="Surcharges &amp; Availability">
              <field name="state_id" widget="badge" readonly="1" decoration-success="state_id.name == 'Available'" decoration-info="state_id.name == 'Leased'" decoration-warning="state_id.name in ('Reserved', 'Maintenance')" decoration-danger="state_id.name == 'Retired'"/>
              <field name="x_studio_has_additional_charge" widget="boolean_toggle"/>
              <field name="x_studio_additional_daily_charge" invisible="not x_studio_has_additional_charge"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Inherit Fleet Vehicle Model Form View -->
  <record id="fleet_vehicle_model_view_form_inherit_bike_lease" model="ir.ui.view">
    <field name="name">fleet.vehicle.model.form.inherit.bike.lease</field>
    <field name="model">fleet.vehicle.model</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='vehicle_type']" position="attributes">
        <attribute name="readonly">context.get('default_vehicle_type') == 'bike' or context.get('bike_lease_readonly')</attribute>
      </xpath>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 2. LEASE PLANS (x_lease_plans) VIEWS                         -->
  <!-- ============================================================ -->
  <record id="view_x_lease_plans_list" model="ir.ui.view">
    <field name="name">x_lease_plans.list</field>
    <field name="model">x_lease_plans</field>
    <field name="arch" type="xml">
      <list string="Lease Plans">
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name" string="Plan Name"/>
        <field name="x_studio_lease_duration" string="Duration"/>
        <field name="x_studio_duration_unit" string="Unit"/>
        <field name="x_studio_payment_frequency" string="Payment Frequency"/>
        <field name="x_studio_value" string="Lease Amount"/>
        <field name="x_studio_security_deposit" string="Security Deposit"/>
        <field name="x_studio_late_fee_type" string="Late Fee Type"/>
      </list>
    </field>
  </record>

  <record id="view_x_lease_plans_form" model="ir.ui.view">
    <field name="name">x_lease_plans.form</field>
    <field name="model">x_lease_plans</field>
    <field name="arch" type="xml">
      <form string="Lease Plan">
        <sheet>
          <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="x_active"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
            <h1>
              <field name="x_name" required="1" placeholder="Plan Name..."/>
            </h1>
          </div>
          <group>
            <group string="Duration &amp; Frequency">
              <field name="x_studio_lease_duration" required="1"/>
              <field name="x_studio_duration_unit" required="1"/>
              <field name="x_studio_payment_frequency" required="1"/>
            </group>
            <group string="Pricing &amp; Security Deposit">
              <field name="x_studio_currency_id" invisible="1"/>
              <field name="x_studio_value" required="1"/>
              <field name="x_studio_security_deposit" required="1"/>
              <field name="x_studio_initial_payment"/>
            </group>
          </group>
          <group string="Late Fee Configuration">
            <group>
              <field name="x_studio_late_fee_type" required="1"/>
              <field name="x_studio_late_fee" invisible="x_studio_late_fee_type != 'Fixed Amount'"/>
              <field name="x_studio_late_fee_percentage" invisible="x_studio_late_fee_type != 'Percentage'"/>
            </group>
          </group>
          <group string="Description">
            <field name="x_studio_description" placeholder="Plan terms and conditions description..." nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_x_lease_plans_kanban" model="ir.ui.view">
    <field name="name">x_lease_plans.kanban</field>
    <field name="model">x_lease_plans</field>
    <field name="arch" type="xml">
      <kanban sample="1">
        <field name="id"/>
        <field name="x_name"/>
        <field name="x_studio_value"/>
        <field name="x_studio_currency_id"/>
        <field name="x_studio_lease_duration"/>
        <field name="x_studio_duration_unit"/>
        <field name="x_studio_payment_frequency"/>
        <field name="x_studio_security_deposit"/>
        <templates>
          <t t-name="card" class="oe_kanban_global_click p-3 bg-white border rounded-2 mb-2">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
              <span class="fw-bold text-dark fs-6"><field name="x_name"/></span>
              <span class="fw-bold text-primary">
                <field name="x_studio_value" widget="monetary" options="{'currency_field': 'x_studio_currency_id'}"/>
              </span>
            </div>
            <div class="text-muted small mb-2">
              <span>Duration: </span>
              <span class="text-dark fw-medium"><field name="x_studio_lease_duration"/> <field name="x_studio_duration_unit"/></span>
            </div>
            <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top">
              <span><field name="x_studio_payment_frequency"/></span>
              <t t-if="record.x_studio_security_deposit.raw_value">
                <span>Deposit: <field name="x_studio_security_deposit" widget="monetary" options="{'currency_field': 'x_studio_currency_id'}"/></span>
              </t>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_x_lease_plans_search" model="ir.ui.view">
    <field name="name">x_lease_plans.search</field>
    <field name="model">x_lease_plans</field>
    <field name="arch" type="xml">
      <search string="Lease Plans">
        <field name="x_name"/>
        <filter string="Archived" name="archived" domain="[('x_active', '=', False)]"/>
      </search>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 3. LEASE APPLICATIONS (x_lease_application) VIEWS            -->
  <!-- ============================================================ -->
  <record id="view_x_lease_application_list" model="ir.ui.view">
    <field name="name">x_lease_application.list</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <list string="Lease Applications" default_order="id desc">
        <field name="x_name" string="Application No."/>
        <field name="x_studio_partner_id" string="Customer"/>
        <field name="x_studio_date" string="Application Date"/>
        <field name="x_studio_bike_model" string="Model"/>
        <field name="x_studio_bike" string="Bike"/>
        <field name="x_studio_lease_plan" string="Plan"/>
        <field name="x_studio_selection_1" widget="badge" decoration-info="x_studio_selection_1 in ('Draft', 'Submitted', 'Under Review')" decoration-success="x_studio_selection_1 in ('Approved', 'Converted to Contract')" decoration-danger="x_studio_selection_1 == 'Rejected'" decoration-muted="x_studio_selection_1 == 'Cancelled'"/>
      </list>
    </field>
  </record>

  <record id="view_x_lease_application_form" model="ir.ui.view">
    <field name="name">x_lease_application.form</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <form string="Lease Application">
        <header>
          <button name="%(action_app_submit)d" type="action" string="Submit Application" class="oe_highlight" invisible="x_studio_selection_1 != 'Draft'"/>
          <button name="%(action_app_approve)d" type="action" string="Approve Application" class="oe_highlight" invisible="x_studio_selection_1 not in ('Submitted', 'Under Review')"/>
          <button name="%(action_open_reject_wizard)d" type="action" string="Reject Application" invisible="x_studio_selection_1 in ('Approved', 'Converted to Contract', 'Rejected', 'Cancelled')"/>
          <button name="%(action_app_reset_draft)d" type="action" string="Reset to Draft" invisible="x_studio_selection_1 not in ('Rejected', 'Cancelled')"/>
          <field name="x_studio_selection_1" widget="statusbar" statusbar_visible="Draft,Submitted,Under Review,Approved,Converted to Contract,Rejected"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="%(action_app_contracts)d" type="action" class="oe_stat_button" icon="fa-book" invisible="not x_studio_contract_id">
              <div class="o_stat_info">
                <span class="o_stat_text">Lease Contract</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="x_name" readonly="1"/>
            </h1>
          </div>
          <group>
            <group string="Applicant Information">
              <field name="x_studio_partner_id" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
              <field name="x_studio_partner_phone"/>
              <field name="x_studio_partner_email"/>
              <field name="x_studio_date" readonly="x_studio_selection_1 != 'Draft'"/>
            </group>
            <group string="Bike &amp; Plan Selection">
              <field name="x_studio_bike_model" required="1" readonly="x_studio_selection_1 != 'Draft'" domain="[('vehicle_type', '=', 'bike')]" context="{'default_vehicle_type': 'bike', 'bike_lease_readonly': True}"/>
              <field name="x_studio_bike" options="{'no_create': True}" readonly="x_studio_selection_1 != 'Draft'" domain="[('vehicle_type', '=', 'bike'), ('model_id', '=', x_studio_bike_model)] if x_studio_bike_model else [('vehicle_type', '=', 'bike')]" context="{'default_vehicle_type': 'bike', 'bike_lease_readonly': True}"/>
              <field name="x_studio_lease_plan" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
              <field name="x_studio_lease_start_date" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Customer Documents" name="documents">
              <group>
                <field name="x_studio_customer_documents" filename="x_studio_customer_documents_filename" readonly="x_studio_selection_1 != 'Draft'"/>
                <field name="x_studio_customer_documents_filename" invisible="1"/>
              </group>
            </page>
            <page string="Rejection Details" name="rejection" invisible="x_studio_selection_1 != 'Rejected'">
              <group>
                <field name="x_studio_rejection_reason_ids" widget="many2many_tags" readonly="1"/>
                <field name="x_studio_reason" readonly="1"/>
              </group>
            </page>
            <page string="Contract Reference" name="contract_ref" invisible="not x_studio_contract_id">
              <group>
                <field name="x_studio_contract_id" readonly="1"/>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_x_lease_application_kanban" model="ir.ui.view">
    <field name="name">x_lease_application.kanban</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <kanban default_group_by="x_studio_selection_1" class="o_kanban_small_column">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike_model"/>
        <field name="x_studio_lease_plan"/>
        <field name="x_studio_selection_1"/>
        <templates>
          <t t-name="card" class="oe_kanban_global_click p-3 border shadow-sm rounded-3 bg-white mb-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <strong class="text-primary"><field name="x_name"/></strong>
              <field name="x_studio_selection_1" widget="badge"/>
            </div>
            <div class="text-dark fw-bold mb-1"><field name="x_studio_partner_id"/></div>
            <div class="text-muted small"><field name="x_studio_bike_model"/> - <field name="x_studio_lease_plan"/></div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_x_lease_application_search" model="ir.ui.view">
    <field name="name">x_lease_application.search</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <search string="Lease Applications">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike_model"/>
        <field name="x_studio_bike"/>
        <filter string="Draft" name="draft" domain="[('x_studio_selection_1', '=', 'Draft')]"/>
        <filter string="Approved" name="approved" domain="[('x_studio_selection_1', '=', 'Approved')]"/>
        <filter string="Converted" name="converted" domain="[('x_studio_selection_1', '=', 'Converted to Contract')]"/>
      </search>
    </field>
  </record>

  <record id="view_x_lease_application_calendar" model="ir.ui.view">
    <field name="name">x_lease_application.calendar</field>
    <field name="model">x_lease_application</field>
    <field name="arch" type="xml">
      <calendar string="Lease Applications" date_start="x_studio_date" color="x_studio_partner_id">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_selection_1"/>
      </calendar>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 4. LEASE CONTRACTS (x_lease_contract) VIEWS                   -->
  <!-- ============================================================ -->
  <record id="view_x_lease_contract_list" model="ir.ui.view">
    <field name="name">x_lease_contract.list</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <list string="Lease Contracts" default_order="id desc" create="false">
        <field name="x_name" string="Contract No."/>
        <field name="x_studio_partner_id" string="Customer"/>
        <field name="x_studio_date" string="Start Date"/>
        <field name="x_studio_end_date" string="End Date"/>
        <field name="x_studio_bike" string="Bike"/>
        <field name="x_studio_lease_plan" string="Plan"/>
        <field name="x_studio_deposit_paid" string="Deposit Paid"/>
        <field name="x_studio_selection_1" widget="badge" decoration-info="x_studio_selection_1 == 'Draft'" decoration-success="x_studio_selection_1 == 'Active'" decoration-primary="x_studio_selection_1 == 'Completed'" decoration-warning="x_studio_selection_1 == 'Terminated'" decoration-danger="x_studio_selection_1 == 'Cancelled'"/>
      </list>
    </field>
  </record>

  <record id="view_x_lease_contract_form" model="ir.ui.view">
    <field name="name">x_lease_contract.form</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <form string="Lease Contract" create="false" duplicate="false">
        <header>
          <button name="%(action_pay_security_deposit)d" type="action" string="Create Security Deposit Invoice" class="oe_highlight" invisible="x_studio_selection_1 != 'Draft'"/>
          <button name="%(action_cnt_cancel)d" type="action" string="Cancel Contract" class="btn-secondary" invisible="x_studio_selection_1 != 'Draft'"/>
          <button name="%(action_create_lease_invoice)d" type="action" string="Create Installment Invoice" class="oe_highlight" invisible="x_studio_selection_1 != 'Active' or x_studio_all_installments_invoiced"/>
          <button name="%(action_cnt_complete)d" type="action" string="Complete Contract" class="btn-primary" invisible="x_studio_selection_1 != 'Active' or not x_studio_all_invoices_paid"/>
          <button name="%(action_cnt_terminate)d" type="action" string="Terminate Contract" class="btn-danger" invisible="x_studio_selection_1 != 'Active' or x_studio_pending_termination"/>
          <button name="%(action_open_return_wizard)d" type="action" string="Return &amp; Inspect Bike" class="btn-warning" invisible="x_studio_selection_1 not in ('Completed', 'Terminated') or x_studio_bike_returned"/>
          <button name="%(action_cnt_renew)d" type="action" string="Renew Contract" class="btn-info" invisible="x_studio_selection_1 not in ('Completed', 'Terminated') or not x_studio_bike_returned"/>
          <button name="%(action_print_lease_contract)d" type="action" string="Print Contract" class="btn-secondary" icon="fa-print" invisible="not x_studio_bike_returned"/>
          <field name="x_studio_selection_1" widget="statusbar" statusbar_visible="Draft,Active,Completed"/>
        </header>
        <sheet>
          <field name="x_studio_all_installments_invoiced" invisible="1"/>
          <field name="x_studio_all_invoices_paid" invisible="1"/>
          <field name="x_studio_pending_termination" invisible="1"/>
          <field name="x_studio_bike_returned" invisible="1"/>
          <div class="oe_button_box" name="button_box">
            <button name="%(action_cnt_open_invoices)d" type="action" class="oe_stat_button" icon="fa-pencil-square-o">
              <field name="x_studio_invoice_count" widget="statinfo" string="Invoices"/>
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="x_name" readonly="1"/>
            </h1>
          </div>
          <group>
            <group string="Contract &amp; Customer Details">
              <field name="x_studio_partner_id" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
              <field name="x_studio_partner_phone"/>
              <field name="x_studio_partner_email"/>
              <field name="x_studio_application_id" readonly="1"/>
            </group>
            <group string="Lease Dates &amp; Bike">
              <field name="x_studio_date" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
              <field name="x_studio_end_date" required="1"/>
              <field name="x_studio_bike_model" readonly="1" domain="[('vehicle_type', '=', 'bike')]" context="{'default_vehicle_type': 'bike', 'bike_lease_readonly': True}"/>
              <field name="x_studio_bike" required="1" options="{'no_create': True}" readonly="x_studio_selection_1 != 'Draft'" domain="[('vehicle_type', '=', 'bike')]" context="{'default_vehicle_type': 'bike', 'bike_lease_readonly': True}"/>
              <field name="x_studio_lease_plan" required="1" readonly="x_studio_selection_1 != 'Draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Installments &amp; Invoices" name="installments">
              <field name="x_studio_installment_ids" readonly="1">
                <list string="Installments" decoration-danger="x_studio_is_overdue">
                  <field name="x_name"/>
                  <field name="x_studio_date"/>
                  <field name="x_studio_amount" sum="Total Base Amount"/>
                  <field name="x_studio_late_fee_amount" sum="Total Late Fees"/>
                  <field name="x_studio_total_amount" sum="Grand Total"/>
                  <field name="x_studio_invoice_id" readonly="1"/>
                  <field name="x_studio_payment_state" widget="badge" decoration-success="x_studio_payment_state in ('paid', 'Paid')" decoration-info="x_studio_payment_state in ('in_payment', 'In Payment', 'partial')" decoration-warning="x_studio_payment_state in ('not_paid', 'Not Paid', 'Draft', 'Invoiced')"/>
                  <field name="x_studio_is_overdue" column_invisible="True"/>
                </list>
              </field>
            </page>
            <page string="Deposit &amp; Financial Settlement" name="settlement">
              <group>
                <group string="Deposit Status">
                  <field name="x_studio_deposit_invoice_id" readonly="1"/>
                  <field name="x_studio_deposit_paid" readonly="1"/>
                  <field name="x_studio_return_invoice_id" readonly="1"/>
                </group>
                <group string="Return Inspection Settlement">
                  <field name="x_studio_bike_returned" readonly="1"/>
                  <field name="x_studio_repair_charge" readonly="1"/>
                  <field name="x_studio_refund_amount" readonly="1"/>
                  <field name="x_studio_extra_charge" readonly="1"/>
                  <field name="x_studio_service_needed" readonly="1"/>
                </group>
                <group string="Contract Financial Summary">
                  <field name="x_studio_total_contract_amount" readonly="1"/>
                  <field name="x_studio_total_paid_amount" readonly="1"/>
                  <field name="x_studio_total_due_amount" readonly="1"/>
                </group>
              </group>
            </page>
            <page string="Inspection Issues" name="issues" invisible="not x_studio_issue_ids">
              <field name="x_studio_issue_ids" widget="many2many_tags" readonly="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_x_lease_contract_kanban" model="ir.ui.view">
    <field name="name">x_lease_contract.kanban</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <kanban default_group_by="x_studio_selection_1" class="o_kanban_small_column" create="false">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike"/>
        <field name="x_studio_lease_plan"/>
        <field name="x_studio_selection_1"/>
        <templates>
          <t t-name="card" class="oe_kanban_global_click p-3 border shadow-sm rounded-3 bg-white mb-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <strong class="text-primary"><field name="x_name"/></strong>
              <field name="x_studio_selection_1" widget="badge" decoration-info="x_studio_selection_1 == 'Draft'" decoration-success="x_studio_selection_1 == 'Active'" decoration-primary="x_studio_selection_1 == 'Completed'" decoration-warning="x_studio_selection_1 == 'Terminated'" decoration-danger="x_studio_selection_1 == 'Cancelled'"/>
            </div>
            <div class="text-dark fw-bold mb-1"><field name="x_studio_partner_id"/></div>
            <div class="text-muted small"><field name="x_studio_bike"/> - <field name="x_studio_lease_plan"/></div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_x_lease_contract_search" model="ir.ui.view">
    <field name="name">x_lease_contract.search</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <search string="Lease Contracts">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_bike"/>
        <field name="x_studio_lease_plan"/>
        <filter string="Draft" name="draft" domain="[('x_studio_selection_1', '=', 'Draft')]"/>
        <filter string="Active" name="active" domain="[('x_studio_selection_1', '=', 'Active')]"/>
        <filter string="Completed" name="completed" domain="[('x_studio_selection_1', '=', 'Completed')]"/>
        <filter string="Terminated" name="terminated" domain="[('x_studio_selection_1', '=', 'Terminated')]"/>
        <filter string="Cancelled" name="cancelled" domain="[('x_studio_selection_1', '=', 'Cancelled')]"/>
      </search>
    </field>
  </record>

  <record id="view_x_lease_contract_calendar" model="ir.ui.view">
    <field name="name">x_lease_contract.calendar</field>
    <field name="model">x_lease_contract</field>
    <field name="arch" type="xml">
      <calendar string="Lease Contracts" date_start="x_studio_date" date_stop="x_studio_end_date" color="x_studio_partner_id" create="false">
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_selection_1"/>
      </calendar>
    </field>
  </record>

  <!-- ============================================================ -->
  <!-- 5. LEASE INSTALLMENTS (x_lease_installment) VIEWS           -->
  <!-- ============================================================ -->
  <record id="view_x_lease_installment_list" model="ir.ui.view">
    <field name="name">x_lease_installment.list</field>
    <field name="model">x_lease_installment</field>
    <field name="arch" type="xml">
      <list string="Lease Installments" default_order="x_studio_date asc" decoration-danger="x_studio_is_overdue">
        <field name="x_name"/>
        <field name="x_studio_contract_id"/>
        <field name="x_studio_date"/>
        <field name="x_studio_amount"/>
        <field name="x_studio_late_fee_amount"/>
        <field name="x_studio_total_amount"/>
        <field name="x_studio_invoice_id"/>
        <field name="x_studio_payment_state" widget="badge" decoration-success="x_studio_payment_state in ('paid', 'Paid')" decoration-info="x_studio_payment_state in ('in_payment', 'In Payment', 'partial')" decoration-warning="x_studio_payment_state in ('not_paid', 'Not Paid', 'Draft', 'Invoiced')"/>
        <field name="x_studio_is_overdue" column_invisible="True"/>
      </list>
    </field>
