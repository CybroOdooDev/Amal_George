<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mail_template_lease_app_approved" model="mail.template">
    <field name="name">Lease Application: Approved</field>
    <field name="model_id" ref="lease_application_036d2453-d3be-4130-a107-33eec67d96b0"/>
    <field name="email_from">{{ user.email_formatted }}</field>
    <field name="email_to">{{ object.x_studio_partner_email or (object.x_studio_partner_id and object.x_studio_partner_id.email) }}</field>
    <field name="subject">Your Bike Lease Application {{ object.x_name }} has been Approved!</field>
    <field name="description">Sent to the customer when a lease application is approved</field>
    <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; color: #454748; width: 100%; border-collapse:separate;">
        <tr>
            <td align="center">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
                    <tbody>
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td valign="middle">
                                            <span style="font-size: 10px;">Your Application</span><br/>
                                            <span style="font-size: 20px; font-weight: bold;">
                                                <t t-out="object.x_name or ''">APP/2026/0001</t>
                                            </span>
                                        </td>
                                        <td valign="middle" align="right">
                                            <span style="font-size: 10px;">Application Date</span><br/>
                                            <span style="font-size: 14px; font-weight: bold;">
                                                <t t-out="object.x_studio_date or ''">2026-09-02</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td>
                                            <p>Dear <t t-out="object.x_studio_partner_id.name or 'Valued Customer'">Customer Name</t>,</p>
                                            <p>We are pleased to inform you that your <strong>Bike Lease Application</strong>
                                                (<strong><t t-out="object.x_name or ''">APP/2026/0001</t></strong>)
                                                has been <span style="color: #21b799; font-weight: bold;">Approved</span>!</p>
                                            <p>Here are the details of your approved application:</p>
                                            <table border="0" cellpadding="4" cellspacing="0" style="width: 100%; border: 1px solid #e7e7e7; border-collapse: collapse;">
                                                <tr style="background-color: #f8f9fa;">
                                                    <td style="border: 1px solid #e7e7e7; font-weight: bold; width: 40%;">Customer</td>
                                                    <td style="border: 1px solid #e7e7e7;"><t t-out="object.x_studio_partner_id.name or ''">John Doe</t></td>
                                                </tr>
                                                <tr>
                                                    <td style="border: 1px solid #e7e7e7; font-weight: bold;">Bike</td>
                                                    <td style="border: 1px solid #e7e7e7;"><t t-out="object.x_studio_bike.x_name if object.x_studio_bike else ''">BK-2026-VSP01</t></td>
                                                </tr>
                                                <tr style="background-color: #f8f9fa;">
                                                    <td style="border: 1px solid #e7e7e7; font-weight: bold;">Lease Plan</td>
                                                    <td style="border: 1px solid #e7e7e7;"><t t-out="object.x_studio_lease_plan.x_name if object.x_studio_lease_plan else ''">Monthly Plan</t></td>
                                                </tr>
                                                <tr>
                                                    <td style="border: 1px solid #e7e7e7; font-weight: bold;">Lease Start Date</td>
                                                    <td style="border: 1px solid #e7e7e7;"><t t-out="object.x_studio_lease_start_date or ''">2026-09-15</t></td>
                                                </tr>
                                                <tr style="background-color: #f8f9fa;">
                                                    <td style="border: 1px solid #e7e7e7; font-weight: bold;">Application Date</td>
                                                    <td style="border: 1px solid #e7e7e7;"><t t-out="object.x_studio_date or ''">2026-09-02</t></td>
                                                </tr>
                                            </table>
                                            <p style="margin-top: 16px;">A lease contract has been created for your application.
                                                Our team will contact you shortly with the next steps.</p>
                                            <p>Thank you for choosing our bike lease service!</p>
                                            <p>Best Regards,<br/>
                                            <t t-out="user.company_id.name or 'The Team'">Bike Lease Management</t></p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
    </field>
  </record>
  <record id="mail_template_lease_app_rejected" model="mail.template">
    <field name="name">Lease Application: Rejected</field>
    <field name="model_id" ref="lease_application_036d2453-d3be-4130-a107-33eec67d96b0"/>
    <field name="email_from">{{ user.email_formatted }}</field>
    <field name="email_to">{{ object.x_studio_partner_email or (object.x_studio_partner_id and object.x_studio_partner_id.email) }}</field>
    <field name="subject">Update on your Bike Lease Application {{ object.x_name }}</field>
    <field name="description">Sent to the customer when a lease application is rejected</field>
    <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; color: #454748; width: 100%; border-collapse:separate;">
        <tr>
            <td align="center">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
                    <tbody>
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td valign="middle">
                                            <span style="font-size: 10px;">Your Application</span><br/>
                                            <span style="font-size: 20px; font-weight: bold;">
                                                <t t-out="object.x_name or ''">APP/2026/0001</t>
                                            </span>
                                        </td>
                                        <td valign="middle" align="right">
                                            <span style="font-size: 10px;">Application Date</span><br/>
                                            <span style="font-size: 14px; font-weight: bold;">
                                                <t t-out="object.x_studio_date or ''">2026-09-02</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td>
                                            <p>Dear <t t-out="object.x_studio_partner_id.name or 'Valued Customer'">Customer Name</t>,</p>
                                            <p>Thank you for submitting your <strong>Bike Lease Application</strong>
                                                (<strong><t t-out="object.x_name or ''">APP/2026/0001</t></strong>).</p>
                                            <p>Regrettably, we are unable to approve your lease application at this time.</p>
                                            <p><strong>Reason(s) for Rejection:</strong></p>
                                            <ul>
                                                <t t-if="object.x_studio_rejection_reason_ids">
                                                    <t t-foreach="object.x_studio_rejection_reason_ids" t-as="reason">
                                                        <li><t t-out="reason.x_name"/></li>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <li>Application criteria not met</li>
                                                </t>
                                            </ul>
                                            <p style="margin-top: 16px;">If you have any questions or would like to re-apply in the future, please feel free to reach out to our support team.</p>
                                            <p>Best Regards,<br/>
                                            <t t-out="user.company_id.name or 'The Team'">Bike Lease Management</t></p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
    </field>
  </record>
  <record id="mail_template_vehicle_return_settlement" model="mail.template">
    <field name="name">Lease Contract: Vehicle Return &amp; Deposit Settlement</field>
    <field name="model_id" ref="lease_contract_a5608d51-ff1f-40d6-998a-a44c6141fb83"/>
    <field name="email_from">{{ user.email_formatted }}</field>
    <field name="email_to">{{ object.x_studio_partner_email or (object.x_studio_partner_id and object.x_studio_partner_id.email) }}</field>
    <field name="subject">Vehicle Return &amp; Settlement Statement - {{ object.x_name }}</field>
    <field name="description">Sent to customer when vehicle return and deposit settlement is confirmed</field>
    <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; color: #454748; width: 100%; border-collapse:separate;">
        <tr>
            <td align="center">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
                    <tbody>
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td valign="middle">
                                            <span style="font-size: 10px;">Contract Number</span><br/>
                                            <span style="font-size: 20px; font-weight: bold;">
                                                <t t-out="object.x_name or ''">CNT/2026/0001</t>
                                            </span>
                                        </td>
                                        <td valign="middle" align="right">
                                            <span style="font-size: 10px;">Bike</span><br/>
                                            <span style="font-size: 14px; font-weight: bold;">
                                                <t t-out="object.x_studio_bike.x_name if object.x_studio_bike else ''">BK-2026-VSP01</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td>
                                            <p>Dear <t t-out="object.x_studio_partner_id.name or 'Valued Customer'">Customer Name</t>,</p>
                                            <p>Your vehicle return inspection and deposit settlement for contract <strong><t t-out="object.x_name or ''">CNT/2026/0001</t></strong> has been processed successfully.</p>
                                            
                                            <p><strong>Inspection Details:</strong></p>
                                            <table border="0" cellpadding="4" cellspacing="0" style="width: 100%; border: 1px solid #e7e7e7; border-collapse: collapse;">
                                                <tr style="background-color: #f8f9fa;">
                                                    <td style="border: 1px solid #e7e7e7; font-weight: bold; width: 40%;">Service Needed</td>
                                                    <td style="border: 1px solid #e7e7e7;">
                                                        <t t-if="object.x_studio_service_needed">
                                                            <span style="color: #d9534f; font-weight: bold;">Yes</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="color: #5cb85c; font-weight: bold;">No (Clean Condition)</span>
                                                        </t>
                                                    </td>
                                                </tr>
                                                <t t-if="object.x_studio_service_needed">
                                                    <tr>
                                                        <td style="border: 1px solid #e7e7e7; font-weight: bold;">Issues Identified</td>
                                                        <td style="border: 1px solid #e7e7e7;">
                                                            <ul style="margin: 0; padding-left: 18px;">
                                                                <t t-if="object.x_studio_issue_ids">
                                                                    <t t-foreach="object.x_studio_issue_ids" t-as="issue">
                                                                        <li><t t-out="issue.x_name"/></li>
                                                                    </t>
                                                                </t>
                                                                <t t-else="">
                                                                    <li>Service required (No specific issues logged)</li>
                                                                </t>
                                                            </ul>
                                                        </td>
                                                    </tr>
                                                    <tr style="background-color: #f8f9fa;">
                                                        <td style="border: 1px solid #e7e7e7; font-weight: bold;">Repair / Service Charge</td>
                                                        <td style="border: 1px solid #e7e7e7; font-weight: bold; color: #d9534f;">
                                                            $<t t-out="object.x_studio_repair_charge or '0.00'"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </table>
                                            
                                            <p style="margin-top: 16px;"><strong>Financial Settlement:</strong></p>
                                            <p>
                                                <t t-if="object.x_studio_return_invoice_id">
                                                    <t t-if="object.x_studio_return_invoice_id.move_type == 'out_refund'">
                                                        A Net Security Deposit Refund Credit Note (<strong><t t-out="object.x_studio_return_invoice_id.name or ''"/></strong>) has been generated for <strong>$<t t-out="'%.2f' % object.x_studio_return_invoice_id.amount_total"/></strong>.
                                                    </t>
                                                    <t t-else="">
                                                        An Invoice (<strong><t t-out="object.x_studio_return_invoice_id.name or ''"/></strong>) has been generated for excess repair charges totaling <strong>$<t t-out="'%.2f' % object.x_studio_return_invoice_id.amount_total"/></strong>.
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    Repair charges matched security deposit ($0.00 refund / extra bill).
                                                </t>
                                            </p>
                                            
                                            <p>Thank you for choosing our bike lease service!</p>
                                            <p>Best Regards,<br/>
                                            <t t-out="user.company_id.name or 'The Team'">Bike Lease Management</t></p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
    </field>
  </record>
</odoo>
