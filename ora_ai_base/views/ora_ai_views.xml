<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--   Displays a list view of AI assistants -->
    <record id="ora_ai_tree_view" model="ir.ui.view">
        <field name="name">ora.ai.tree.view</field>
        <field name="model">ora.ai</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="language_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--   Form view of the ora AI model.-->
    <record id="ora_ai_form_view" model="ir.ui.view">
        <field name="name">ora.ai.form.view</field>
        <field name="model">ora.ai</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_assistant" string="Create Assistant" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" text="Created" invisible="state not in 'done'"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="id_assistant"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Model" name="model">
                            <group name="model">
                                <group>
                                    <field name="first_message"/>
                                    <field name="end_call_phrases"/>
                                    <field name="file_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="provider" widget="selection"/>
                                    <field name="provider_model_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="provider_model_ids"
                                           invisible="1"/>
                                    <button type="object" name="action_assistant_testing" string="Test Assistant"
                                            class="btn btn-outline-primary"
                                            invisible="state not in 'done'"/>
                                    <field name="function_description" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contents" name="contents">
                            <field name="prompt" readonly="0" placeholder="Configure the context, role, instructions, and personality for the assistant..."/>
                        </page>
                        <page string="Transcriber" name="transcriber">
                            <group>
                                <field name="transcriber_provider"/>
                                <field name="transcriber_model_id"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="transcriber_model_ids"
                                       invisible="1"/>
                            </group>
                            <group>
                                <field name="is_lang_switch"/>
                                <field name="language_ids" widget="many2many_tags" invisible="not is_lang_switch"/>
                                <field name="language_id" invisible="is_lang_switch" required="1"/>
                                <field name="language_function_description" invisible="1"/>
                            </group>
                        </page>
                        <page string="Operations" name="operations">
                            <group name="operations">
                                <group string="Sales &amp; Invoicing">
                                    <field name="is_sale_order_creation"/>
                                    <field name="is_invoice_creation"/>
                                </group>
                                <group string="Master Data">
                                    <field name="is_product_creation"/>
                                    <field name="is_customer_creation"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--    Creates a backend menu action named "Assistants"-->
    <record id="ora_ai_action" model="ir.actions.act_window">
        <field name="name">Assistants</field>
        <field name="res_model">ora.ai</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Provider Model Views -->
    <record id="provider_model_view_list" model="ir.ui.view">
        <field name="name">provider.model.list</field>
        <field name="model">provider.model</field>
        <field name="arch" type="xml">
            <list string="AI Models" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="key"/>
                <field name="provider"/>
            </list>
        </field>
    </record>

    <record id="provider_model_view_form" model="ir.ui.view">
        <field name="name">provider.model.form</field>
        <field name="model">provider.model</field>
        <field name="arch" type="xml">
            <form string="AI Model" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" readonly="1"/>
                            <field name="key" required="1" readonly="1"/>
                        </group>
                        <group>
                            <field name="provider" required="1" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="provider_model_view_search" model="ir.ui.view">
        <field name="name">provider.model.search</field>
        <field name="model">provider.model</field>
        <field name="arch" type="xml">
            <search string="Search AI Models">
                <field name="name"/>
                <field name="key"/>
                <field name="provider"/>
                <group>
                    <filter string="Provider" name="group_by_provider" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="provider_model_action" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">provider.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="provider_model_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI Models found
            </p>
            <p>
                Configure the LLM models available from OpenAI, Groq, Anthropic, Together AI, Perplexity, OpenRouter, and DeepInfra.
            </p>
        </field>
    </record>

    <!-- Transcriber Model Views -->
    <record id="transcriber_model_view_list" model="ir.ui.view">
        <field name="name">transcriber.model.list</field>
        <field name="model">transcriber.model</field>
        <field name="arch" type="xml">
            <list string="Transcriber Models" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="key"/>
                <field name="provider"/>
            </list>
        </field>
    </record>

    <record id="transcriber_model_view_form" model="ir.ui.view">
        <field name="name">transcriber.model.form</field>
        <field name="model">transcriber.model</field>
        <field name="arch" type="xml">
            <form string="Transcriber Model" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" readonly="1"/>
                            <field name="key" required="1" readonly="1"/>
                        </group>
                        <group>
                            <field name="provider" required="1" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="transcriber_model_view_search" model="ir.ui.view">
        <field name="name">transcriber.model.search</field>
        <field name="model">transcriber.model</field>
        <field name="arch" type="xml">
            <search string="Search Transcriber Models">
                <field name="name"/>
                <field name="key"/>
                <field name="provider"/>
                <group>
                    <filter string="Provider" name="group_by_provider" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="transcriber_model_action" model="ir.actions.act_window">
        <field name="name">Transcriber Models</field>
        <field name="res_model">transcriber.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="transcriber_model_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Transcriber Models found
            </p>
            <p>
                Configure the Speech-to-Text models available from Deepgram, Gladia, Talkscriber, Cartesia, and Speechmatics.
            </p>
        </field>
    </record>
</odoo>