<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Template of the report complaint type report-->
    <template id="complaint_type_report">
        <t t-call="web.external_layout">
            <t t-call="web.html_container">
                <div class="row mt32">
                    <br/>
                    <div style="text-align:center;">
                        <h2>Complaint Type Report</h2>
                        <br/>
                        <t t-if="start_date">
                            <strong>Date From:
                                <t t-esc="start_date"/>
                            </strong>
                            <br/>
                        </t>
                        <strong>Date To:
                            <t t-esc="end_date"/>
                        </strong>
                    </div>
                </div>
                <div>
                    <table class="table table-condensed"
                           style="margin-top:5%;;width:100%;line-height:2;text-align:center;">
                        <thead>
                            <th style="text-align: center;">Serv No</th>
                            <th style="text-align: center;">Technician</th>
                            <th style="text-align: center;">Brand</th>
                            <th style="text-align: center;">Model</th>
                            <th style="text-align: center;">Date Request</th>
                        </thead>
                        <tbody>
                            <t t-foreach="values" t-as="doc">
                                <t t-if="doc['print'] == 1">
                                    <tr style="height:25px; font-size:16px; font-weight:bold; text-align:left;">
                                        <td colspan="5">
                                            <t t-esc="doc['complaint_type']"/>
                                            -
                                            <t t-esc="doc['description']"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="complaints" t-as="comp">
                                    <t t-if="doc['complaint_type'] == comp['complaint_type']">
                                        <t t-if="doc['description'] == comp['description']">
                                            <tr>
                                                <td style="text-align: center;">
                                                    <span t-esc="comp['serv_no']"/>
                                                </td>
                                                <td style="text-align: center;">
                                                    <span t-esc="comp['technician']"/>
                                                </td>
                                                <td style="text-align: center;">
                                                    <span t-esc="comp['brand']"/>
                                                </td>
                                                <td style="text-align: center;">
                                                    <span t-esc="comp['model']"/>
                                                </td>
                                                <td style="text-align: center;">
                                                    <span t-esc="comp['date']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
