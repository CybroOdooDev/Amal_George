  <!-- Enable website form access on x_appointment so /website/form/ endpoint works -->
  <function model="ir.model" name="write">
    <value model="ir.model" search="[('model','=','x_appointment')]"/>
    <value eval="{'website_form_access': True}"/>
  </function>

  <!-- Allow custom fields to be written via website form (unblacklist them) -->
  <function model="ir.model.fields" name="write">
    <value model="ir.model.fields" search="[('model', '=', 'x_appointment'), ('name', 'in', ['x_studio_partner_id', 'x_studio_booking_type', 'x_studio_date', 'x_studio_time_slot', 'x_studio_chair_num', 'x_studio_service', 'x_studio_service_package', 'x_studio_selection_1', 'x_studio_staff_beautician'])]"/>
    <value eval="{'website_form_blacklisted': False}"/>
  </function>

