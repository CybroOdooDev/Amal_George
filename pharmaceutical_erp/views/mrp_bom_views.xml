<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── mrp.bom — inherit form to add pharma fields ──────────────────── -->
    <record id="mrp_bom_form_pharma" model="ir.ui.view">
        <field name="name">mrp.bom.form.pharma</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <!-- The Odoo 19 BoM form has no header, so create one before the sheet. -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_approve_formula" type="object"
                            string="Approve Formula" class="btn-primary"
                            invisible="formula_status not in ('draft',)"
                            groups="pharmaceutical_erp.group_pharma_qa_manager"/>
                    <button name="action_obsolete_formula" type="object"
                            string="Mark Obsolete"
                            invisible="formula_status not in ('approved',)"
                            groups="pharmaceutical_erp.group_pharma_qa_manager"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="formula_status not in ('approved',)"
                            groups="pharmaceutical_erp.group_pharma_qa_manager"/>
                    <field name="formula_status" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
            </xpath>

            <!-- Inject pharma fields after the product qty / uom row -->
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="formula_version" placeholder="e.g. v1.0"/>
                <field name="pharmacopoeial_ref"/>
                <field name="theoretical_yield"/>
                <field name="change_ref" placeholder="CC-2026-001"/>
            </xpath>

            <!-- Approval block after product -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="approved_by"
                       invisible="formula_status != 'approved'"/>
                <field name="approval_date"
                       invisible="formula_status != 'approved'"/>
            </xpath>

            <!-- Notes tab page -->
            <xpath expr="//notebook" position="inside">
                <page name="pharma_notes" string="Formula Notes">
                    <field name="notes" nolabel="1"
                           placeholder="Manufacturing instructions, handling precautions, yield calculation method…"/>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ─── mrp.bom — list view additions ────────────────────────────────── -->
    <record id="mrp_bom_list_pharma" model="ir.ui.view">
        <field name="name">mrp.bom.list.pharma</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="formula_version" optional="show"/>
                <field name="formula_status" widget="badge"
                       decoration-success="formula_status == 'approved'"
                       decoration-muted="formula_status in ('draft','obsolete')"
                       optional="show"/>
            </field>
        </field>
    </record>

</odoo>
