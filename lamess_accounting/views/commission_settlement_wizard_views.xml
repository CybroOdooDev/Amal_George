<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lamess_commission_settlement_generate_wizard_form" model="ir.ui.view">
        <field name="name">lamess.commission.settlement.generate.wizard.form</field>
        <field name="model">lamess.commission.settlement.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Genera settlement commissioni">
                <sheet>
                    <group>
                        <field name="period_id"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="lock_runtime"/>
                    </group>
                    <group string="Anteprima">
                        <field name="eligible_runtime_line_count" readonly="1"/>
                        <field name="eligible_amount" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Genera settlement" class="btn-primary"/>
                    <button string="Annulla" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lamess_commission_settlement_generate_wizard" model="ir.actions.act_window">
        <field name="name">Genera settlement commissioni</field>
        <field name="res_model">lamess.commission.settlement.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lamess_commission_settlement_generate_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_lamess_commission_settlement_generate_wizard"
              name="Genera settlement"
              parent="lamess_commission.menu_lamess_network_root"
              action="action_lamess_commission_settlement_generate_wizard"
              sequence="24"
              groups="base.group_system,lamess_network.group_network_manager,lamess_network.group_network_finance"/>

    <record id="view_lamess_commission_wallet_post_wizard_form" model="ir.ui.view">
        <field name="name">lamess.commission.wallet.post.wizard.form</field>
        <field name="model">lamess.commission.wallet.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Accredita wallet">
                <sheet>
                    <group>
                        <field name="period_id"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Anteprima">
                        <field name="settlement_count" readonly="1"/>
                        <field name="settlement_amount" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_post_wallet" type="object" string="Accredita wallet" class="btn-primary"/>
                    <button string="Annulla" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lamess_commission_wallet_post_wizard" model="ir.actions.act_window">
        <field name="name">Accredita wallet</field>
        <field name="res_model">lamess.commission.wallet.post.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lamess_commission_wallet_post_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_lamess_commission_wallet_post_wizard"
              name="Accredita wallet"
              parent="lamess_commission.menu_lamess_network_root"
              action="action_lamess_commission_wallet_post_wizard"
              sequence="26"
              groups="base.group_system,lamess_network.group_network_manager,lamess_network.group_network_finance"/>

    <record id="view_lamess_commission_full_cycle_wizard_form" model="ir.ui.view">
        <field name="name">lamess.commission.full.cycle.wizard.form</field>
        <field name="model">lamess.commission.full.cycle.wizard</field>
        <field name="arch" type="xml">
            <form string="Esegui ciclo commissioni">
                <sheet>
                    <group>
                        <field name="period_id"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Operazioni">
                        <field name="regenerate_runtime"/>
                        <field name="generate_settlement"/>
                        <field name="post_wallet"/>
                        <field name="lock_runtime"/>
                    </group>
                    <group string="Anteprima situazione attuale">
                        <field name="existing_generated_runtime_count" readonly="1"/>
                        <field name="existing_postable_settlement_count" readonly="1"/>
                        <field name="existing_postable_settlement_amount" readonly="1"/>
                    </group>
                    <p class="text-muted">
                        Questo flusso esegue in sequenza runtime M3, settlement e accredito wallet. Le operazioni restano disponibili anche separatamente nei menu dedicati.
                    </p>
                </sheet>
                <footer>
                    <button name="action_run_full_cycle" type="object" string="Esegui ciclo completo" class="btn-primary"/>
                    <button string="Annulla" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lamess_commission_full_cycle_wizard" model="ir.actions.act_window">
        <field name="name">Esegui ciclo commissioni</field>
        <field name="res_model">lamess.commission.full.cycle.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lamess_commission_full_cycle_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_lamess_commission_full_cycle_wizard"
              name="Esegui ciclo commissioni"
              parent="lamess_commission.menu_lamess_network_root"
              action="action_lamess_commission_full_cycle_wizard"
              sequence="22"
              groups="base.group_system,lamess_network.group_network_manager,lamess_network.group_network_finance"/>
    <record id="menu_lamess_commission_full_cycle_wizard" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
