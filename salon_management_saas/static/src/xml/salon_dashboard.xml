<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="salon_management_saas.SalonDashboard">
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap');

            .o_salon_dashboard_wrapper {
                background-color: #f3f6f9 !important;
                background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%) !important;
                font-family: 'Plus Jakarta Sans', -apple-system, sans-serif !important;
                position: relative;
                z-index: 0;
            }
            
            /* Fluid background radial blobs */
            .o_salon_dashboard_wrapper::before {
                content: "";
                position: absolute;
                width: 500px;
                height: 500px;
                background: radial-gradient(circle, rgba(251, 113, 133, 0.04) 0%, rgba(251, 113, 133, 0) 70%);
                bottom: -10%;
                left: -5%;
                z-index: -1;
                pointer-events: none;
            }
            .o_salon_dashboard_wrapper::after {
                content: "";
                position: absolute;
                width: 600px;
                height: 600px;
                background: radial-gradient(circle, rgba(167, 139, 250, 0.04) 0%, rgba(167, 139, 250, 0) 70%);
                top: -10%;
                right: -5%;
                z-index: -1;
                pointer-events: none;
            }
            
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Modern Clean Card with Soft Drop Shadows */
            .neumorphic-card {
                background: #ffffff !important;
                border-radius: 24px !important;
                box-shadow: 0 10px 30px rgba(165, 178, 200, 0.12) !important;
                border: 1px solid rgba(226, 232, 240, 0.8) !important;
                padding: 24px;
                transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
                animation: fadeInUp 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) both;
                position: relative;
                z-index: 1;
            }
            .neumorphic-card:hover {
                box-shadow: 0 16px 40px rgba(165, 178, 200, 0.22) !important;
                transform: translateY(-4px);
            }

            /* Subtle Pastel Tint Modifiers for KPI cards */
            .kpi-bookings {
                background: #f8f6ff !important;
                border: 1px solid #ebdfff !important;
            }
            .kpi-bookings .neumorphic-btn-circular {
                background: #f0e6ff !important;
                border: 1px solid #dfceff !important;
                color: #7c3aed !important;
            }

            .kpi-revenue {
                background: #f4fbf7 !important;
                border: 1px solid #d3f2e4 !important;
            }
            .kpi-revenue .neumorphic-btn-circular {
                background: #e6f7ef !important;
                border: 1px solid #c4ecdb !important;
                color: #0d9488 !important;
            }

            .kpi-beauticians {
                background: #fff8f1 !important;
                border: 1px solid #ffe3c9 !important;
            }
            .kpi-beauticians .neumorphic-btn-circular {
                background: #ffeedb !important;
                border: 1px solid #ffd2a1 !important;
                color: #ea580c !important;
            }

            .kpi-services {
                background: #f2f8ff !important;
                border: 1px solid #d4e8fc !important;
            }
            .kpi-services .neumorphic-btn-circular {
                background: #e5f1ff !important;
                border: 1px solid #c2dfff !important;
                color: #2563eb !important;
            }

            .kpi-chairs {
                background: #fffcf0 !important;
                border: 1px solid #ffeeb5 !important;
            }
            .kpi-chairs .neumorphic-btn-circular {
                background: #fff6d1 !important;
                border: 1px solid #ffe89e !important;
                color: #ca8a04 !important;
            }

            .kpi-active-range {
                background: #f2fdfd !important;
                border: 1px solid #d1f7f7 !important;
            }
            .kpi-active-range .neumorphic-select, .kpi-active-range .neumorphic-input {
                background-color: #ffffff !important;
            }

            /* Navy Spotlight Card */
            .neumorphic-card-spotlight {
                background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%) !important;
                border-radius: 24px !important;
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18) !important;
                border: 1px solid rgba(255, 255, 255, 0.1) !important;
                padding: 24px;
                transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
                animation: fadeInUp 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) both;
                position: relative;
                z-index: 1;
                overflow: hidden;
            }
            .neumorphic-card-spotlight:hover {
                box-shadow: 0 16px 40px rgba(15, 23, 42, 0.28) !important;
                transform: translateY(-4px);
            }
            
            /* Stagger animations for cards based on row index */
            .o_salon_dashboard .row .neumorphic-card, .o_salon_dashboard .row .neumorphic-card-spotlight { animation-delay: 0.15s; }
            
            /* Neumorphic Inset Panel */
            .neumorphic-inset {
                background: #f8fafc;
                border-radius: 16px;
                box-shadow: inset 2px 2px 5px rgba(165, 178, 200, 0.05);
                border: 1px solid rgba(0, 0, 0, 0.02) !important;
                outline: none !important;
            }

            /* Custom Select and Input Styling */
            .neumorphic-select, .neumorphic-input {
                background: #ffffff !important;
                border: 1px solid rgba(226, 232, 240, 0.9) !important;
                border-radius: 14px !important;
                box-shadow: 0 4px 10px rgba(165, 178, 200, 0.04) !important;
                color: #1e293b !important;
                font-weight: 600 !important;
                padding: 10px 16px !important;
                outline: none !important;
                transition: all 0.2s ease;
                appearance: none;
                -webkit-appearance: none;
                background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238b5cf6' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
                background-repeat: no-repeat !important;
                background-position: right 14px center !important;
                background-size: 16px !important;
                padding-right: 40px !important;
            }
            .neumorphic-select:focus, .neumorphic-input:focus {
                border-color: rgba(139, 92, 246, 0.4) !important;
                box-shadow: 0 4px 12px rgba(139, 92, 246, 0.12) !important;
            }

            /* Circular Button */
            .neumorphic-btn-circular {
                background: #ffffff !important;
                border-radius: 50% !important;
                width: 44px !important;
                height: 44px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                box-shadow: 0 6px 16px rgba(165, 178, 200, 0.1) !important;
                border: 1px solid rgba(226, 232, 240, 0.8) !important;
                color: #8b5cf6 !important;
                cursor: pointer;
                transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
                outline: none !important;
            }
            .neumorphic-btn-circular:hover {
                color: #3b82f6 !important;
                box-shadow: 0 8px 24px rgba(165, 178, 200, 0.18) !important;
                transform: scale(1.05);
            }
            .neumorphic-btn-circular:active {
                box-shadow: 0 3px 8px rgba(165, 178, 200, 0.1) !important;
                transform: scale(0.95);
            }

            /* Text Styling */
            .text-gradient-violet {
                color: #1e293b !important;
            }
            
            /* Donut Hole matches Card background */
            .donut-hole-neumorphic {
                fill: #ffffff !important;
            }

            /* Neumorphic Progress Bars */
            .neumorphic-progress {
                background: #f1f5f9 !important;
                border-radius: 10px !important;
                height: 16px !important;
                border: none !important;
                overflow: hidden;
            }
            .neumorphic-progress-bar {
                border-radius: 10px !important;
                background: linear-gradient(135deg, #a855f7, #7c3aed) !important;
                box-shadow: 0 4px 10px rgba(139, 92, 246, 0.2) !important;
            }

            /* Neumorphic Table Styling */
            .neumorphic-table {
                background: transparent !important;
                border-collapse: separate !important;
                border-spacing: 0 10px !important;
                width: 100%;
            }
            .neumorphic-table tr {
                background: #ffffff !important;
                box-shadow: 0 4px 12px rgba(165, 178, 200, 0.05) !important;
                border-radius: 16px !important;
                transition: all 0.2s ease;
                border: 1px solid rgba(226, 232, 240, 0.5) !important;
            }
            .neumorphic-table tr:hover {
                box-shadow: 0 8px 20px rgba(165, 178, 200, 0.12) !important;
            }
            .neumorphic-table td, .neumorphic-table th {
                border: none !important;
                padding: 14px 20px !important;
                vertical-align: middle !important;
                color: #4b5563;
                font-weight: 500;
            }
            .neumorphic-table td:first-child, .neumorphic-table th:first-child {
                border-top-left-radius: 16px !important;
                border-bottom-left-radius: 16px !important;
            }
            .neumorphic-table td:last-child, .neumorphic-table th:last-child {
                border-top-right-radius: 16px !important;
                border-bottom-right-radius: 16px !important;
            }
            .neumorphic-table thead tr {
                background: transparent !important;
                box-shadow: none !important;
            }
            .neumorphic-table thead th {
                font-weight: 700 !important;
                color: #64748b !important;
                text-transform: uppercase !important;
                font-size: 0.75rem !important;
                letter-spacing: 0.08em !important;
            }
            
            /* Scrollable Table Container */
            .table-responsive-scrollable {
                max-height: 320px;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: #cbd5e1 transparent;
            }
            .table-responsive-scrollable::-webkit-scrollbar {
                width: 6px;
            }
            .table-responsive-scrollable::-webkit-scrollbar-track {
                background: transparent;
            }
            .table-responsive-scrollable::-webkit-scrollbar-thumb {
                background-color: #cbd5e1;
                border-radius: 20px;
            }
        </style>

        <div class="o_salon_dashboard_wrapper" style="height: 100%; overflow-y: auto; overflow-x: hidden; padding: 24px;">
            <div class="o_salon_dashboard" style="overflow-x: hidden;">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="h3 mb-0" style="font-weight: 800; font-size: 2.2rem; letter-spacing: -0.02em; color: #1e293b;"><t t-esc="this.greeting"/></h1>
                        <p class="text-muted mb-0" style="font-size: 0.95rem; font-weight: 500; margin-top: 4px;">Here is your salon's performance overview.</p>
                    </div>
                    <button class="neumorphic-btn-circular" t-on-click="() => this.loadData()" title="Refresh Data">
                        <i class="fa fa-refresh" style="font-size: 1.2rem;"></i>
                    </button>
                </div>

                <!-- Error Alert Box -->
                <t t-if="this.state.error_message">
                    <div class="alert alert-danger shadow-sm mb-4 border-0" role="alert" style="border-radius: 16px; font-weight: 600; background-color: #FED7D7; color: #C53030; padding: 1.2rem 1.8rem; box-shadow: 0 10px 30px rgba(165, 178, 200, 0.12);">
                        <i class="fa fa-exclamation-triangle mr-2" style="color: #E53E3E; font-size: 1.1rem;"></i> <t t-esc="this.state.error_message"/>
                    </div>
                </t>

                <!-- Row 1: KPI Cards (9/12) + Filter Selection (3/12) -->
                <div class="row mb-4 align-items-start">
                    <!-- Left: 5 KPI Cards -->
                    <div class="col-xl-9 col-lg-8 mb-3 mb-lg-0">
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5">
                            <!-- Bookings -->
                            <div class="col mb-3 mb-lg-0">
                                <div class="neumorphic-card kpi-bookings d-flex flex-column justify-content-center" style="padding: 16px; min-height: 110px;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="text-xs font-weight-bold text-uppercase mb-2" style="color: #64748b; font-size: 0.7rem; letter-spacing: 0.08em; font-weight: 700;">Bookings</div>
                                            <div class="h4 mb-0 font-weight-bold" style="font-size: 1.8rem; font-weight: 800; color: #1e293b;"><t t-esc="this.state.today_bookings"/></div>
                                        </div>
                                        <div class="neumorphic-btn-circular" style="pointer-events: none; width: 42px !important; height: 42px !important;">
                                            <i class="fa fa-calendar" style="font-size: 1.1rem;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Revenue -->
                            <div class="col mb-3 mb-lg-0">
                                <div class="neumorphic-card kpi-revenue d-flex flex-column justify-content-center" style="padding: 16px; min-height: 110px;">
                                    <div class="d-flex align-items-center justify-content-between" style="position: relative; z-index: 2;">
                                        <div>
                                            <div class="text-xs font-weight-bold text-uppercase mb-2" style="color: #64748b; font-size: 0.7rem; letter-spacing: 0.08em; font-weight: 700;">Revenue</div>
                                            <div class="h4 mb-0 font-weight-bold" style="font-size: 1.8rem; font-weight: 800; color: #1e293b;">$<t t-esc="this.state.monthly_revenue.toFixed(2)"/></div>
                                        </div>
                                        <div class="neumorphic-btn-circular" style="pointer-events: none; width: 42px !important; height: 42px !important;">
                                            <i class="fa fa-usd" style="font-size: 1.1rem;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Beauticians -->
                            <div class="col mb-3 mb-lg-0">
                                <div class="neumorphic-card kpi-beauticians d-flex flex-column justify-content-center" style="padding: 16px; min-height: 110px;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="text-xs font-weight-bold text-uppercase mb-2" style="color: #64748b; font-size: 0.7rem; letter-spacing: 0.08em; font-weight: 700;">Beauticians</div>
                                            <div class="h4 mb-0 font-weight-bold" style="font-size: 1.8rem; font-weight: 800; color: #1e293b;"><t t-esc="this.state.employees ? this.state.employees.length : 0"/></div>
                                        </div>
                                        <div class="neumorphic-btn-circular" style="pointer-events: none; width: 42px !important; height: 42px !important;">
                                            <i class="fa fa-users" style="font-size: 1.1rem;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Services Rendered -->
                            <div class="col mb-3 mb-lg-0">
                                <div class="neumorphic-card kpi-services d-flex flex-column justify-content-center" style="padding: 16px; min-height: 110px;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="text-xs font-weight-bold text-uppercase mb-2" style="color: #64748b; font-size: 0.7rem; letter-spacing: 0.08em; font-weight: 700;">Services</div>
                                            <div class="h4 mb-0 font-weight-bold" style="font-size: 1.8rem; font-weight: 800; color: #1e293b;"><t t-esc="this.state.services_rendered"/></div>
                                        </div>
                                        <div class="neumorphic-btn-circular" style="pointer-events: none; width: 42px !important; height: 42px !important;">
                                            <i class="fa fa-cogs" style="font-size: 1.1rem;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Active Chairs -->
                            <div class="col mb-3 mb-lg-0">
                                <div class="neumorphic-card kpi-chairs d-flex flex-column justify-content-center" style="padding: 16px; min-height: 110px;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="text-xs font-weight-bold text-uppercase mb-2" style="color: #64748b; font-size: 0.7rem; letter-spacing: 0.08em; font-weight: 700;">Chairs</div>
                                            <div class="h4 mb-0 font-weight-bold" style="font-size: 1.8rem; font-weight: 800; color: #1e293b;"><t t-esc="this.state.active_chairs"/></div>
                                        </div>
                                        <div class="neumorphic-btn-circular" style="pointer-events: none; width: 42px !important; height: 42px !important;">
                                            <img src="/salon_management_saas/static/src/img/chair_active.svg" style="width: 22px; height: 22px;" alt="Chairs"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Small Filter Card -->
                    <div class="col-xl-3 col-lg-4">
                        <div class="neumorphic-card d-flex flex-column justify-content-center" style="padding: 12px 20px; min-height: 110px;">
                            <div class="d-flex flex-column" style="flex-grow: 1; justify-content: center;">
                                <span class="text-muted small mb-1" style="font-weight: 700; color: #64748b; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em;">Active Range</span>
                                <select class="form-select neumorphic-select w-100" t-att-value="this.state.date_filter" t-on-change="(ev) => this.onDateFilterChange(ev)" style="padding: 6px 12px !important; font-size: 0.85rem !important; height: 38px !important;">
                                    <option value="today">Today</option>
                                    <option value="this_week">This Week</option>
                                    <option value="this_month">This Month</option>
                                    <option value="this_year">This Year</option>
                                    <option value="all_time">All Time</option>
                                    <option value="custom">Custom</option>
                                </select>


                                <!-- Custom date pickers inline side-by-side -->
                                <t t-if="this.state.date_filter == 'custom'">
                                    <div class="d-flex align-items-center mt-2 pt-2 border-top" style="border-color: rgba(226, 232, 240, 0.8) !important; gap: 8px;">
                                        <div class="d-flex flex-column" style="flex: 1;">
                                            <span class="text-muted" style="font-weight: 700; color: #64748b; font-size: 0.65rem;">Start</span>
                                            <input type="date" class="form-control neumorphic-input w-100" t-att-value="this.state.custom_start_date" t-on-change="(ev) => this.onCustomStartDateChange(ev)" style="padding: 4px 8px !important; font-size: 0.75rem !important; height: 30px !important;"/>
                                        </div>
                                        <div class="d-flex flex-column" style="flex: 1;">
                                            <span class="text-muted" style="font-weight: 700; color: #64748b; font-size: 0.65rem;">End</span>
                                            <input type="date" class="form-control neumorphic-input w-100" t-att-value="this.state.custom_end_date" t-on-change="(ev) => this.onCustomEndDateChange(ev)" style="padding: 4px 8px !important; font-size: 0.75rem !important; height: 30px !important;"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Line Chart (8/12) + Today's Bookings (4/12) -->
                <div class="row mb-4 align-items-stretch">
                    <!-- Line Chart (8/12) -->
                    <div class="col-xl-8 col-lg-7 mb-4 mb-lg-0">
                        <div class="neumorphic-card h-100">
                            <div class="d-flex flex-column mb-4">
                                <h6 class="m-0" style="font-size: 1.1rem; font-weight: 750; color: #1e293b;">Revenue Growth Trend</h6>
                                <p class="text-muted small mb-0" style="font-weight: 500; margin-top: 2px;">Monthly sales and revenue overview</p>
                            </div>
                            <div class="card-body p-0 d-flex flex-column justify-content-center" style="min-height: 280px;">
                                <svg viewBox="0 0 800 260" class="w-100" style="height: 260px;">
                                    <defs>
                                        <!-- Gradient for the main line path -->
                                        <linearGradient id="lineTrendGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#8b5cf6" />
                                            <stop offset="100%" stop-color="#06b6d4" />
                                        </linearGradient>
                                        <!-- Gradient fill for the area under the path -->
                                        <linearGradient id="lineAreaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.25"/>
                                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.0"/>
                                        </linearGradient>
                                    </defs>
                                    <!-- Grid Lines -->
                                    <line x1="50" y1="30" x2="750" y2="30" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="4,4"/>
                                    <line x1="50" y1="93" x2="750" y2="93" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="4,4"/>
                                    <line x1="50" y1="156" x2="750" y2="156" stroke="#e2e8f0" stroke-width="0.8" stroke-dasharray="4,4"/>
                                    <line x1="50" y1="220" x2="750" y2="220" stroke="#cbd5e1" stroke-width="1.5"/>

                                    <!-- Trend Line -->
                                    <path t-att-d="this.state.line_path" fill="none" stroke="url(#lineTrendGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path t-att-d="this.state.line_area_path" fill="url(#lineAreaGrad)"/>

                                    <!-- Points -->
                                    <t t-foreach="this.state.line_points" t-as="pt" t-key="pt.x">
                                        <circle t-att-cx="pt.x" t-att-cy="pt.y" r="8" fill="#ffffff" stroke="#06b6d4" stroke-width="3">
                                            <title><t t-esc="pt.date"/>: $<t t-esc="pt.val"/></title>
                                        </circle>
                                        <circle t-att-cx="pt.x" t-att-cy="pt.y" r="3" fill="#06b6d4"/>
                                    </t>

                                    <!-- Labels -->
                                    <t t-foreach="this.state.line_labels" t-as="label" t-key="label_index">
                                        <text t-att-x="this.state.line_points[label_index].x" y="246" fill="#64748b" font-size="10" font-weight="700" text-anchor="middle"><t t-esc="label"/></text>
                                    </t>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Today's Bookings (4/12) -->
                    <div class="col-xl-4 col-lg-5">
                        <div class="neumorphic-card h-100">
                            <div class="d-flex flex-row align-items-center justify-content-between mb-3">
                                <h6 class="m-0" style="font-size: 1.1rem; font-weight: 750; color: #1e293b;">Today's Bookings</h6>
                            </div>
                            <div class="table-responsive table-responsive-scrollable" style="max-height: 220px;">
                                <table class="neumorphic-table">
                                    <thead>
                                        <tr>
                                            <th>Booking ID</th>
                                            <th>Time Slot</th>
                                            <th>Beautician</th>
                                            <th>Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.today_bookings_list" t-as="booking" t-key="booking.id">
                                            <tr>
                                                <td style="font-weight: 700; color: #1e293b; padding: 10px 14px !important;"><t t-esc="booking.x_name"/></td>
                                                <td style="padding: 10px 14px !important;"><span class="badge" style="background: #f1f5f9; color: #8b5cf6; box-shadow: inset 1px 1px 3px rgba(0,0,0,0.03); border-radius: 8px; padding: 4px 8px; font-weight: 600;"><t t-esc="booking.x_studio_time_slot"/></span></td>
                                                <td style="padding: 10px 14px !important;"><t t-esc="booking.x_studio_staff_beautician ? booking.x_studio_staff_beautician[1] : 'N/A'"/></td>
                                                <td style="font-weight: 700; color: #8b5cf6; padding: 10px 14px !important;">$<t t-esc="(booking.x_studio_value || 0).toFixed(2)"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="this.state.today_bookings_list.length == 0">
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-5" style="background: #ffffff !important; border-radius: 16px;">
                                                    <i class="fa fa-folder-open-o fa-xl mb-2 text-muted" style="opacity: 0.6;"></i>
                                                    <div>No remaining bookings today.</div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 3: Three Visual Charts (Donut 4/12 + Polar 4/12 + Radar 4/12) -->
                <div class="row mb-4">
                    <!-- Donut Chart -->
                    <div class="col-xl-4 col-md-6 mb-4 mb-xl-0">
                        <div class="neumorphic-card h-100">
                            <div class="d-flex flex-column mb-3">
                                <h6 class="m-0" style="font-size: 1.1rem; font-weight: 750; color: #1e293b;">Category Revenue Share</h6>
                                <p class="text-muted small mb-0" style="font-weight: 500; margin-top: 2px;">Share of revenue by service category</p>
                            </div>
                            <div class="text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 220px;">
                                <svg width="150" height="150" viewBox="0 0 42 42" class="donut">
                                    <defs>
                                        <!-- Linear Gradients for Segments -->
                                        <linearGradient id="violetBlueGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="#8b5cf6" />
                                            <stop offset="100%" stop-color="#a855f7" />
                                        </linearGradient>
                                        <linearGradient id="cyanBlueGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="#06b6d4" />
                                            <stop offset="100%" stop-color="#0891b2" />
                                        </linearGradient>
                                        <linearGradient id="purpleRedGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="#4f46e5" />
                                            <stop offset="100%" stop-color="#6366f1" />
                                        </linearGradient>
                                        <linearGradient id="yellowOrangeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="#1e293b" />
                                            <stop offset="100%" stop-color="#334155" />
                                        </linearGradient>
                                    </defs>
                                    <circle class="donut-hole-neumorphic" cx="21" cy="21" r="15.91549430918954"></circle>
                                    <circle class="donut-ring" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f1f5f9" stroke-width="3.8"></circle>

                                    <!-- Render segments -->
                                    <t t-foreach="this.state.donut_segments" t-as="seg" t-key="seg.category">
                                        <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" 
                                                t-att-stroke="seg.category == 'Hair Care' ? 'url(#violetBlueGradient)' : (seg.category == 'Skin Care' ? 'url(#cyanBlueGradient)' : (seg.category == 'Nail Care' ? 'url(#purpleRedGradient)' : (seg.category == 'Massage Therapy' ? 'url(#yellowOrangeGradient)' : seg.color)))" 
                                                stroke-width="3.8" stroke-linecap="round" t-att-stroke-dasharray="seg.dashArray" t-att-stroke-dashoffset="seg.dashOffset"></circle>
                                    </t>
                                    <g class="chart-text">
                                        <text x="50%" y="54%" class="chart-number" style="font-size: 0.26em; font-weight: 800; text-anchor: middle; dominant-baseline: middle; fill: #64748b; opacity: 0.85;">
                                            Revenue
                                        </text>
                                    </g>
                                </svg>
                                <div class="mt-3 text-left w-100" style="color: #64748b; font-size: 0.8rem; padding-left: 10px;">
                                    <t t-foreach="this.state.donut_segments" t-as="seg" t-key="seg.category">
                                        <span class="mr-3 d-inline-block mb-1" style="font-weight: 600;">
                                            <i class="fa fa-circle mr-1" t-att-style="'color: ' + (seg.category == 'Hair Care' ? '#8b5cf6' : (seg.category == 'Skin Care' ? '#06b6d4' : (seg.category == 'Nail Care' ? '#4f46e5' : (seg.category == 'Massage Therapy' ? '#1e293b' : seg.color))))"></i>
                                            <t t-esc="seg.category"/> (<t t-esc="seg.percent"/>%)
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Polar Area Chart -->
                    <div class="col-xl-4 col-md-6 mb-4 mb-xl-0">
                        <div class="neumorphic-card h-100">
                            <div class="d-flex flex-column mb-3">
                                <h6 class="m-0" style="font-size: 1.05rem; font-weight: 750; color: #1e293b;">Booking Density by Time of Day</h6>
                                <p class="text-muted small mb-0" style="font-weight: 500; margin-top: 2px;">Hourly booking distribution analysis</p>
                            </div>
                            <div class="card-body p-0 d-flex flex-column align-items-center justify-content-center" style="min-height: 220px;">
                                <svg width="160" height="150" viewBox="0 0 200 190" style="height: 150px;">
                                    <circle cx="100" cy="95" r="75" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="2,2"/>
                                    <circle cx="100" cy="95" r="55" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="2,2"/>
                                    <circle cx="100" cy="95" r="35" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="2,2"/>
                                    
                                    <!-- Segments -->
                                    <t t-foreach="this.state.polar_paths" t-as="p" t-key="p.name">
                                        <path t-att-d="p.path" t-att-fill="p.color" fill-opacity="0.75">
                                            <title><t t-esc="p.name"/>: <t t-esc="p.count"/> bookings</title>
                                        </path>
                                    </t>

                                    <!-- Center Pin -->
                                    <circle cx="100" cy="95" r="7" fill="#ffffff" stroke="#8b5cf6" stroke-width="2.5"/>
                                    <circle cx="100" cy="95" r="2.5" fill="#8b5cf6"/>

                                    <!-- Text labels -->
                                    <text x="145" y="50" fill="#475569" font-size="8.5" font-weight="800">Morning</text>
                                    <text x="145" y="140" fill="#475569" font-size="8.5" font-weight="800">Mid-day</text>
                                    <text x="55" y="140" fill="#475569" font-size="8.5" font-weight="800">Afternoon</text>
                                    <text x="55" y="50" fill="#475569" font-size="8.5" font-weight="800">Evening</text>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Radar Chart -->
                    <div class="col-xl-4 col-md-12">
                        <div class="neumorphic-card h-100">
                            <div class="d-flex flex-column mb-3">
                                <h6 class="m-0" style="font-size: 1.05rem; font-weight: 750; color: #1e293b;">Staff Specialization Profile</h6>
                                <p class="text-muted small mb-0" style="font-weight: 500; margin-top: 2px;">Skill breakdown for top beauticians</p>
                            </div>
                            <div class="card-body p-0 d-flex flex-column align-items-center justify-content-center" style="min-height: 220px;">
                                <svg width="180" height="170" viewBox="0 0 220 190" style="height: 170px; width: 100%;">
                                    <!-- Web structure -->
                                    <polygon points="110,10 200,75 165,175 55,175 20,75" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="3,3"/>
                                    <polygon points="110,40 170,85 147,150 73,150 50,85" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="3,3"/>
                                    <polygon points="110,70 140,95 128,125 92,125 80,95" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="3,3"/>
                                    
                                    <!-- Axis Lines -->
                                    <line x1="110" y1="100" x2="110" y2="10" stroke="#cbd5e1" stroke-width="1.2"/>
                                    <line x1="110" y1="100" x2="200" y2="75" stroke="#cbd5e1" stroke-width="1.2"/>
                                    <line x1="110" y1="100" x2="165" y2="175" stroke="#cbd5e1" stroke-width="1.2"/>
                                    <line x1="110" y1="100" x2="55" y2="175" stroke="#cbd5e1" stroke-width="1.2"/>
                                    <line x1="110" y1="100" x2="20" y2="75" stroke="#cbd5e1" stroke-width="1.2"/>

                                    <!-- Labels -->
                                    <text x="110" y="8" fill="#475569" font-size="8.5" text-anchor="middle" font-weight="800">Hair</text>
                                    <text x="204" y="78" fill="#475569" font-size="8.5" text-anchor="start" font-weight="800">Nail</text>
                                    <text x="168" y="184" fill="#475569" font-size="8.5" text-anchor="start" font-weight="800">Makeup</text>
                                    <text x="52" y="184" fill="#475569" font-size="8.5" text-anchor="end" font-weight="800">Skin</text>
                                    <text x="16" y="78" fill="#475569" font-size="8.5" text-anchor="end" font-weight="800">Massage</text>

                                    <!-- Skill Area 1 -->
                                    <polygon t-att-points="this.state.radar_points_1" fill="#3b82f6" fill-opacity="0.25" stroke="#3b82f6" stroke-width="2.5" stroke-linejoin="round"/>
                                    <!-- Skill Area 2 -->
                                    <polygon t-att-points="this.state.radar_points_2" fill="#8b5cf6" fill-opacity="0.15" stroke="#8b5cf6" stroke-width="2.5" stroke-dasharray="3,3" stroke-linejoin="round"/>
                                </svg>
                                <div class="mt-2 text-center" style="color: #64748b; font-size: 0.75rem; font-weight: 600;">
                                    <span t-if="this.state.radar_employee_1_name" class="mr-3">
                                        <i class="fa fa-circle mr-1" style="color: #3b82f6;"></i> <t t-esc="this.state.radar_employee_1_name"/>
                                    </span>
                                    <span t-if="this.state.radar_employee_2_name">
                                        <i class="fa fa-circle mr-1" style="color: #8b5cf6;"></i> <t t-esc="this.state.radar_employee_2_name"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 4: Service Packages (6/12) + Beauticians (6/12) -->
                <div class="row mb-4 align-items-stretch">
                    <!-- Popular Service Packages (6/12) -->
                    <div class="col-md-6 mb-4 mb-md-0">
                        <div class="neumorphic-card h-100">
                            <div class="d-flex flex-column mb-3">
                                <h6 class="m-0" style="font-size: 1.05rem; font-weight: 750; color: #1e293b;">Popular Salon Services</h6>
                                <p class="text-muted small mb-0" style="font-weight: 500; margin-top: 2px;">Most requested services by booking share</p>
                            </div>
                            <div class="card-body p-0 d-flex flex-column justify-content-center" style="min-height: 200px;">
                                <t t-foreach="this.state.top_packages" t-as="pkg" t-key="pkg.name">
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small font-weight-bold mb-2" style="color: #4b5563; font-size: 0.8rem;">
                                            <span><t t-esc="pkg.name"/></span>
                                            <span style="color: #8b5cf6;"><t t-esc="pkg.percent"/>%</span>
                                        </div>
                                        <div class="progress neumorphic-progress">
                                            <div class="progress-bar neumorphic-progress-bar" role="progressbar" t-att-style="'width: ' + pkg.percent + '%; background: ' + (pkg.color == '#00CEB3' ? 'linear-gradient(135deg, #06b6d4, #0891b2)' : (pkg.color == '#4e73df' ? 'linear-gradient(135deg, #8b5cf6, #7c3aed)' : 'linear-gradient(135deg, #4f46e5, #3b82f6)'))" t-att-aria-valuenow="pkg.percent" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Beauticians (6/12) -->
                    <div class="col-md-6">
                        <div class="neumorphic-card h-100">
                            <div class="d-flex flex-row align-items-center justify-content-between mb-4">
                                <h6 class="m-0" style="font-size: 1.1rem; font-weight: 750; color: #1e293b;">Top Performing Beauticians</h6>
                            </div>
                            <div class="table-responsive table-responsive-scrollable" style="max-height: 220px;">
                                <table class="neumorphic-table" style="font-size: 0.9rem;">
                                    <thead>
                                        <tr>
                                            <th>Staff Name</th>
                                            <th>Bookings</th>
                                            <th>Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.beautician_rankings" t-as="staff" t-key="staff.name">
                                            <tr>
                                                <td style="font-weight: 700; color: #1e293b; padding: 10px 14px !important;"><t t-esc="staff.name"/></td>
                                                <td style="padding: 10px 14px !important;"><span class="badge" style="background: #f1f5f9; color: #3b82f6; box-shadow: inset 1px 1px 3px rgba(0,0,0,0.03); border-radius: 8px; padding: 5px 10px; font-weight: 600;"><t t-esc="staff.bookings"/> bookings</span></td>
                                                <td style="font-weight: 700; color: #8b5cf6; padding: 10px 14px !important;">$<t t-esc="staff.revenue.toFixed(2)"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="this.state.beautician_rankings.length == 0">
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-4" style="background: #ffffff !important; border-radius: 16px;">
                                                    No bookings loaded.
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 5: Service Category Summary (Full width) -->
                <div class="row">
                    <div class="col-12">
                        <div class="neumorphic-card">
                            <div class="d-flex flex-row align-items-center justify-content-between mb-4">
                                <h6 class="m-0" style="font-size: 1.1rem; font-weight: 750; color: #1e293b;">Service Category Summary</h6>
                            </div>
                            <div class="table-responsive table-responsive-scrollable">
                                <table class="neumorphic-table" style="font-size: 0.9rem;">
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th>Bookings</th>
                                            <th>Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.category_rankings" t-as="cat" t-key="cat.name">
                                            <tr>
                                                <td style="font-weight: 700; color: #1e293b;"><t t-esc="cat.name"/></td>
                                                <td><span class="badge" style="background: #f1f5f9; color: #3b82f6; box-shadow: inset 1px 1px 3px rgba(0,0,0,0.05); border-radius: 8px; padding: 5px 10px; font-weight: 600;"><t t-esc="cat.bookings"/> bookings</span></td>
                                                <td style="font-weight: 700; color: #8b5cf6;">$<t t-esc="cat.revenue.toFixed(2)"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="this.state.category_rankings.length == 0">
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-4" style="background: #ffffff !important; border-radius: 16px;">
                                                    No bookings loaded.
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
