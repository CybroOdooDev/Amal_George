<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== Booking Page Record (website.page) ========== -->
    <record id="salon_booking_website_page" model="website.page">
        <field name="name">Salon Booking Portal</field>
        <field name="type">qweb</field>
        <field name="url">/salon-booking</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published">True</field>
        <field name="key">salon_management_saas.salon_booking_website_page</field>
        <field name="arch" type="xml">
            <t name="Salon Booking Portal" t-name="salon_management_saas.salon_booking_website_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <div class="container py-5">
                            <div class="row">
                                <!-- Left Column: Interactive Form -->
                                <div class="col-lg-8">
                                    <h2 class="font-weight-bold mb-4" style="font-weight: 800; color: #1e293b; letter-spacing: -0.02em;">Book Appointment</h2>

                                    <form id="salon_booking_form" method="post" class="container-fluid p-0" t-att-data-is-public="request.env.user._is_public()">
                                        <!-- Hidden Inputs to bind selected values -->
                                        <input type="hidden" name="x_studio_booking_type" id="x_studio_booking_type" value=""/>
                                        <input type="hidden" name="x_studio_service" id="x_studio_service" value=""/>
                                        <input type="hidden" name="x_studio_service_package" id="x_studio_service_package" value=""/>
                                        <input type="hidden" name="x_studio_date" id="x_studio_date" value=""/>
                                        <input type="hidden" name="x_studio_time_slot" id="x_studio_time_slot" value=""/>
                                        <input type="hidden" name="x_studio_chair_num" id="x_studio_chair_num" value=""/>
                                        <input type="hidden" name="x_studio_staff_beautician" id="x_studio_staff_beautician" value=""/>
                                        <input type="hidden" name="x_studio_partner_id" id="x_studio_partner_id" t-att-value="request.env.user.partner_id.id"/>

                                        <!-- Pre-load all company, holiday, employee, chair and booking data to bypass guest RPC limitations -->
                                        <t t-set="companies" t-value="request.env['res.company'].sudo().search([])"/>
                                        <t t-set="active_co_for_h" t-value="companies.filtered(lambda c: c.x_studio_holiday_sunday or c.x_studio_holiday_monday or c.x_studio_holiday_tuesday or c.x_studio_holiday_wednesday or c.x_studio_holiday_thursday or c.x_studio_holiday_friday or c.x_studio_holiday_saturday or (c.x_studio_holiday_ids and len(c.x_studio_holiday_ids) &gt; 0))"/>
                                        <t t-set="active_company" t-value="active_co_for_h[0] if len(active_co_for_h) &gt; 0 else request.env.company"/>
                                        <t t-set="active_co_for_b" t-value="companies.filtered(lambda c: c.x_studio_allow_break)"/>
                                        <t t-set="break_company" t-value="active_co_for_b[0] if len(active_co_for_b) &gt; 0 else request.env.company"/>

                                        <div id="salon_company_settings" class="d-none"
                                             t-att-data-holiday-sunday="'true' if active_company.x_studio_holiday_sunday else 'false'"
                                             t-att-data-holiday-monday="'true' if active_company.x_studio_holiday_monday else 'false'"
                                             t-att-data-holiday-tuesday="'true' if active_company.x_studio_holiday_tuesday else 'false'"
                                             t-att-data-holiday-wednesday="'true' if active_company.x_studio_holiday_wednesday else 'false'"
                                             t-att-data-holiday-thursday="'true' if active_company.x_studio_holiday_thursday else 'false'"
                                             t-att-data-holiday-friday="'true' if active_company.x_studio_holiday_friday else 'false'"
                                             t-att-data-holiday-saturday="'true' if active_company.x_studio_holiday_saturday else 'false'"
                                             t-att-data-allow-break="'true' if break_company.x_studio_allow_break else 'false'"
                                             t-att-data-break-start="break_company.x_studio_break_start or ''"
                                             t-att-data-break-end="break_company.x_studio_break_end or ''"
                                        />

                                        <div id="salon_holidays_data" class="d-none">
                                            <t t-if="active_company.x_studio_holiday_ids">
                                                <t t-foreach="request.env['x_salon_holiday'].sudo().search([('id', 'in', active_company.x_studio_holiday_ids.ids)])" t-as="holiday">
                                                    <span t-att-data-name="holiday.x_name" t-att-data-date="holiday.x_studio_date"/>
                                                </t>
                                            </t>
                                        </div>

                                        <div id="salon_employees_data" class="d-none">
                                            <t t-foreach="request.env['hr.employee'].sudo().search([])" t-as="emp">
                                                <span t-att-data-id="emp.id" t-att-data-name="emp.name">
                                                    <t t-if="emp.x_studio_specialties">
                                                        <t t-foreach="emp.x_studio_specialties" t-as="spec">
                                                            <i t-att-data-spec-id="spec.id"/>
                                                        </t>
                                                    </t>
                                                </span>
                                            </t>
                                        </div>

                                        <div id="salon_chairs_data" class="d-none">
                                            <t t-foreach="request.env['x_chair'].sudo().search([])" t-as="chair">
                                                <span t-att-data-id="chair.id" t-att-data-name="chair.x_name"/>
                                            </t>
                                        </div>

                                        <div id="salon_bookings_data" class="d-none">
                                            <t t-set="today_str" t-value="datetime.date.today().strftime('%Y-%m-%d')"/>
                                            <t t-foreach="request.env['x_appointment'].sudo().search([('x_studio_date', '&gt;=', today_str), ('x_studio_selection_1', 'in', ['Confirmed', 'Completed', 'In Progress', 'Checked In']), ('x_studio_chair_num', '!=', False)])" t-as="booking">
                                                <span t-att-data-date="booking.x_studio_date"
                                                      t-att-data-slot="booking.x_studio_time_slot"
                                                      t-att-data-duration="booking.x_studio_duration or 30"
                                                      t-att-data-chair-id="booking.x_studio_chair_num.id"
                                                      t-att-data-chair-name="booking.x_studio_chair_num.x_name"
                                                />
                                            </t>
                                        </div>

                                        <!-- Step 1: Booking Type Pills -->
                                        <div class="mb-4">
                                            <label class="salon-label">1. Booking Type</label>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-outline-primary booking-type-pill py-2 px-4" data-value="service" style="border-radius: 20px; font-weight: 600;">Service</button>
                                                <button type="button" class="btn btn-outline-primary booking-type-pill py-2 px-4" data-value="package" style="border-radius: 20px; font-weight: 600;">Service Package</button>
                                            </div>
                                        </div>

                                        <!-- Step 2a: Services Grid (Conditional) -->
                                        <div class="mb-4" id="service_group" style="display: none;">
                                            <label class="salon-label">2. Select Service</label>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                <t t-foreach="request.env['x_service'].sudo().search([('x_active', '=', True)])" t-as="srv">
                                                    <div class="col">
                                                        <div class="card h-100 service-card-pill border" t-att-data-id="srv.id"
                                                             t-att-data-duration="srv.x_studio_duration_minutes"
                                                             t-att-data-price="srv.x_studio_value"
                                                             t-att-data-name="srv.x_name"
                                                             t-att-data-category_id="srv.x_studio_service_category.id"
                                                             style="cursor: pointer; border-radius: 12px; transition: all 0.2s;">
                                                            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <h6 class="font-weight-bold mb-1" style="color: #334155;"><t t-out="srv.x_name"/></h6>
                                                                    <span class="text-muted small"><t t-out="srv.x_studio_duration_minutes"/> mins</span>
                                                                </div>
                                                                <div class="text-primary font-weight-bold">$<t t-out="srv.x_studio_value"/></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>

                                        <!-- Step 2b: Packages Grid (Conditional) -->
                                        <div class="mb-4" id="package_group" style="display: none;">
                                            <label class="salon-label">2. Select Service Package</label>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                <t t-foreach="request.env['x_service_package'].sudo().search([('x_studio_status', '=', 'active')])" t-as="pkg">
                                                    <div class="col">
                                                        <div class="card h-100 package-card-pill border" t-att-data-id="pkg.id"
                                                             t-att-data-duration="sum(s.x_studio_duration_minutes or 0 for s in pkg.x_studio_many2many_1)"
                                                             t-att-data-price="pkg.x_studio_value"
                                                             t-att-data-name="pkg.x_name"
                                                             t-att-data-staff_ids="','.join(map(str, pkg.x_studio_staff_ids.ids))"
                                                             style="cursor: pointer; border-radius: 12px; transition: all 0.2s;">
                                                            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <h6 class="font-weight-bold mb-1" style="color: #334155;"><t t-out="pkg.x_name"/></h6>
                                                                    <span class="text-muted small">Package</span>
                                                                </div>
                                                                <div class="text-primary font-weight-bold">$<t t-out="pkg.x_studio_value"/></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>

                                        <!-- Step 2.5: Select Beautician (Dropdown) -->
                                        <div class="mb-4" id="beautician_group" style="display: none;">
                                            <label class="salon-label">2.5. Preferred Beautician</label>
                                            <select class="form-control" id="beautician_select" style="border-radius: 10px; max-width: 480px; height: auto; padding: 10px;">
                                                <option value="">Choose a Beautician...</option>
                                            </select>
                                        </div>

                                        <!-- Step 3: Inline Date Picker Calendar -->
                                        <div class="mb-4" id="calendar_group" style="display: none;">
                                            <label class="salon-label">3. Select Date</label>
                                            <div class="card border p-3 shadow-sm mx-0" style="border-radius: 15px; max-width: 480px;">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <button type="button" class="btn btn-sm btn-light" id="prev_month" style="border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-weight: bold;">&lt;</button>
                                                    <h5 class="mb-0 font-weight-bold text-dark" id="calendar_title">August 2026</h5>
                                                    <button type="button" class="btn btn-sm btn-light" id="next_month" style="border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-weight: bold;">&gt;</button>
                                                </div>
                                                <div class="calendar-grid">
                                                    <div class="calendar-header-day">Sun</div>
                                                    <div class="calendar-header-day">Mon</div>
                                                    <div class="calendar-header-day">Tue</div>
                                                    <div class="calendar-header-day">Wed</div>
                                                    <div class="calendar-header-day">Thu</div>
                                                    <div class="calendar-header-day">Fri</div>
                                                    <div class="calendar-header-day">Sat</div>
                                                    <!-- Dynamic calendar days -->
                                                    <div id="calendar_days" class="d-contents"></div>
                                                </div>
                                                <small id="date_feedback" class="text-danger mt-2 d-block" style="display: none;"></small>
                                            </div>
                                        </div>

                                        <!-- Step 4: Pick a Time (Pills) -->
                                        <div class="mb-4" id="slot_group" style="display: none;">
                                            <label class="salon-label">4. Pick a Time</label>
                                            <div class="d-flex flex-wrap gap-2" id="slot_pills_container">
                                                <!-- Dynamic slot pills -->
                                            </div>
                                        </div>

                                        <!-- Step 5: Select Chair (Pills) -->
                                        <div class="mb-4" id="chair_group" style="display: none;">
                                            <label class="salon-label">5. Select Chair</label>
                                            <div class="d-flex flex-wrap gap-2" id="chair_pills_container">
                                                <!-- Dynamic chair pills -->
                                            </div>
                                        </div>

                                         <!-- Guest Contact Information -->
                                         <t t-if="request.env.user._is_public()">
                                             <div class="mb-4 mt-5 p-4 border rounded bg-white shadow-sm" style="border-radius: 16px; border-color: #e2e8f0 !important;">
                                                 <h5 class="mb-3 font-weight-bold" style="color: #1e293b; font-size: 1.15rem; letter-spacing: -0.01em;">Contact Information</h5>
                                                 <p class="text-muted small mb-4">Please provide your details to receive your booking confirmation.</p>
                                                 <div class="row">
                                                     <div class="col-md-12 mb-3">
                                                         <label class="salon-label" for="guest_name">Full Name <span class="text-danger">*</span></label>
                                                         <input type="text" id="guest_name" name="x_studio_text_1" class="form-control salon-input" placeholder="e.g. John Doe" required="required" style="height: 48px; border-radius: 10px; border-color: #cbd5e1; padding: 12px 16px;"/>
                                                     </div>
                                                     <div class="col-md-6 mb-3">
                                                         <label class="salon-label" for="guest_email">Email Address <span class="text-danger">*</span></label>
                                                         <input type="email" id="guest_email" name="x_studio_partner_email" class="form-control salon-input" placeholder="e.g. john.doe@example.com" required="required" style="height: 48px; border-radius: 10px; border-color: #cbd5e1; padding: 12px 16px;"/>
                                                     </div>
                                                     <div class="col-md-6 mb-3">
                                                         <label class="salon-label" for="guest_phone">Phone Number <span class="text-danger">*</span></label>
                                                         <input type="tel" id="guest_phone" name="x_studio_partner_phone" class="form-control salon-input" placeholder="e.g. +1 555-555-5556" required="required" style="height: 48px; border-radius: 10px; border-color: #cbd5e1; padding: 12px 16px;"/>
                                                     </div>
                                                 </div>
                                             </div>
                                         </t>

                                        <!-- Submit Button -->
                                        <div class="mt-5">
                                            <button type="submit" id="btn_confirm_booking" class="btn btn-primary btn-lg salon-btn-submit" disabled="disabled">Request Booking</button>
                                        </div>
                                    </form>
                                </div>

                                <!-- Right Column: Sidebar Info Panel -->
                                <div class="col-lg-4 mt-5 mt-lg-0">
                                    <div class="card border p-4 bg-light position-sticky" style="top: 100px; border-radius: 20px; border-color: #e2e8f0;">
                                        <div class="mb-4">
                                            <h5 class="font-weight-bold" style="color: #4c1d95;" id="sidebar_salon_title">Studio Salon</h5>
                                            <p class="text-muted small mb-0 mt-1"><i class="fa fa-map-marker text-primary mr-2"/> 4141 Main Avenue, Saint-Louis, US</p>
                                        </div>

                                        <!-- Dynamic Summary Info -->
                                        <div class="border-top pt-4 mb-4" id="sidebar_selection_info" style="display: none;">
                                            <h6 class="font-weight-bold text-muted mb-3">Your Selection</h6>
                                            <div class="mb-2 d-flex justify-content-between align-items-center">
                                                <span class="font-weight-bold text-dark" id="sidebar_item_name">Service</span>
                                                <span class="text-primary font-weight-bold" id="sidebar_item_price">$0.00</span>
                                            </div>
                                            <div class="text-muted small mb-2"><i class="fa fa-clock-o mr-2"/> <span id="sidebar_item_duration">0</span> mins</div>
                                            <div class="text-muted small mb-2"><i class="fa fa-calendar mr-2"/> <span id="sidebar_item_date">-</span></div>
                                            <div class="text-muted small"><i class="fa fa-chair mr-2"/> <span id="sidebar_item_chair">-</span></div>
                                        </div>

                                        <div class="border-top pt-4">
                                            <h6 class="font-weight-bold text-muted mb-2">About Our Salon</h6>
                                            <p class="text-muted small mb-0" style="line-height: 1.6;">
                                                Easily reserve your groom, manicure, styling, and massage sessions anytime. Pick your preferred date, time, and chair to enjoy a premium, uninterrupted session.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <style>
                        .salon-label {
                            font-weight: 700;
                            font-size: 0.85rem;
                            text-transform: uppercase;
                            letter-spacing: 0.08em;
                            color: #64748b;
                            margin-bottom: 12px;
                            display: block;
                        }
                        .booking-type-pill {
                            border-color: #cbd5e1;
                            color: #475569;
                        }
                        .booking-type-pill.active {
                            background-color: #8b5cf6 !important;
                            border-color: #8b5cf6 !important;
                            color: white !important;
                        }
                        .service-card-pill.active, .package-card-pill.active {
                            border-color: #8b5cf6 !important;
                            background-color: #faf5ff !important;
                            box-shadow: 0 0 0 2px #8b5cf6;
                        }
                        .pill-button {
                            border: 1px solid #cbd5e1;
                            background: white;
                            color: #334155;
                            padding: 8px 18px;
                            border-radius: 20px;
                            cursor: pointer;
                            font-weight: 500;
                            transition: all 0.2s;
                            font-size: 0.9rem;
                        }
                        .pill-button:hover:not(.disabled):not(.active) {
                            border-color: #8b5cf6;
                            color: #8b5cf6;
                        }
                        .pill-button.active {
                            background-color: #8b5cf6;
                            border-color: #8b5cf6;
                            color: white;
                            font-weight: 600;
                        }
                        .pill-button.disabled {
                            background-color: #f1f5f9;
                            border-color: #e2e8f0;
                            color: #cbd5e1;
                            cursor: not-allowed;
                        }
                        .calendar-grid {
                            display: grid;
                            grid-template-columns: repeat(7, 1fr);
                            gap: 6px;
                            text-align: center;
                        }
                        .calendar-header-day {
                            font-weight: 700;
                            font-size: 0.75rem;
                            color: #94a3b8;
                            padding-bottom: 6px;
                            text-transform: uppercase;
                        }
                        .calendar-day {
                            aspect-ratio: 1;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            border-radius: 50%;
                            cursor: pointer;
                            font-weight: 600;
                            font-size: 0.9rem;
                            transition: background-color 0.15s, color 0.15s;
                            user-select: none;
                            color: #334155;
                        }
                        .calendar-day:hover:not(.disabled):not(.selected) {
                            background-color: #f1f5f9;
                        }
                        .calendar-day.selected {
                            background-color: #8b5cf6;
                            color: white;
                        }
                        .calendar-day.disabled {
                            color: #cbd5e1;
                            cursor: not-allowed;
                            background-color: transparent;
                            font-weight: 400;
                        }
                        .calendar-day.today {
                            border: 2px solid #8b5cf6;
                        }
                        .d-contents {
                            display: contents;
                        }
                        .salon-btn-submit {
                            background: linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%);
                            color: white;
                            border: none;
                            border-radius: 30px;
                            font-weight: 600;
                            padding: 12px 35px;
                            font-size: 1rem;
                            box-shadow: 0 4px 6px -1px rgba(109, 40, 217, 0.2);
                            transition: opacity 0.2s, transform 0.2s;
                        }
                        .salon-btn-submit:hover:not(:disabled) {
                            opacity: 0.95;
                            transform: translateY(-1px);
                            color: white;
                        }
                        .salon-btn-submit:disabled {
                            opacity: 0.5;
                            cursor: not-allowed;
                        }
                    </style>
                </t>
            </t>
        </field>
    </record>

    <!-- ========== Success Page Record (website.page) ========== -->
    <record id="salon_booking_success_website_page" model="website.page">
        <field name="name">Booking Requested</field>
        <field name="type">qweb</field>
        <field name="url">/booking/success</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">salon_management_saas.salon_booking_success_website_page</field>
        <field name="arch" type="xml">
            <t name="Booking Requested" t-name="salon_booking_success_website_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <div class="container py-5 text-center">
                            <div class="card border mx-auto p-5 shadow-sm" style="max-width: 600px; border-radius: 20px; border-color: #e2e8f0; background: #ffffff;">
                                <div class="mb-4">
                                    <span class="d-inline-flex align-items-center justify-content-center text-white rounded-circle" style="width: 72px; height: 72px; font-size: 2.2rem; background: linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%); box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3);">✓</span>
                                </div>
                                <h2 class="mb-3 font-weight-bold" style="font-weight: 800; color: #4c1d95;">Booking Requested!</h2>
                                <p class="text-muted mb-4 fs-6">Your booking has been requested and is waiting for confirmation. If confirmed, you will get a confirmation mail.</p>
                                <a href="/salon-booking" class="btn btn-outline-primary px-4 py-2" style="border-radius: 10px; font-weight: 600; border-color: #8b5cf6; color: #8b5cf6;">Book Another Appointment</a>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ========== Services Portal Page ========== -->
    <record id="salon_services_website_page" model="website.page">
        <field name="name">Services</field>
        <field name="type">qweb</field>
        <field name="url">/services</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published">True</field>
        <field name="key">salon_management_saas.salon_booking_services_website_page</field>
        <field name="arch" type="xml">
            <t name="Services" t-name="salon_management_saas.salon_booking_services_website_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty" style="background-color: #fcfaff;">
                        <!-- Banner Section -->
                        <div class="container py-5 text-center">
                            <h1 class="display-4 font-weight-bold" style="font-weight: 800; color: #4c1d95; letter-spacing: -0.02em;">Our Services</h1>
                            <p class="lead text-muted mx-auto" style="max-width: 600px; font-weight: 500;">
                                Indulge in our range of premium beauty and styling services tailored just for you.
                            </p>
                            <div class="mx-auto my-3" style="width: 60px; height: 3px; background-color: #8b5cf6; border-radius: 2px;"></div>
                        </div>

                        <!-- Categories & Services Section -->
                        <div class="container pb-5">
                            <t t-foreach="request.env['x_service_category'].sudo().search([('x_active', '=', True)])" t-as="category">
                                <t t-set="services" t-value="request.env['x_service'].sudo().search([('x_studio_service_category', '=', category.id), ('x_active', '=', True)])"/>
                                <t t-if="services">
                                    <div class="mb-5">
                                        <h3 class="text-uppercase mb-4" style="font-weight: 800; color: #6b21a8; letter-spacing: 0.05em; font-size: 1.15rem;"><span t-out="category.x_name"/></h3>
                                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                            <t t-foreach="services" t-as="srv">
                                                <div class="col">
                                                    <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 16px; background: #ffffff; transition: transform 0.2s, box-shadow 0.2s; border: 1px solid #f3e8ff !important;">
                                                        <div class="card-body d-flex flex-column justify-content-between p-2">
                                                            <div>
                                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                                    <h5 class="card-title font-weight-bold mb-0 text-dark" style="font-weight: 700; font-size: 1.05rem;"><span t-out="srv.x_name"/></h5>
                                                                    <span class="font-weight-bold text-primary" style="font-weight: 750; color: #7c3aed; font-size: 1.1rem;">
                                                                        $<span t-out="float(srv.x_studio_value or 0.0)"/>
                                                                    </span>
                                                                </div>
                                                                <hr style="border-top: 1px solid #f3e8ff; margin: 12px 0;"/>
                                                                <div class="d-flex align-items-center text-muted mb-3 small" style="font-weight: 500;">
                                                                    <i class="fa fa-clock-o me-2" style="color: #a78bfa;"></i>
                                                                    <span><span t-out="srv.x_studio_duration_minutes or 30"/> mins</span>
                                                                    <t t-if="srv.x_studio_gender">
                                                                        <span class="mx-2">•</span>
                                                                        <i class="fa fa-venus-mars me-2" style="color: #a78bfa;"></i>
                                                                        <span><span t-out="srv.x_studio_gender"/></span>
                                                                    </t>
                                                                </div>
                                                                <p t-if="srv.x_studio_description" class="text-muted small mb-3 text-start" style="line-height: 1.5; min-height: 45px;">
                                                                    <span t-out="srv.x_studio_description"/>
                                                                </p>
                                                            </div>
                                                            <div class="mt-auto">
                                                                <a t-attf-href="/salon-booking?type=service&amp;service_id=#{srv.id}" class="btn btn-primary w-100 py-2 font-weight-bold" style="border-radius: 10px; background-color: #8b5cf6; border: none; font-weight: 600; font-size: 0.9rem; transition: background-color 0.2s;">
                                                                    Book Now
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ========== Service Packages Portal Page ========== -->
    <record id="salon_packages_website_page" model="website.page">
        <field name="name">Service Packages</field>
        <field name="type">qweb</field>
        <field name="url">/service-packages</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published">True</field>
        <field name="key">salon_management_saas.salon_booking_packages_website_page</field>
        <field name="arch" type="xml">
            <t name="Service Packages" t-name="salon_management_saas.salon_booking_packages_website_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty" style="background-color: #fcfaff;">
                        <!-- Banner Section -->
                        <div class="container py-5 text-center">
                            <h1 class="display-4 font-weight-bold" style="font-weight: 800; color: #4c1d95; letter-spacing: -0.02em;">Exclusive Packages</h1>
                            <p class="lead text-muted mx-auto" style="max-width: 600px; font-weight: 500;">
                                Save more and experience pure bliss with our curated wellness and beauty packages.
                            </p>
                            <div class="mx-auto my-3" style="width: 60px; height: 3px; background-color: #8b5cf6; border-radius: 2px;"></div>
                        </div>

                        <!-- Packages Grid Section -->
                        <div class="container pb-5">
                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
                                <t t-foreach="request.env['x_service_package'].sudo().search([('x_active', '=', True)])" t-as="pkg">
                                    <div class="col">
                                        <div class="card h-100 border-0 shadow-sm p-4 text-center d-flex flex-column justify-content-between" style="border-radius: 16px; background: #ffffff; border: 1px solid #f3e8ff !important;">
                                            <div>
                                                <t t-if="pkg.x_studio_limited_time">
                                                    <div class="badge bg-warning-soft text-warning mb-3" style="background-color: #fef3c7; color: #d97706; border-radius: 6px; padding: 6px 12px; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.03em;">
                                                        <i class="fa fa-clock-o mr-1"/> Limited Time Offer
                                                    </div>
                                                </t>
                                                <h3 class="mb-2" style="font-weight: 800; color: #581c87; font-size: 1.35rem;"><span t-out="pkg.x_name"/></h3>
                                                <div class="my-4 d-flex align-items-center justify-content-center flex-wrap">
                                                    <t t-if="pkg.x_studio_discount_1">
                                                        <span class="text-muted text-decoration-line-through me-2" style="font-size: 1.1rem; font-weight: 500;">
                                                            $<span t-out="float(pkg.x_studio_original_value or 0.0)"/>
                                                        </span>
                                                        <span class="badge bg-danger-soft text-danger me-3" style="background-color: #fee2e2; color: #ef4444; border-radius: 6px; padding: 4px 8px; font-weight: 700; font-size: 0.8rem; border: 1px solid #fecaca;">
                                                            <span t-out="int(pkg.x_studio_discount_1)"/>% OFF
                                                        </span>
                                                    </t>
                                                    <span class="display-5 font-weight-bold" style="font-weight: 800; color: #8b5cf6; font-size: 2.2rem;">
                                                        $<span t-out="float(pkg.x_studio_value or 0.0)"/>
                                                    </span>
                                                </div>

                                                <t t-if="pkg.x_studio_description">
                                                    <p class="text-muted small text-center mb-4" style="line-height: 1.5;">
                                                        <span t-out="pkg.x_studio_description"/>
                                                    </p>
                                                </t>

                                                <t t-if="pkg.x_studio_many2many_1">
                                                    <div class="text-start mt-4 mb-4" style="border-top: 1px solid #f3e8ff; pt-3">
                                                        <h6 class="text-uppercase mb-3 mt-3" style="font-weight: 800; color: #6b21a8; font-size: 0.8rem; letter-spacing: 0.05em;">Services Included:</h6>
                                                        <ul class="list-unstyled p-0 m-0 small">
                                                            <t t-foreach="pkg.x_studio_many2many_1" t-as="srv">
                                                                <li class="mb-2 d-flex align-items-center" style="font-weight: 500; color: #4b5563;">
                                                                    <i class="fa fa-check me-2" style="color: #10b981;"></i>
                                                                    <span><span t-out="srv.x_name"/></span>
                                                                </li>
                                                            </t>
                                                        </ul>
                                                    </div>
                                                </t>
                                            </div>

                                            <div class="mt-auto">
                                                <a t-attf-href="/salon-booking?type=package&amp;package_id=#{pkg.id}" class="btn btn-primary w-100 py-2.5 font-weight-bold" style="border-radius: 10px; background-color: #8b5cf6; border: none; font-weight: 600; font-size: 0.95rem; transition: background-color 0.2s;">
                                                    Book Package
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ========== Header Navigation Menu Items ========== -->
    <record id="menu_salon_services" model="website.menu">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">20</field>
    </record>

    <record id="menu_salon_packages" model="website.menu">
        <field name="name">Service Packages</field>
        <field name="url">/service-packages</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">30</field>
    </record>

    <record id="menu_salon_booking" model="website.menu">
        <field name="name">Book Appointment</field>
        <field name="url">/salon-booking</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">40</field>
    </record>
</odoo>
