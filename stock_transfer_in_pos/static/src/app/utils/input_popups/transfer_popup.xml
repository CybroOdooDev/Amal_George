<?xml version="1.0" encoding="UTF-8"?>
<!--This template is used for creating transfer popup-->
<templates id="template" xml:space="preserve">
    <t t-name="stock_transfer_in_pos.TransferPopup">
        <Dialog title="this.props.title" bodyClass="'d-flex flex-column justify-content-center'" size="'md'">
        <div class="popup popup-text popup-med stock-transfer-popup"
             style="width:100%">
            <h2 class="p-3">Stock Transfer</h2>
            <br/>
            <center>
                <tr style="width:50%;height:30px">
                    <td style="width:200px">
                        <label for="picking_type" class="control-label">Picking Type:</label>
                    </td>
                    <td>
                        <select id="picking" class="form-control link-style"
                                t-ref="this.picking"
                                style="width:400px;height:35px;border-radius:5px;"
                                t-on-change="(ev) => this._clickPicking(ev)"
                                required="required">
                            <option value="" selected="selected">Select an option</option>
                        <t t-foreach="this.props.data['picking_type'] || []"
                           t-as="picking" t-key="picking.id">
                            <option t-att-value="picking.id"
                                    t-att-data-type="picking.code">
                                <t t-out="picking.display_name"/>
                            </option>
                        </t>
                    </select>
                </td>
            </tr>
            <br/>
            <tr style="width:50%;height:30px" id="source_tr"
                t-ref="this.source_tr">
                <td style="width:200px">
                    <label for="location" class="control-label">Source Location:</label>
                </td>
                <td style="padding-bottom: 5%;">
                    <select id="source_loc" class="form-control link-style"
                            t-ref="this.source_loc"
                            style="width:400px;height:35px;border-radius:5px;">
                        <t t-foreach="this.props.data['location'] || []"
                           t-as="loc" t-key="loc.id">
                            <option t-att-value="loc.id"
                                    t-att-selected="loc.id==this.props.data['wh_stock']">
                                <t t-out="loc.display_name"/>
                            </option>
                        </t>
                    </select>
                </td>
            </tr>
            <tr style="width:75%;height:30px" id="dest_tr" t-ref="this.dest_tr">
                <td style="width:200px">
                    <label for="location" class="control-label">Destination Location:</label>
                </td>
                <td style="padding-bottom: 5%;">
                    <select id="dest_loc" class="form-control link-style"
                            t-ref="this.dest_loc"
                            style="width:400px;height:35px;border-radius:5px;">
                        <t t-foreach="this.props.data['location'] || []"
                           t-as="loc" t-key="loc.id">
                            <option t-att-value="loc.id"
                                    t-att-selected="loc.id==this.props.data['wh_stock']">
                                <t t-out="loc.display_name"/>
                            </option>
                        </t>
                    </select>
                </td>
                <br/>
            </tr>
            <tr style="width:75%;height:30px">
                <td style="width:200px">
                    <label for="location"
                           class="control-label">State:</label>
                </td>
                <td>
                    <select id="state" class="form-control link-style"
                            style="width:400px;height:35px;border-radius:5px;"
                            t-ref="this.stage">
                        <option value="draft">Draft</option>
                        <option value="assigned">Ready</option>
                        <option value="done">Done</option>
                    </select>
                </td>
            </tr>
        </center>
        <br/>
        <div class="footer pb-3">
        </div>
    </div>
        <t t-set-slot="footer">
            <div class="d-flex flex-grow-1 justify-content-center">
                <button  class="btn btn-primary btn-lg lh-lg o-default-button me-2" tabindex="1" t-on-click="() => this.confirm()">
                    <t t-out="this.props.confirmButtonLabel || 'Ok'" />
                </button>
                <button class="btn btn-secondary btn-lg lh-lg o-default-button" tabindex="1" t-on-click="() => this.cancel()">
                    <t t-out="'Discard'"/>
                </button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>