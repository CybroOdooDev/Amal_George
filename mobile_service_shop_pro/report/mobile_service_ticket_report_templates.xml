<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mobile_service_shop.mobile_service_ticket_template">
        <t t-call="web.external_layout">
            <t t-call="web.html_container">
                <div style="margin-bottom:30px; text-align:center;margin-left:-8%;margin-top:2%;">
                    <h2>Service Ticket</h2>
                </div>
                <div class="page">
                    <div class="col-xs-6"
                         style="margin-top:0%; margin-left:2%;">
                        <table style="width:100%;">
                            <tbody style="line-height:2">
                                <tr>
                                    <td>
                                        <strong>Ref no</strong>
                                    </td>
                                    <td style="padding-left:2%;">
                                        <strong>
                                            <span style="font-size:16px; font-weight:2px;"
                                                  t-esc="sev_id"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Customer name</strong>
                                    </td>
                                    <td style="padding-left:2%;">
                                        <span t-esc="customer_name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Requested date</strong>
                                    </td>
                                    <td style="padding-left:2%;">
                                        <span t-esc="date_request"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Return date</strong>
                                    </td>
                                    <td style="padding-left:2%;">
                                        <span t-esc="date_return"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xs-12"
                         style="margin-top:20%;margin-left:5%;text-align:center;">
                        <h4>Device details</h4>
                    </div>
                    <table style="margin-top:5%;margin-left:5%;width:90%;border:1px solid black;line-height:2;text-align:center;">
                        <thead style="background-color:#c9cacc;font-size:15px;">
                            <tr>
                                <td>Sl no.</td>
                                <td>Device brand</td>
                                <td>Model name</td>
                                <td>IMEI</td>
                                <td>Complaints</td>
                                <td>Image of Device</td>
                                <td>Description</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>
                                    <t t-esc="mobile_brand"/>
                                </td>
                                <td>
                                    <t t-esc="model_name"/>
                                </td>
                                <td>
                                    <t t-esc="imei_no"/>
                                </td>
                                <td>
                                    <t t-esc="complaint_types"/>
                                </td>
                                <td t-if="real_phone_image">
                                    <img style="height:50px; width:auto; padding:5px;"
                                         t-att-src="'data:image/png;base64,%s' %real_phone_image"/>
                                </td>
                                <td t-else=""/>
                                <td>
                                    <t t-esc="complaint_description"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div style="margin-top:10px;">
                    <t t-if="warranty==True">
                        <span>The device is in warranty range !!</span>
                    </t>
                </div>
                <div style="margin-top:30px;">
                    <h5>
                        <strong>Terms and Conditions</strong>
                    </h5>
                    <t t-foreach="terms" t-as="term">
                        <span>
                            <t t-esc="term.terms_conditions"/>
                            <br/>
                        </span>
                    </t>
                </div>
                <div style="margin-top:200px;">
                    <span>Keep this ticket safely for future reference.</span>
                    <br/>
                    <span>Issue Date :</span>
                    <t t-esc="date_today"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
