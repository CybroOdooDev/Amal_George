<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Form view of the model mobile service report-->
    <record id="mobile_service_report_view_form" model="ir.ui.view">
        <field name="name">Mobile Service Report View Form</field>
        <field name="model">mobile.service.report</field>
        <field name="arch" type="xml">
            <form string="Stock Report">
                <group>
                    <group>
                        <field name="date_start"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="date_end"/>
                        <field name="technician_id"/>
                    </group>
                </group>
                <footer>
                    <button name="print_pdf_report" string="Print PDF Report"
                            type="object" class="oe_highlight"/>
                    <button name="print_xlsx_report" string="Print XLSX Report"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--Action of the model mobile service report-->
    <record id="mobile_service_report_action" model="ir.actions.act_window">
        <field name="name">Mobile Service Report</field>
        <field name="res_model">mobile.service.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mobile_service_report_view_form"/>
        <field name="target">new</field>
    </record>

    <!--Menu item of the root reporting menu.-->
    <menuitem id="mobile_service_report_menu_root" name="Reports"
              parent="mobile_service_shop.mobile_service_shop_menu_root"
              sequence="2"/>
    <!--Menu item of the model mobile service report.-->
    <menuitem id="mobile_service_report_menu" name="Service Reports"
              action="mobile_service_report_action"
              parent="mobile_service_report_menu_root" sequence="2"/>
</odoo>
