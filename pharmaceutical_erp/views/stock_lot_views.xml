<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── stock.lot — inherit form to add pharma fields ────────────────── -->
    <record id="stock_lot_form_pharma" model="ir.ui.view">
        <field name="name">stock.lot.form.pharma</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <!-- The Odoo 19 lot form has no header, so create one before the sheet. -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_approve_lot" type="object"
                            string="Approve Lot" class="btn-primary"
                            invisible="lot_status not in ('quarantine', 'on_hold')"
                            groups="pharmaceutical_erp.group_pharma_qc_analyst"/>
                    <button name="action_reject_lot" type="object"
                            string="Reject Lot"
                            invisible="lot_status not in ('quarantine', 'on_hold')"
                            groups="pharmaceutical_erp.group_pharma_qc_analyst"/>
                    <button name="action_hold_lot" type="object"
                            string="Put On Hold"
                            invisible="lot_status not in ('approved', 'quarantine')"
                            groups="pharmaceutical_erp.group_pharma_qa_manager"/>
                    <field name="lot_status" widget="statusbar"
                           statusbar_visible="quarantine,approved,released"/>
                </header>
            </xpath>

            <!-- Pharma fields injected after the lot reference field -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="manufacture_date"/>
                <field name="expiry_date"/>
                <field name="retest_date"/>
                <field name="vendor_lot_number"/>
            </xpath>

            <!-- QA Status Change Info -->
            <xpath expr="//sheet" position="inside">
                <group string="Lot Status" name="pharma_status_group"
                       invisible="not lot_status">
                    <group>
                        <field name="lot_status" widget="badge"
                               decoration-warning="lot_status == 'quarantine'"
                               decoration-success="lot_status in ('approved','released')"
                               decoration-danger="lot_status in ('rejected','recalled')"
                               decoration-info="lot_status == 'on_hold'"/>
                        <field name="status_changed_by"/>
                        <field name="status_changed_on"/>
                    </group>
                    <group>
                        <field name="disposition_remarks"
                               placeholder="QA disposition justification…"/>
                    </group>
                </group>

                <!-- Vendor CoA attachment -->
                <group string="Vendor CoA">
                    <field name="vendor_coa" widget="binary" filename="vendor_coa_filename"/>
                    <field name="vendor_coa_filename" invisible="1"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- ─── stock.lot — list view with pharma columns ────────────────────── -->
    <record id="stock_lot_list_pharma" model="ir.ui.view">
        <field name="name">stock.lot.list.pharma</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="lot_status" widget="badge"
                       decoration-warning="lot_status == 'quarantine'"
                       decoration-success="lot_status in ('approved','released')"
                       decoration-danger="lot_status in ('rejected','recalled')"
                       decoration-info="lot_status == 'on_hold'"
                       optional="show"/>
                <field name="expiry_date" optional="show"/>
            </field>
        </field>
    </record>

    <!-- ─── Quarantine Queue — filtered list action ───────────────────────── -->
    <record id="pharma_quarantine_queue_action" model="ir.actions.act_window">
        <field name="name">Quarantine Queue</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lot_status', '=', 'quarantine')]</field>
        <field name="context">{'search_default_lot_status': 'quarantine'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No lots currently in quarantine.
            </p>
            <p>Lots arrive here automatically when a goods receipt is validated.</p>
        </field>
    </record>

    <!-- ─── Lot / Batch Control action ───────────────────────────────────── -->
    <record id="pharma_lot_control_action" model="ir.actions.act_window">
        <field name="name">Lot / Batch Control</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No lots found.
            </p>
        </field>
    </record>

</odoo>
