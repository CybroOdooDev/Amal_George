<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="vehicle_state_available" model="fleet.vehicle.state">
    <field name="name">Available</field>
    <field name="sequence">10</field>
    <field name="fold">False</field>
  </record>

  <record id="vehicle_state_reserved" model="fleet.vehicle.state">
    <field name="name">Reserved</field>
    <field name="sequence">20</field>
    <field name="fold">False</field>
  </record>

  <record id="vehicle_state_leased" model="fleet.vehicle.state">
    <field name="name">Leased</field>
    <field name="sequence">30</field>
    <field name="fold">False</field>
  </record>

  <record id="vehicle_state_maintenance" model="fleet.vehicle.state">
    <field name="name">Maintenance</field>
    <field name="sequence">40</field>
    <field name="fold">False</field>
  </record>

  <record id="vehicle_state_retired" model="fleet.vehicle.state">
    <field name="name">Retired</field>
    <field name="sequence">50</field>
    <field name="fold">False</field>
  </record>

  <record id="service_type_repair_maintenance" model="fleet.service.type">
    <field name="name">Repair / Maintenance</field>
    <field name="category">service</field>
  </record>

  <record id="base.main_company" model="res.company">
    <field name="x_studio_default_bike_state_id" ref="vehicle_state_available"/>
    <field name="x_studio_bike_state_ids" eval="[(6, 0, [
      ref('vehicle_state_available'),
      ref('vehicle_state_reserved'),
      ref('vehicle_state_leased'),
      ref('vehicle_state_maintenance'),
      ref('vehicle_state_retired')
    ])]"/>
  </record>
</odoo>
