<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ================================================================
         Mobile Service Pro — Settings panel inside Odoo Configuration
    ================================================================ -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mobile.service.shop.pro</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="65"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="after">
                <app data-string="Mobile Service"
                     string="Mobile Service"
                     name="mobile_service_shop_pro"
                     logo="/mobile_service_shop_pro/static/description/icon.png">

                    <block title="IMEI Lookup API — ImeiCheck.com" name="api_settings">

                        <setting id="get_api_details"
                                 title="IMEI Device Lookup &amp; Auto-Fill"
                                 help="When enabled, technicians can enter an IMEI number and click 'Get Details' to automatically populate device brand, model, and manufacturer from the ImeiCheck.com database. Please provide the credentials below to get device info.">
                            <field name="get_api_details" field_id="get_api_details_0"/>
                        </setting>

                        <setting id="api_key"
                                 string="ImeiCheck.com API Key"
                                 help="Your personal API key from ImeiCheck.com. Contact them via https://imeicheck.com/contact to register and receive limited credits for testing."
                                 invisible="not get_api_details">
                            <label string="API Key" for="api_key" class="col-md-3 o_light_label"/>
                            <field name="api_key"
                                   field_id="api_key_0"
                                   password="True"
                                   placeholder="Paste your ImeiCheck.com key here"
                                   required="get_api_details"/>
                            <div class="mt-2">
                                <button string="Login / Register on ImeiCheck.com"
                                        type="object"
                                        name="action_imeicheck_login"
                                        icon="oi-arrow-right"
                                        class="btn-link"
                                        help="Open ImeiCheck.com Login Dashboard"/>
                            </div>
                        </setting>

                    </block>

                    <block title="Device Image API — MobileAPI.dev" name="mobileapi_settings" invisible="not get_api_details">

                        <setting id="fetch_device_images"
                                 title="Fetch Device Images"
                                 help="Automatically fetch and display device images from MobileAPI.dev. Please provide the credentials below to get device images.">
                            <field name="fetch_device_images" field_id="fetch_device_images_0"/>
                        </setting>

                        <setting id="mobileapi_key"
                                 string="MobileAPI.dev API Key"
                                 help="API key to fetch device images from MobileAPI.dev."
                                 invisible="not fetch_device_images">
                            <label string="MobileAPI Key" for="mobileapi_key" class="col-md-3 o_light_label"/>
                            <field name="mobileapi_key"
                                   field_id="mobileapi_key_0"
                                   password="True"
                                   placeholder="Paste your MobileAPI.dev key here"
                                   required="fetch_device_images"/>
                            <div class="mt-2">
                                <button string="Login / Register on MobileAPI.dev"
                                        type="object"
                                        name="action_mobileapi_login"
                                        icon="oi-arrow-right"
                                        class="btn-link"
                                        help="Open MobileAPI.dev Sign-in Page"/>
                            </div>
                        </setting>

                    </block>

                    <block title="Printed Service Ticket Settings" name="ticket_settings">

                        <setting id="show_complain_types"
                                 title="Show Complaints on Service Tickets"
                                 help="When enabled, complaint types and descriptions are printed on customer-facing service ticket PDFs.">
                            <field name="show_complain_types" field_id="show_complain_types_0"/>
                        </setting>

                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Action to open Mobile Service settings directly -->
    <record id="res_config_settings_action_mobile_service_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'mobile_service_shop_pro'}</field>
    </record>
</odoo>
