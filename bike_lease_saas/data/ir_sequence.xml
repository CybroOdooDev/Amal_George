<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="seq_lease_application" model="ir.sequence">
    <field name="name">Lease Application Sequence</field>
    <field name="code">x_lease_application</field>
    <field name="prefix">APP/%(year)s/</field>
    <field name="padding">4</field>
    <field name="number_next">1</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="seq_lease_contract" model="ir.sequence">
    <field name="name">Lease Contract Sequence</field>
    <field name="code">x_lease_contract</field>
    <field name="prefix">CNT/%(year)s/</field>
    <field name="padding">4</field>
    <field name="number_next">1</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>
