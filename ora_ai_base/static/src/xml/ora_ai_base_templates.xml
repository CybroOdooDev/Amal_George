<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Futuristic Glassmorphic Voice Assistant Client Action Template -->
    <t t-name="ora_ai_base.voice_assistant" owl="1">
        <div class="ora_voice_assistant_root">
            <VoiceData 
                isTestMode="this.isTestMode" 
                configInfo="this.configInfo" 
                assistantName="this.state.assistant_name"
                onToggleCall="() => this.toggle_call()"
            />
        </div>
    </t>
</templates>
