<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manufacturers (Brands) -->
    <record id="manufacturer_honda" model="fleet.vehicle.model.brand" context="{'studio': True}">
        <field name="name">Honda</field>
        <field name="x_name">Honda</field>
        <field name="x_studio_sequence">10</field>
        <field name="x_studio_description">Honda Motor Co., Ltd. - Leading global manufacturer of reliable motorcycles and scooters.</field>
    </record>

    <record id="manufacturer_yamaha" model="fleet.vehicle.model.brand" context="{'studio': True}">
        <field name="name">Yamaha</field>
        <field name="x_name">Yamaha</field>
        <field name="x_studio_sequence">20</field>
        <field name="x_studio_description">Yamaha Motor Co., Ltd. - Renowned manufacturer of performance motorcycles and sporty scooters.</field>
    </record>

    <record id="manufacturer_vespa" model="fleet.vehicle.model.brand" context="{'studio': True}">
        <field name="name">Vespa</field>
        <field name="x_name">Vespa</field>
        <field name="x_studio_sequence">30</field>
        <field name="x_studio_description">Piaggio &amp; C. SpA - Premium Italian luxury scooter brand.</field>
    </record>

    <record id="manufacturer_bmw" model="fleet.vehicle.model.brand" context="{'studio': True}">
        <field name="name">BMW Motorrad</field>
        <field name="x_name">BMW Motorrad</field>
        <field name="x_studio_sequence">40</field>
        <field name="x_studio_description">BMW Motorrad - Premium German motorcycles and cutting-edge electric urban mobility vehicles.</field>
    </record>

    <!-- Bike Models -->
    <record id="model_activa_6g" model="fleet.vehicle.model" context="{'studio': True}">
        <field name="name">Activa 6G</field>
        <field name="x_name">Activa 6G</field>
        <field name="vehicle_type">bike</field>
        <field name="brand_id" ref="manufacturer_honda"/>
        <field name="x_studio_manufacturer" ref="manufacturer_honda"/>
        <field name="x_studio_bike_type">Scooter</field>
        <field name="x_studio_fuel_type">Petrol</field>
        <field name="x_studio_engine_capacity_cc_">110</field>
        <field name="x_studio_value">1200.0</field>
        <field name="x_studio_sequence">10</field>
        <field name="x_studio_text_1">Reliable and fuel-efficient 110cc urban commuter scooter.</field>
    </record>

    <record id="model_yamaha_r15" model="fleet.vehicle.model" context="{'studio': True}">
        <field name="name">YZF-R15 V4</field>
        <field name="x_name">YZF-R15 V4</field>
        <field name="vehicle_type">bike</field>
        <field name="brand_id" ref="manufacturer_yamaha"/>
        <field name="x_studio_manufacturer" ref="manufacturer_yamaha"/>
        <field name="x_studio_bike_type">Motorcycle</field>
        <field name="x_studio_fuel_type">Petrol</field>
        <field name="x_studio_engine_capacity_cc_">155</field>
        <field name="x_studio_value">2500.0</field>
        <field name="x_studio_sequence">20</field>
        <field name="x_studio_text_1">Premium 155cc supersport bike with VVA technology.</field>
    </record>

    <record id="model_vespa_urban" model="fleet.vehicle.model" context="{'studio': True}">
        <field name="name">Vespa Primavera 125</field>
        <field name="x_name">Vespa Primavera 125</field>
        <field name="vehicle_type">bike</field>
        <field name="brand_id" ref="manufacturer_vespa"/>
        <field name="x_studio_manufacturer" ref="manufacturer_vespa"/>
        <field name="x_studio_bike_type">Scooter</field>
        <field name="x_studio_fuel_type">Petrol</field>
        <field name="x_studio_engine_capacity_cc_">125</field>
        <field name="x_studio_value">3200.0</field>
        <field name="x_studio_sequence">30</field>
        <field name="x_studio_text_1">Iconic Italian luxury scooter for stylish city commuting.</field>
    </record>

    <record id="model_bmw_ce04" model="fleet.vehicle.model" context="{'studio': True}">
        <field name="name">CE 04 Electric</field>
        <field name="x_name">CE 04 Electric</field>
        <field name="vehicle_type">bike</field>
        <field name="brand_id" ref="manufacturer_bmw"/>
        <field name="x_studio_manufacturer" ref="manufacturer_bmw"/>
        <field name="x_studio_bike_type">Electric Bike</field>
        <field name="x_studio_fuel_type">Electric</field>
        <field name="x_studio_engine_capacity_cc_">0</field>
        <field name="x_studio_value">12500.0</field>
        <field name="x_studio_sequence">40</field>
        <field name="x_studio_text_1">Futuristic high-performance zero-emission electric urban scooter.</field>
    </record>


    <!-- Lease Plans -->
    <record id="plan_daily_flex" model="x_lease_plans" context="{'studio': True}">
        <field name="x_name">Daily Flex Lease Plan</field>
        <field name="x_studio_value">25.0</field>
        <field name="x_studio_lease_duration">1</field>
        <field name="x_studio_duration_unit">Days</field>
        <field name="x_studio_payment_frequency">Daily</field>
        <field name="x_studio_security_deposit">100.0</field>
        <field name="x_studio_late_fee_type">Fixed Amount</field>
        <field name="x_studio_late_fee">10.0</field>
        <field name="x_studio_description">Flexible short-term daily leasing for tourists and short trips.</field>
    </record>

    <record id="plan_weekly_standard" model="x_lease_plans" context="{'studio': True}">
        <field name="x_name">Weekly Standard Plan</field>
        <field name="x_studio_value">120.0</field>
        <field name="x_studio_lease_duration">1</field>
        <field name="x_studio_duration_unit">Weeks</field>
        <field name="x_studio_payment_frequency">Weekly</field>
        <field name="x_studio_security_deposit">250.0</field>
        <field name="x_studio_late_fee_type">Fixed Amount</field>
        <field name="x_studio_late_fee">25.0</field>
        <field name="x_studio_description">Cost-effective weekly lease for gig workers and temporary staff.</field>
    </record>

    <record id="plan_monthly_pro" model="x_lease_plans" context="{'studio': True}">
        <field name="x_name">Monthly Pro Commuter Plan</field>
        <field name="x_studio_value">350.0</field>
        <field name="x_studio_lease_duration">1</field>
        <field name="x_studio_duration_unit">Months</field>
        <field name="x_studio_payment_frequency">Monthly</field>
        <field name="x_studio_security_deposit">500.0</field>
        <field name="x_studio_late_fee_type">Percentage</field>
        <field name="x_studio_late_fee_percentage">5</field>
        <field name="x_studio_description">Comprehensive monthly lease package including routine maintenance.</field>
    </record>

    <record id="plan_annual_enterprise" model="x_lease_plans" context="{'studio': True}">
        <field name="x_name">Annual Enterprise Fleet Plan</field>
        <field name="x_studio_value">3600.0</field>
        <field name="x_studio_lease_duration">1</field>
        <field name="x_studio_duration_unit">Years</field>
        <field name="x_studio_payment_frequency">Monthly</field>
        <field name="x_studio_security_deposit">1000.0</field>
        <field name="x_studio_late_fee_type">Percentage</field>
        <field name="x_studio_late_fee_percentage">10</field>
        <field name="x_studio_description">Long-term 12-month corporate leasing solution.</field>
    </record>

    <!-- Rejection Reasons -->
    <record id="rejection_reason_docs" model="x_rejection_reason" context="{'studio': True}">
        <field name="x_name">Incomplete Documentation</field>
    </record>

    <record id="rejection_reason_credit" model="x_rejection_reason" context="{'studio': True}">
        <field name="x_name">Credit Check Failed</field>
    </record>

    <record id="rejection_reason_bike" model="x_rejection_reason" context="{'studio': True}">
        <field name="x_name">Bike Unavailable</field>
    </record>

    <record id="rejection_reason_criteria" model="x_rejection_reason" context="{'studio': True}">
        <field name="x_name">Unmet Eligibility Criteria</field>
    </record>

    <!-- Bike Inspection Issues -->
    <record id="bike_issue_body_scratch" model="x_bike_issue" context="{'studio': True}">
        <field name="x_name">Body Scratch / Paint Damage</field>
    </record>
    <record id="bike_issue_tire_puncture" model="x_bike_issue" context="{'studio': True}">
        <field name="x_name">Tire Wear / Puncture</field>
    </record>
    <record id="bike_issue_brake_pad" model="x_bike_issue" context="{'studio': True}">
        <field name="x_name">Brake Pad Worn</field>
    </record>
    <record id="bike_issue_mirror_broken" model="x_bike_issue" context="{'studio': True}">
        <field name="x_name">Side Mirror Broken</field>
    </record>
    <record id="bike_issue_headlight_cracked" model="x_bike_issue" context="{'studio': True}">
        <field name="x_name">Headlight / Indicator Cracked</field>
    </record>
    <record id="bike_issue_engine_noise" model="x_bike_issue" context="{'studio': True}">
        <field name="x_name">Engine / Mechanical Issue</field>
    </record>

    <!-- Demo Fleet Vehicles (Bikes) -->
    <record id="vehicle_activa_1" model="fleet.vehicle" context="{'studio': True}">
        <field name="model_id" ref="model_activa_6g"/>
        <field name="license_plate">KL-46-A-1001</field>
        <field name="state_id" ref="vehicle_state_available"/>
    </record>
    <record id="vehicle_yamaha_1" model="fleet.vehicle" context="{'studio': True}">
        <field name="model_id" ref="model_yamaha_r15"/>
        <field name="license_plate">KL-46-B-2002</field>
        <field name="state_id" ref="vehicle_state_available"/>
    </record>
    <record id="vehicle_vespa_1" model="fleet.vehicle" context="{'studio': True}">
        <field name="model_id" ref="model_vespa_urban"/>
        <field name="license_plate">KL-46-C-3003</field>
        <field name="state_id" ref="vehicle_state_available"/>
    </record>
    <record id="vehicle_bmw_1" model="fleet.vehicle" context="{'studio': True}">
        <field name="model_id" ref="model_bmw_ce04"/>
        <field name="license_plate">KL-46-E-4004</field>
        <field name="state_id" ref="vehicle_state_available"/>
    </record>
</odoo>

