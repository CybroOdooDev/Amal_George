<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lamess_payout_request_list" model="ir.ui.view">
        <field name="name">lamess.payout.request.list</field>
        <field name="model">lamess.payout.request</field>
        <field name="arch" type="xml">
            <list string="Richieste prelievo" default_order="create_date desc">
                <field name="partner_id"/>
                <field name="requested_at"/>
                <field name="gross_amount"/>
                <field name="traced_settlement_amount" optional="show"/>
                <field name="untraced_amount" optional="show"/>
                <field name="net_amount"/>
                <field name="state"/>
                <field name="requested_by_id"/>
                <field name="reviewed_by_id"/>
                <field name="paid_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_lamess_payout_request_form" model="ir.ui.view">
        <field name="name">lamess.payout.request.form</field>
        <field name="model">lamess.payout.request</field>
        <field name="arch" type="xml">
            <form string="Richiesta prelievo">
                <header>
                    <button name="action_mark_in_review" type="object" string="Metti in revisione" class="btn-secondary" invisible="state != 'requested'"/>
                    <button name="action_approve" type="object" string="Approva" class="btn-primary" invisible="state not in ('requested', 'review')"/>
                    <button name="action_reject" type="object" string="Rifiuta" class="btn-secondary" invisible="state not in ('requested', 'review', 'approved')"/>
                    <button name="action_mark_paid" type="object" string="Liquida" class="btn-success" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Annulla" class="btn-secondary" invisible="state not in ('requested', 'review', 'approved')"/>
                    <button name="action_open_vendor_bill" type="object" string="Apri autofattura" class="btn-secondary" invisible="not vendor_bill_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,review,approved,paid,rejected,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group string="Richiesta">
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="gross_amount"/>
                            <field name="requested_at" readonly="1"/>
                            <field name="requested_by_id" readonly="1"/>
                        </group>
                        <group string="Liquidazione">
                            <field name="taxable_base_amount" readonly="1"/>
                            <field name="withholding_amount" readonly="1"/>
                            <field name="administrative_fee_amount" readonly="1"/>
                            <field name="net_amount" readonly="1"/>
                            <field name="traced_settlement_amount" readonly="1"/>
                            <field name="untraced_amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Autofattura">
                            <field name="self_invoice_scenario" readonly="1"/>
                            <field name="vat_amount" readonly="1"/>
                            <field name="inps_total_amount" readonly="1"/>
                            <field name="inps_withheld_amount" readonly="1"/>
                            <field name="vendor_bill_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Review">
                            <field name="reviewed_at" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="review_note"/>
                        </group>
                        <group string="Pagamento">
                            <field name="paid_at" readonly="1"/>
                            <field name="paid_by_id" readonly="1"/>
                            <field name="accounting_move_id" readonly="1"/>
                            <field name="payment_note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Origine commissioni">
                            <button name="action_open_traced_settlements" type="object" string="Apri settlement collegati" class="btn-secondary"/>
                            <field name="settlement_trace_line_ids" readonly="state not in ('requested', 'review', 'approved')">
                                <list editable="bottom">
                                    <field name="period_id"/>
                                    <field name="settlement_id"/>
                                    <field name="settlement_state"/>
                                    <field name="settlement_amount"/>
                                    <field name="allocated_amount" sum="Totale collegato"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lamess_payout_request_search" model="ir.ui.view">
        <field name="name">lamess.payout.request.search</field>
        <field name="model">lamess.payout.request</field>
        <field name="arch" type="xml">
            <search string="Richieste prelievo">
                <field name="partner_id"/>
                <field name="state"/>
                <filter string="Aperte" name="open" domain="[('state', 'in', ['requested', 'review', 'approved'])]"/>
                <filter string="Da liquidare" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Liquidate" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Con importo non tracciato" name="untraced" domain="[('untraced_amount', '>', 0.0)]"/>
                <separator/>
                <filter string="Raggruppa per stato" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Raggruppa per consulente" name="group_partner" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_lamess_payout_request" model="ir.actions.act_window">
        <field name="name">Richieste prelievo</field>
        <field name="res_model">lamess.payout.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lamess_payout_request_search"/>
    </record>

    <menuitem id="menu_lamess_payout_request"
              name="Richieste prelievo"
              parent="lamess_commission.menu_lamess_network_root"
              action="action_lamess_payout_request"
              sequence="30"
              groups="base.group_system,lamess_network.group_network_manager,lamess_network.group_network_finance"/>
</odoo>
