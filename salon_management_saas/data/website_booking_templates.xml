<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for the Booking Page -->
    <template id="salon_booking_page_template" name="Salon Booking Portal">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Custom booking container -->
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-md-10">
                            <!-- Styled clean card with subtle premium accents -->
                            <div class="card border shadow-sm transition-all duration-300 hover-shadow" style="border-radius: 20px; overflow: hidden; background: #ffffff; border-color: #e2e8f0;">
                                <div class="p-5 text-center border-bottom" style="background: linear-gradient(135deg, #f5f3ff 0%, #fdf2f8 100%);">
                                    <h2 class="mb-2 font-weight-bold" style="font-weight: 800; color: #4c1d95; font-size: 2rem; letter-spacing: -0.02em;">Book an Appointment</h2>
                                    <p class="mb-0 text-muted" style="font-size: 1rem;">Select a service, date, and time slot to reserve your spot.</p>
                                </div>
                                <div class="card-body p-5">
                                    <form action="/website/form/x_appointment" method="post" class="s_website_form container-fluid" enctype="multipart/form-data" data-model_name="x_appointment" data-success_page="/booking/success">
                                        <!-- Step 1: Select Service Package -->
                                        <div class="form-group mb-4">
                                            <label for="x_studio_service_package" class="form-label font-weight-bold text-muted small text-uppercase" style="letter-spacing: 0.08em; font-weight: 700;">1. Select Service Package</label>
                                            <select name="x_studio_service_package" id="x_studio_service_package" class="form-select form-control custom-select-styled" required="required">
                                                <option value="">Choose a Service Package...</option>
                                                <t t-foreach="request.env['x_service_package'].sudo().search([('x_studio_status', '=', 'active')])" t-as="pkg">
                                                    <option t-att-value="pkg.id"><t t-out="pkg.x_name"/> - $<t t-out="pkg.x_studio_value"/></option>
                                                </t>
                                            </select>
                                        </div>

                                        <!-- Step 2: Select Beautician -->
                                        <div class="form-group mb-4">
                                            <label for="x_studio_staff_beautician" class="form-label font-weight-bold text-muted small text-uppercase" style="letter-spacing: 0.08em; font-weight: 700;">2. Select Beautician</label>
                                            <select name="x_studio_staff_beautician" id="x_studio_staff_beautician" class="form-select form-control custom-select-styled" required="required">
                                                <option value="">Choose a Beautician...</option>
                                                <t t-foreach="request.env['hr.employee'].sudo().search([])" t-as="emp">
                                                    <option t-att-value="emp.id"><t t-out="emp.name"/></option>
                                                </t>
                                            </select>
                                        </div>

                                        <!-- Step 3: Select Date -->
                                        <div class="form-group mb-4">
                                            <label for="x_studio_date" class="form-label font-weight-bold text-muted small text-uppercase" style="letter-spacing: 0.08em; font-weight: 700;">3. Select Date</label>
                                            <input type="date" name="x_studio_date" id="x_studio_date" class="form-control custom-input-styled" required="required"/>
                                        </div>

                                        <!-- Step 4: Select Time Slot -->
                                        <div class="form-group mb-4">
                                            <label for="x_studio_time_slot" class="form-label font-weight-bold text-muted small text-uppercase" style="letter-spacing: 0.08em; font-weight: 700;">4. Select Time Slot</label>
                                            <select name="x_studio_time_slot" id="x_studio_time_slot" class="form-select form-control custom-select-styled" required="required">
                                                <option value="">Choose date/beautician first...</option>
                                            </select>
                                        </div>

                                        <!-- Step 5: Customer Contact -->
                                        <div class="form-group mb-4">
                                            <label for="x_studio_partner_id" class="form-label font-weight-bold text-muted small text-uppercase" style="letter-spacing: 0.08em; font-weight: 700;">5. Customer Contact</label>
                                            <select name="x_studio_partner_id" id="x_studio_partner_id" class="form-select form-control custom-select-styled" required="required">
                                                <t t-foreach="request.env.user.partner_id" t-as="partner">
                                                    <option t-att-value="partner.id" t-att-selected="true"><t t-out="partner.name"/></option>
                                                </t>
                                            </select>
                                        </div>

                                        <!-- Hidden input to confirm the booking directly -->
                                        <input type="hidden" name="x_studio_selection_1" value="Confirmed"/>

                                        <!-- Submit Button -->
                                        <div class="text-center mt-5">
                                            <button type="submit" class="btn btn-primary btn-lg btn-block btn-gradient-purple" style="border-radius: 12px; font-weight: 600; height: 52px; border: none; font-size: 1.1rem; box-shadow: 0 4px 6px -1px rgba(109, 40, 217, 0.2);">Confirm Booking</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <style>
                .custom-select-styled, .custom-input-styled {
                    border-radius: 10px;
                    height: 48px;
                    border-color: #cbd5e1;
                    padding-left: 16px;
                    transition: border-color 0.2s, box-shadow 0.2s;
                }
                .custom-select-styled:focus, .custom-input-styled:focus {
                    border-color: #8b5cf6;
                    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
                }
                .btn-gradient-purple {
                    background: linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%);
                    color: white;
                    transition: opacity 0.2s, transform 0.2s;
                }
                .btn-gradient-purple:hover {
                    opacity: 0.95;
                    transform: translateY(-1px);
                    color: white;
                }
                .hover-shadow:hover {
                    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
                }
            </style>
        </t>
    </template>

    <!-- Success Confirmation Page -->
    <template id="salon_booking_success_page" name="Booking Confirmed">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container py-5 text-center">
                    <div class="card border mx-auto p-5 shadow-sm" style="max-width: 600px; border-radius: 20px; border-color: #e2e8f0; background: #ffffff;">
                        <div class="mb-4">
                            <span class="d-inline-flex align-items-center justify-content-center text-white rounded-circle btn-gradient-purple" style="width: 72px; height: 72px; font-size: 2.2rem; box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3);">✓</span>
                        </div>
                        <h2 class="mb-3 font-weight-bold" style="font-weight: 800; color: #4c1d95;">Booking Confirmed!</h2>
                        <p class="text-muted mb-4 fs-6">Thank you for booking with us. Your appointment has been scheduled successfully.</p>
                        <a href="/salon-booking" class="btn btn-outline-primary px-4 py-2" style="border-radius: 10px; font-weight: 600; border-color: #8b5cf6; color: #8b5cf6;">Book Another Appointment</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Register Website Page Records -->
    <record id="salon_booking_website_page" model="website.page">
        <field name="name">Salon Booking Portal</field>
        <field name="url">/salon-booking</field>
        <field name="view_id" ref="salon_booking_page_template"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>

    <record id="salon_booking_success_website_page" model="website.page">
        <field name="name">Booking Confirmed</field>
        <field name="url">/booking/success</field>
        <field name="view_id" ref="salon_booking_success_page"/>
        <field name="is_published">True</field>
        <field name="website_indexed">False</field>
    </record>

    <!-- Header Navigation Menu Item -->
    <record id="menu_salon_booking" model="website.menu">
        <field name="name">Book Appointment</field>
        <field name="url">/salon-booking</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">40</field>
    </record>

    <!-- Template for Services Page -->
    <template id="salon_services_page_template" name="Our Services">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container py-5">
                    <div class="text-center mb-5">
                        <h1 class="font-weight-bold" style="color: #0f172a; font-weight: 800; font-size: 2.75rem; letter-spacing: -0.02em;">Our Services</h1>
                        <p class="text-muted lead mx-auto" style="max-width: 600px; font-size: 1.1rem; line-height: 1.6;">Indulge in our range of premium beauty and styling services tailored just for you.</p>
                        <div style="width: 50px; height: 4px; background: linear-gradient(90deg, #8b5cf6 0%, #d946ef 100%); margin: 20px auto; border-radius: 2px;"></div>
                    </div>

                    <!-- Loop through Categories -->
                    <t t-foreach="request.env['x_service_category'].sudo().search([])" t-as="category">
                        <!-- Fetch active services for this category -->
                        <t t-set="services" t-value="request.env['x_service'].sudo().search([('x_active', '=', True), ('x_studio_service_category', '=', category.id)])"/>
                        <t t-if="services">
                            <div class="mb-5">
                                <h3 class="mb-4 font-weight-bold text-uppercase tracking-wider pl-3" style="color: #4c1d95; font-size: 1.15rem; letter-spacing: 0.1em; border-left: 4px solid #8b5cf6;"><t t-out="category.x_name"/></h3>
                                <div class="row">
                                    <t t-foreach="services" t-as="service">
                                        <div class="col-md-6 col-lg-4 mb-4">
                                            <div class="card h-100 border shadow-sm hover-grow" style="border-radius: 16px; overflow: hidden; background: #ffffff; border-color: #e2e8f0; transition: transform 0.25s, box-shadow: 0.25s;">
                                                <div class="card-body p-4 d-flex flex-column">
                                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                                        <h5 class="card-title font-weight-bold mb-0 text-dark" style="font-weight: 700; font-size: 1.15rem; color: #0f172a;"><t t-out="service.x_name"/></h5>
                                                        <span class="font-weight-bold px-2 py-1" style="font-size: 1.1rem; color: #8b5cf6; background: #f5f3ff; border-radius: 6px;">$<t t-out="service.x_studio_value"/></span>
                                                    </div>
                                                    
                                                    <p class="card-text text-muted flex-grow-1 small" style="line-height: 1.6; font-size: 0.9rem;"><t t-out="service.x_studio_description"/></p>
                                                    
                                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
                                                        <span>⏱ <t t-out="service.x_studio_duration_minutes"/> mins</span>
                                                        <span class="badge" style="background-color: #f3e8ff; color: #6b21a8; border-radius: 6px; padding: 4px 8px; font-weight: 600;"><t t-out="service.x_studio_gender"/></span>
                                                    </div>
                                                    
                                                    <div class="mt-4">
                                                        <a href="/salon-booking" class="btn btn-outline-purple btn-block py-2" style="border-radius: 10px; font-weight: 600; font-size: 0.95rem; border-color: #8b5cf6; color: #8b5cf6; transition: all 0.2s;">Book Now</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
            <style>
                .hover-grow:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.08), 0 8px 8px -6px rgba(0, 0, 0, 0.04) !important;
                }
                .btn-outline-purple {
                    border-color: #8b5cf6;
                    color: #8b5cf6;
                    background: transparent;
                }
                .btn-outline-purple:hover {
                    background: #8b5cf6;
                    color: white;
                }
            </style>
        </t>
    </template>

    <!-- Template for Service Packages Page -->
    <template id="salon_packages_page_template" name="Service Packages">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container py-5">
                    <div class="text-center mb-5">
                        <h1 class="font-weight-bold" style="color: #0f172a; font-weight: 800; font-size: 2.75rem; letter-spacing: -0.02em;">Exclusive Packages</h1>
                        <p class="text-muted lead mx-auto" style="max-width: 600px; font-size: 1.1rem; line-height: 1.6;">Save more and experience pure bliss with our curated wellness and beauty packages.</p>
                        <div style="width: 50px; height: 4px; background: linear-gradient(90deg, #8b5cf6 0%, #d946ef 100%); margin: 20px auto; border-radius: 2px;"></div>
                    </div>

                    <div class="row">
                        <t t-foreach="request.env['x_service_package'].sudo().search([('x_studio_status', '=', 'active')])" t-as="pkg">
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100 border shadow-sm hover-grow" style="border-radius: 20px; overflow: hidden; background: #ffffff; border-color: #e2e8f0; transition: transform 0.25s, box-shadow: 0.25s;">
                                    <div class="p-4 text-center border-bottom" style="background: #faf5ff;">
                                        <h4 class="font-weight-bold mb-1" style="color: #4c1d95; font-weight: 700;"><t t-out="pkg.x_name"/></h4>
                                        <div class="my-3">
                                            <span class="h1 font-weight-bold" style="color: #8b5cf6;">$<t t-out="pkg.x_studio_value"/></span>
                                        </div>
                                        <div class="d-flex justify-content-center align-items-center flex-wrap" style="gap: 6px;">
                                            <span class="badge text-white font-weight-bold" style="background: linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%); border-radius: 12px; font-size: 0.75rem; padding: 4px 10px;">Special Package</span>
                                            <t t-if="pkg.x_studio_end_date">
                                                <span class="badge font-weight-bold" style="background: #fef3c7; color: #b45309; border-radius: 12px; font-size: 0.75rem; padding: 4px 10px; border: 1px solid #fde68a;">Limited Time Offer: Expires <strong style="color: #dc2626; font-weight: 800; margin-left: 2px;"><t t-out="pkg.x_studio_end_date"/></strong></span>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="card-body p-4 d-flex flex-column">
                                        <p class="card-text text-muted mb-4 small" style="line-height: 1.6;"><t t-out="pkg.x_studio_description"/></p>
                                        
                                        <h6 class="font-weight-bold text-uppercase mb-3 small text-muted" style="letter-spacing: 0.05em; font-weight: 700;">Services Included:</h6>
                                        <ul class="list-unstyled flex-grow-1 mb-4">
                                            <t t-foreach="pkg.x_studio_many2many_1" t-as="srv">
                                                <li class="mb-2 text-muted small d-flex align-items-center">
                                                    <span class="text-success mr-2">✓</span> <t t-out="srv.x_name"/>
                                                </li>
                                            </t>
                                        </ul>

                                        <div>
                                            <a href="/salon-booking" class="btn btn-primary btn-block py-2 btn-gradient-purple" style="border-radius: 10px; font-weight: 600; border: none; font-size: 0.95rem;">Book Package</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Website Pages -->
    <record id="salon_services_website_page" model="website.page">
        <field name="name">Our Services</field>
        <field name="url">/salon-services</field>
        <field name="view_id" ref="salon_services_page_template"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>

    <record id="salon_packages_website_page" model="website.page">
        <field name="name">Service Packages</field>
        <field name="url">/salon-packages</field>
        <field name="view_id" ref="salon_packages_page_template"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>

    <!-- Header Navigation Menu Items -->
    <record id="menu_salon_services" model="website.menu">
        <field name="name">Services</field>
        <field name="url">/salon-services</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">20</field>
    </record>

    <record id="menu_salon_packages" model="website.menu">
        <field name="name">Packages</field>
        <field name="url">/salon-packages</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">30</field>
    </record>
</odoo>
