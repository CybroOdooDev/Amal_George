<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── product.template — add Pharma tab ─────────────────────────────── -->
    <record id="product_template_form_pharma" model="ir.ui.view">
        <field name="name">product.template.form.pharma</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Insert the Pharma tab after the Purchase tab -->
            <xpath expr="//page[@name='purchase']" position="after">
                <page name="pharma" string="Pharma">
                    <group string="Classification">
                        <group>
                            <field name="product_type_pharma"/>
                            <field name="pharmacopoeial_ref"/>
                            <field name="shelf_life_months"/>
                            <field name="storage_conditions" placeholder="e.g. Store below 25°C, protect from moisture and light"/>
                        </group>
                        <group>
                            <field name="drug_license_no"/>
                            <field name="hsn_code"/>
                        </group>
                    </group>

                    <!-- AVL sub-tab section -->
                    <separator string="Approved Vendor List (AVL)"/>
                    <field name="avl_ids" context="{'default_product_id': id}">
                        <list string="Approved Vendor List" editable="bottom">
                            <field name="vendor_id" required="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'approved'"
                                   decoration-warning="status == 'under_review'"
                                   decoration-danger="status == 'blocked'"/>
                            <field name="approval_date"/>
                            <field name="approved_by"/>
                            <field name="expiry_date"/>
                            <field name="vendor_item_code"/>
                            <field name="lead_time_days" string="Lead Time (Days)"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>

                    <!-- QC Spec sub-tab section -->
                    <separator string="QC Specifications"/>
                    <field name="qc_spec_ids" context="{'default_product_id': id}">
                        <list string="QC Specifications" editable="bottom">
                            <field name="name" required="1"/>
                            <field name="stage"/>
                            <field name="version"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'approved'"
                                   decoration-warning="state == 'review'"
                                   decoration-muted="state in ('draft','obsolete')"/>
                            <field name="pharmacopoeial_ref"/>
                            <field name="approval_date"/>
                            <field name="approved_by"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ─── product.template list — add pharma type column ───────────────── -->
    <record id="product_template_list_pharma" model="ir.ui.view">
        <field name="name">product.template.list.pharma</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <field name="product_type_pharma" string="Pharma Type" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
