<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherited form view of the model hr.employee-->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.ent.hr.employee.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!--Hide default resource_calendar_id, replaced by working_hour_id-->
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="working_hour_id"/>
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!--Add Shift Schedule tab after work_information page-->
            <xpath expr="//page[@name='work_information']" position="after">
                <page name="shift_schedule" string="Shift Schedule">
                    <field name="shift_schedule_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="hr_shift_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>