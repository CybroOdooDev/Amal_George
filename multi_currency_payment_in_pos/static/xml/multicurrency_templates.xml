<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- The 'multi_currency_payment_in_pos.PaymentScreenButtons' template extends PaymentScreenMethods -->
    <t t-name="multi_currency_payment_in_pos.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenMethods"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods')]" position="after">
            <div class="mc-wrapper">
                <!-- Toggle Row -->
                <div t-if="this.pos.config.enable_multicurrency"
                     class="mc-toggle-row">
                    <span class="mc-title">Multi-Currency</span>
                    <input type="checkbox" id="multi_currency_check"
                           name="multi_currency_check"
                           class="mc-toggle"
                           t-on-click="(ev) => this.show_options(ev)"/>
                </div>
                <!-- Main Multicurrency Panel -->
                <div class="mc-panel" id="multicurrency_container"
                     style="display:none">
                    <!-- Select Currency -->
                    <div class="mc-block">
                        <label class="mc-label">Select Currency</label>
                        <select class="mc-select currency_list"
                                t-on-change="(ev) => this.compute_currency(ev)">
                            <option value="selected disabled">
                            </option>
                            <t t-foreach="this.multi_currency?.currencies || []"
                               t-as="currency"
                               t-key="currency.id">
                                <option t-att-id="currency.id">
                                    <t t-out="currency.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <!-- Conversion Panel -->
                    <div class="mc-block" id="conversion_container"
                         style="display:none">
                        <label class="mc-label">Conversion</label>
                        <div class="mc-line">
                            <span>1 USD =</span>
                            <span class="mc-value usdamount">
                                <t t-out="this.multi_currency.usd_val"/>
                                <t t-out="this.multi_currency.name"/>
                            </span>
                        </div>
                        <div class="mc-line">
                            <span>Total Amount =</span>
                            <span class="mc-value total_amount">
                                <t t-out="this.multi_currency.total"/>
                                <t t-out="this.multi_currency.symbol"/>
                            </span>
                        </div>
                        <!-- Input Amount -->
                        <div class="mc-input-block">
                            <label class="mc-label">Pay Amount In</label>
                            <input type="number" id="multicurrency_input"
                                   class="mc-input multicurrency_input"/>
                        </div>
                        <button class="button mc-addpayment"
                                t-on-click="(ev) => this.multi_currency_payment_line(this.payment_methods_from_config[0])">
                            <i class="oi oi-filled me-1" data-icon="payments" role="img" aria-hidden="true"/>
                            Add Cash Payment
                        </button>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
    <!-- Extended PaymentScreenPaymentLines to show converted currency amount and symbol -->
    <t t-name="multi_currency_payment_in_pos.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension">
        <xpath expr="//span[hasclass('payment-name')]" position="after">
            <div class="payment-currency"
                 style="margin-left: 10px;margin-right: 10px;padding: 1rem;">
                <t t-if="line.converted_currency">
                    (<t t-out="line.converted_currency.amount"/>
                    <t t-out="line.converted_currency.symbol"/>)
                </t>
            </div>
        </xpath>
    </t>
</templates>
