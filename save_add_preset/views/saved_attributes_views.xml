<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_saved_attributes" model="ir.actions.act_window">
        <field name="name">Saved Attributes</field>
        <field name="res_model">saved.attributes</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_saved_attributes_list" model="ir.ui.view">
        <field name="name">saved_attributes_list</field>
        <field name="model">saved.attributes</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="attribute_id"/>
                <field name="value_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_saved_attributes_form" model="ir.ui.view">
        <field name="name">saved_attributes_form</field>
        <field name="model">saved.attributes</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="attribute_id"/>
                        <field name="value_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

</odoo>
