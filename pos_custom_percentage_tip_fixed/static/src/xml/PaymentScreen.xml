<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_percentage_tip_fixed.PaymentScreenTip" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <!-- Shows the tip percentage in the payment screen buttons -->
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <button t-if="this.pos.config.iface_tipproduct and this.pos.config.tip_product_id"
                class="button btn btn-secondary btn-lg d-flex justify-content-center align-items-center w-100 lh-lg"
                t-on-click="this.customTipButton">
                <i class="oi me-2" data-icon="percent"/>
                <span>Tip (<t t-out="this.tips.tip"/>)%</span>
            </button>
        </xpath>
    </t>
</templates>
