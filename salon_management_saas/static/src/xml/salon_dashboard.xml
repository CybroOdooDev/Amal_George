<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="salon_management_saas.SalonDashboard">
        <style>
            .o_action:has(.o_salon_dashboard) {
                overflow-y: auto !important;
                overflow-x: hidden !important;
            }
        </style>
        <div class="o_salon_dashboard p-4" style="background-color: #f8f9fa; overflow-x: hidden;">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0 text-gray-800" style="font-weight: 700; color: #2D3748;">Salon Analytics Dashboard</h1>
                <button class="btn btn-primary px-4" style="background-color: #00CEB3; border-color: #00CEB3; font-weight: 600;" t-on-click="() => this.loadData()">Refresh Data</button>
            </div>

            <!-- KPI Cards -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card shadow-sm border-left-primary py-2" style="border-left: 4px solid #00CEB3; border-radius: 8px;">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #00CEB3; font-size: 0.85rem; letter-spacing: 0.05em;">Today's Bookings</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" style="font-size: 1.6rem; color: #2D3748;"><t t-esc="this.state.today_bookings"/></div>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-calendar fa-2x text-gray-300" style="font-size: 2.2rem; color: #CBD5E0;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-left-success py-2" style="border-left: 4px solid #1cc88a; border-radius: 8px;">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #1cc88a; font-size: 0.85rem; letter-spacing: 0.05em;">Monthly Revenue (MTD)</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" style="font-size: 1.6rem; color: #2D3748;">$<t t-esc="this.state.monthly_revenue"/></div>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-usd fa-2x text-gray-300" style="font-size: 2.2rem; color: #CBD5E0;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-left-info py-2" style="border-left: 4px solid #36b9cc; border-radius: 8px;">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #36b9cc; font-size: 0.85rem; letter-spacing: 0.05em;">Active Chairs</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" style="font-size: 1.6rem; color: #2D3748;"><t t-esc="this.state.active_chairs"/></div>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-scissors fa-2x text-gray-300" style="font-size: 2.2rem; color: #CBD5E0;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Custom Interactive Charts and Tables -->
            <div class="row">
                <!-- Data Table -->
                <div class="col-xl-8 col-lg-7">
                    <div class="card shadow-sm mb-4" style="border-radius: 8px;">
                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between" style="background-color: #fff; border-bottom: 1px solid #E2E8F0; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                            <h6 class="m-0 font-weight-bold" style="color: #4e73df; font-size: 1rem;">Upcoming VIP Bookings</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0" style="border-radius: 4px; overflow: hidden;">
                                    <thead style="background-color: #EDF2F7; color: #4A5568;">
                                        <tr>
                                            <th>Booking ID</th>
                                            <th>Customer</th>
                                            <th>Time Slot</th>
                                            <th>Chair</th>
                                            <th>Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.vip_bookings" t-as="booking" t-key="booking.id">
                                            <tr>
                                                <td style="font-weight: 600;"><t t-esc="booking.x_name"/></td>
                                                <td><t t-esc="booking.x_studio_partner_id ? booking.x_studio_partner_id[1] : 'N/A'"/></td>
                                                <td><t t-esc="booking.x_studio_time_slot"/></td>
                                                <td><t t-esc="booking.x_studio_chair_num ? booking.x_studio_chair_num[1] : 'N/A'"/></td>
                                                <td style="font-weight: 600; color: #2B6CB0;">$<t t-esc="booking.x_studio_value"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="this.state.vip_bookings.length == 0">
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-4">No bookings found in database.</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Donut Chart -->
                <div class="col-xl-4 col-lg-5">
                    <div class="card shadow-sm mb-4" style="border-radius: 8px;">
                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between" style="background-color: #fff; border-bottom: 1px solid #E2E8F0; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                            <h6 class="m-0 font-weight-bold" style="color: #4e73df; font-size: 1rem;">Revenue Distribution</h6>
                        </div>
                        <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                            <!-- Premium SVG Donut Chart representing Revenue Share -->
                            <svg width="180" height="180" viewBox="0 0 42 42" class="donut">
                                <circle class="donut-hole" cx="21" cy="21" r="15.91549430918954" fill="#fff"></circle>
                                <circle class="donut-ring" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#E2E8F0" stroke-width="3.5"></circle>

                                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#00CEB3" stroke-width="3.5" stroke-dasharray="50 50" stroke-dashoffset="25"></circle>
                                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f6c23e" stroke-width="3.5" stroke-dasharray="30 70" stroke-dashoffset="75"></circle>
                                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#e74a3b" stroke-width="3.5" stroke-dasharray="20 80" stroke-dashoffset="105"></circle>
                                
                                <g class="chart-text">
                                    <text x="50%" y="53%" class="chart-number" style="font-size: 0.28em; font-weight: 700; text-anchor: middle; dominant-baseline: middle; fill: #2D3748;">
                                        Revenue
                                    </text>
                                </g>
                            </svg>
                            <div class="mt-4 text-center small" style="color: #4A5568;">
                                <span class="mr-3">
                                    <i class="fa fa-circle" style="color: #00CEB3;"></i> Hair (50%)
                                </span>
                                <span class="mr-3">
                                    <i class="fa fa-circle" style="color: #f6c23e;"></i> Nails (30%)
                                </span>
                                <span class="mr-3">
                                    <i class="fa fa-circle" style="color: #e74a3b;"></i> Makeup (20%)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Line & Radar Charts -->
            <div class="row">
                <!-- Line Chart -->
                <div class="col-md-6">
                    <div class="card shadow-sm mb-4" style="border-radius: 8px;">
                        <div class="card-header py-3" style="background-color: #fff; border-bottom: 1px solid #E2E8F0; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                            <h6 class="m-0 font-weight-bold" style="color: #4e73df; font-size: 1rem;">Revenue Growth Trend (Line Chart)</h6>
                        </div>
                        <div class="card-body">
                            <svg viewBox="0 0 500 200" class="w-100" style="height: 200px;">
                                <!-- Grid Lines -->
                                <line x1="50" y1="20" x2="480" y2="20" stroke="#EDF2F7" stroke-width="1"/>
                                <line x1="50" y1="70" x2="480" y2="70" stroke="#EDF2F7" stroke-width="1"/>
                                <line x1="50" y1="120" x2="480" y2="120" stroke="#EDF2F7" stroke-width="1"/>
                                <line x1="50" y1="170" x2="480" y2="170" stroke="#CBD5E0" stroke-width="1.5"/>

                                <!-- Trend Line -->
                                <path d="M 50 150 Q 150 110 250 130 T 450 40" fill="none" stroke="#4e73df" stroke-width="4"/>
                                <path d="M 50 150 Q 150 110 250 130 T 450 40 L 450 170 L 50 170 Z" fill="url(#lineGradient)" opacity="0.15"/>

                                <!-- Defs for Gradients -->
                                <defs>
                                    <linearGradient id="lineGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="#4e73df"/>
                                        <stop offset="100%" stop-color="#4e73df" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>

                                <!-- Points -->
                                <circle cx="50" cy="150" r="5" fill="#4e73df"/>
                                <circle cx="150" cy="115" r="5" fill="#4e73df"/>
                                <circle cx="250" cy="130" r="5" fill="#4e73df"/>
                                <circle cx="350" cy="85" r="5" fill="#4e73df"/>
                                <circle cx="450" cy="40" r="5" fill="#4e73df"/>

                                <!-- Labels -->
                                <text x="50" y="190" fill="#718096" font-size="10" text-anchor="middle">Week 1</text>
                                <text x="150" y="190" fill="#718096" font-size="10" text-anchor="middle">Week 2</text>
                                <text x="250" y="190" fill="#718096" font-size="10" text-anchor="middle">Week 3</text>
                                <text x="350" y="190" fill="#718096" font-size="10" text-anchor="middle">Week 4</text>
                                <text x="450" y="190" fill="#718096" font-size="10" text-anchor="middle">Week 5</text>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Radar Chart -->
                <div class="col-md-6">
                    <div class="card shadow-sm mb-4" style="border-radius: 8px;">
                        <div class="card-header py-3" style="background-color: #fff; border-bottom: 1px solid #E2E8F0; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                            <h6 class="m-0 font-weight-bold" style="color: #4e73df; font-size: 1rem;">Beautician Competency (Radar Chart)</h6>
                        </div>
                        <div class="card-body d-flex justify-content-center">
                            <svg width="220" height="200" viewBox="0 0 220 200" style="height: 200px;">
                                <!-- Web structure -->
                                <polygon points="110,10 200,75 165,175 55,175 20,75" fill="none" stroke="#E2E8F0" stroke-width="1"/>
                                <polygon points="110,40 170,85 147,150 73,150 50,85" fill="none" stroke="#E2E8F0" stroke-width="1"/>
                                <polygon points="110,70 140,95 128,125 92,125 80,95" fill="none" stroke="#E2E8F0" stroke-width="1"/>
                                
                                <!-- Axis Lines -->
                                <line x1="110" y1="100" x2="110" y2="10" stroke="#E2E8F0" stroke-width="1"/>
                                <line x1="110" y1="100" x2="200" y2="75" stroke="#E2E8F0" stroke-width="1"/>
                                <line x1="110" y1="100" x2="165" y2="175" stroke="#E2E8F0" stroke-width="1"/>
                                <line x1="110" y1="100" x2="55" y2="175" stroke="#E2E8F0" stroke-width="1"/>
                                <line x1="110" y1="100" x2="20" y2="75" stroke="#E2E8F0" stroke-width="1"/>

                                <!-- Labels -->
                                <text x="110" y="8" fill="#4A5568" font-size="8" text-anchor="middle" font-weight="bold">Hair</text>
                                <text x="205" y="78" fill="#4A5568" font-size="8" text-anchor="start" font-weight="bold">Nails</text>
                                <text x="170" y="185" fill="#4A5568" font-size="8" text-anchor="start" font-weight="bold">Makeup</text>
                                <text x="50" y="185" fill="#4A5568" font-size="8" text-anchor="end" font-weight="bold">Skin</text>
                                <text x="15" y="78" fill="#4A5568" font-size="8" text-anchor="end" font-weight="bold">Styling</text>

                                <!-- Skill Area 1 (Beautician A) -->
                                <polygon points="110,30 180,80 150,150 80,140 40,80" fill="#00CEB3" fill-opacity="0.3" stroke="#00CEB3" stroke-width="2"/>
                                <!-- Skill Area 2 (Beautician B) -->
                                <polygon points="110,60 140,90 135,120 70,160 30,75" fill="#4e73df" fill-opacity="0.2" stroke="#4e73df" stroke-width="2"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Polar Area & Horizontal Bar -->
            <div class="row">
                <!-- Polar Area Chart -->
                <div class="col-md-6">
                    <div class="card shadow-sm mb-4" style="border-radius: 8px;">
                        <div class="card-header py-3" style="background-color: #fff; border-bottom: 1px solid #E2E8F0; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                            <h6 class="m-0 font-weight-bold" style="color: #4e73df; font-size: 1rem;">Hourly Booking Density (Polar Area)</h6>
                        </div>
                        <div class="card-body d-flex justify-content-center">
                            <svg width="200" height="200" viewBox="0 0 200 200" style="height: 200px;">
                                <!-- Background circles -->
                                <circle cx="100" cy="100" r="80" fill="none" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="2,2"/>
                                <circle cx="100" cy="100" r="60" fill="none" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="2,2"/>
                                <circle cx="100" cy="100" r="40" fill="none" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="2,2"/>
                                
                                <!-- Segments -->
                                <path d="M 100 100 L 100 30 A 70 70 0 0 1 170 100 Z" fill="#00CEB3" fill-opacity="0.75"/>
                                <path d="M 100 100 L 170 100 A 70 70 0 0 1 100 170 Z" fill="#f6c23e" fill-opacity="0.75"/>
                                <path d="M 100 100 L 100 170 A 90 90 0 0 1 10 100 Z" fill="#e74a3b" fill-opacity="0.75"/>
                                <path d="M 100 100 L 10 100 A 50 50 0 0 1 100 30 Z" fill="#4e73df" fill-opacity="0.75"/>

                                <!-- Center Pin -->
                                <circle cx="100" cy="100" r="6" fill="#fff" stroke="#718096" stroke-width="2"/>

                                <!-- Text labels -->
                                <text x="145" y="55" fill="#2D3748" font-size="8" font-weight="bold">09:00 AM</text>
                                <text x="145" y="145" fill="#2D3748" font-size="8" font-weight="bold">12:00 PM</text>
                                <text x="55" y="145" fill="#2D3748" font-size="8" font-weight="bold">03:00 PM</text>
                                <text x="55" y="55" fill="#2D3748" font-size="8" font-weight="bold">05:30 PM</text>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Horizontal Bar Chart -->
                <div class="col-md-6">
                    <div class="card shadow-sm mb-4" style="border-radius: 8px;">
                        <div class="card-header py-3" style="background-color: #fff; border-bottom: 1px solid #E2E8F0; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                            <h6 class="m-0 font-weight-bold" style="color: #4e73df; font-size: 1rem;">Top Packages (Horizontal Bar Chart)</h6>
                        </div>
                        <div class="card-body">
                            <!-- Package 1 -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small font-weight-bold mb-1" style="color: #4A5568;">
                                    <span>Bridal Makeover Package</span>
                                    <span>85%</span>
                                </div>
                                <div class="progress" style="height: 15px; border-radius: 4px; background-color: #E2E8F0;">
                                    <div class="progress-bar" role="progressbar" style="width: 85%; background-color: #00CEB3;" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                            <!-- Package 2 -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small font-weight-bold mb-1" style="color: #4A5568;">
                                    <span>Hair Spa &amp; Keratin Treatment</span>
                                    <span>65%</span>
                                </div>
                                <div class="progress" style="height: 15px; border-radius: 4px; background-color: #E2E8F0;">
                                    <div class="progress-bar" role="progressbar" style="width: 65%; background-color: #4e73df;" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                            <!-- Package 3 -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small font-weight-bold mb-1" style="color: #4A5568;">
                                    <span>Pedicure &amp; Nail Art Combo</span>
                                    <span>45%</span>
                                </div>
                                <div class="progress" style="height: 15px; border-radius: 4px; background-color: #E2E8F0;">
                                    <div class="progress-bar" role="progressbar" style="width: 45%; background-color: #f6c23e;" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
