  <!-- QWeb Template for Lease Contract PDF Report -->
  <template id="report_lease_contract_document">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page" style="font-family: inherit; font-size: 13px; color: #212529;">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
              <div>
                <h3 class="fw-bold mb-0">Bike Lease Contract</h3>
                <div class="text-muted small">Ref: <span t-field="o.x_name"/></div>
              </div>
              <div class="text-end">
                <span class="badge text-bg-secondary px-3 py-2 fs-6" t-field="o.x_studio_selection_1"/>
              </div>
            </div>

            <!-- Lessee & Bike Information -->
            <div class="row mb-4">
              <div class="col-6">
                <h6 class="fw-bold text-uppercase text-muted border-bottom pb-1 mb-2">Customer Details</h6>
                <table class="table table-borderless table-sm mb-0">
                  <tr>
                    <td class="text-muted ps-0" style="width: 35%;">Customer:</td>
                    <td class="fw-bold"><span t-field="o.x_studio_partner_id.name"/></td>
                  </tr>
                  <tr t-if="o.x_studio_partner_phone">
                    <td class="text-muted ps-0">Phone:</td>
                    <td><span t-field="o.x_studio_partner_phone"/></td>
                  </tr>
                  <tr t-if="o.x_studio_partner_email">
                    <td class="text-muted ps-0">Email:</td>
                    <td><span t-field="o.x_studio_partner_email"/></td>
                  </tr>
                </table>
              </div>
              <div class="col-6">
                <h6 class="fw-bold text-uppercase text-muted border-bottom pb-1 mb-2">Lease Specifications</h6>
                <table class="table table-borderless table-sm mb-0">
                  <tr>
                    <td class="text-muted ps-0" style="width: 35%;">Bike:</td>
                    <td class="fw-bold"><span t-field="o.x_studio_bike.name"/></td>
                  </tr>
                  <tr>
                    <td class="text-muted ps-0">Model:</td>
                    <td><span t-field="o.x_studio_bike_model.name"/></td>
                  </tr>
                  <tr t-if="o.x_studio_bike.license_plate">
                    <td class="text-muted ps-0">License Plate:</td>
                    <td><span t-field="o.x_studio_bike.license_plate"/></td>
                  </tr>
                  <tr>
                    <td class="text-muted ps-0">Plan:</td>
                    <td><span t-field="o.x_studio_lease_plan.x_name"/></td>
                  </tr>
                  <tr>
                    <td class="text-muted ps-0">Lease Dates:</td>
                    <td><span t-field="o.x_studio_date"/> to <span t-field="o.x_studio_end_date"/></td>
                  </tr>
                </table>
              </div>
            </div>

            <!-- Installment Schedule -->
            <div class="mb-4" t-if="o.x_studio_installment_ids">
              <h6 class="fw-bold text-uppercase text-muted border-bottom pb-1 mb-2">Installment Schedule</h6>
              <table class="table table-sm align-middle" style="font-size: 12px;">
                <thead>
                  <tr class="border-bottom text-muted">
                    <th class="ps-0">Installment</th>
                    <th>Due Date</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Late Fee</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="o.x_studio_installment_ids" t-as="inst">
                    <tr class="border-bottom">
                      <td class="ps-0"><span t-field="inst.x_name"/></td>
                      <td><span t-field="inst.x_studio_date"/></td>
                      <td class="text-end"><span t-out="inst.x_studio_amount" t-options="{'widget': 'monetary', 'display_currency': o.env.company.currency_id}"/></td>
                      <td class="text-end"><span t-out="inst.x_studio_late_fee_amount" t-options="{'widget': 'monetary', 'display_currency': o.env.company.currency_id}"/></td>
                      <td class="text-end"><span t-out="inst.x_studio_total_amount" t-options="{'widget': 'monetary', 'display_currency': o.env.company.currency_id}"/></td>
                      <td class="text-center"><span t-field="inst.x_studio_payment_state"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>

            <!-- Bike Returned & Inspected Status -->
            <div class="mb-4" t-if="o.x_studio_bike_returned">
              <h6 class="fw-bold text-uppercase text-muted border-bottom pb-1 mb-2">Bike Returned &amp; Inspected Status</h6>
              <table class="table table-borderless table-sm mb-2" style="max-width: 600px;">
                <tr>
                  <td class="text-muted ps-0" style="width: 40%;">Returned &amp; Inspected:</td>
                  <td class="fw-bold text-success">Yes</td>
                </tr>
                <tr>
                  <td class="text-muted ps-0">Service / Repair Needed:</td>
                  <td>
                    <span t-if="o.x_studio_service_needed" class="text-danger fw-bold">Yes</span>
                    <span t-if="not o.x_studio_service_needed" class="text-success">No</span>
                  </td>
                </tr>
                <tr t-if="o.x_studio_service_needed">
                  <td class="text-muted ps-0">Repair Charge:</td>
                  <td><span t-out="o.x_studio_repair_charge" t-options="{'widget': 'monetary', 'display_currency': o.env.company.currency_id}"/></td>
                </tr>
                <tr t-if="o.x_studio_refund_amount">
                  <td class="text-muted ps-0">Deposit Refund Amount:</td>
                  <td><span t-out="o.x_studio_refund_amount" t-options="{'widget': 'monetary', 'display_currency': o.env.company.currency_id}"/></td>
                </tr>
                <tr t-if="o.x_studio_extra_charge">
                  <td class="text-muted ps-0">Extra Charge:</td>
                  <td><span t-out="o.x_studio_extra_charge" t-options="{'widget': 'monetary', 'display_currency': o.env.company.currency_id}"/></td>
                </tr>
              </table>

              <div t-if="o.x_studio_issue_ids" class="mt-2">
                <div class="text-muted small mb-1 fw-bold">Inspection Issues Identified:</div>
                <ul class="list-inline mb-0">
                  <t t-foreach="o.x_studio_issue_ids" t-as="issue">
                    <li class="list-inline-item badge bg-light text-dark border me-1"><span t-field="issue.x_name"/></li>
                  </t>
                </ul>
              </div>
            </div>

          </div>
        </t>
      </t>
    </t>
  </template>

  <!-- Res Config Settings View for Bike Lease Management -->
  <record id="res_config_settings_view_form_bike_lease" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.bike.lease</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="90"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="Bike Lease" id="bike_lease_saas" string="Bike Lease Management" name="bike_lease_saas">
          <block title="Bike Fleet Stages Configuration" id="bike_fleet_stages_settings">
            <setting string="Bike Vehicle Stages" help="Select default initial stage and allowed operational stages for bike vehicles in the fleet vehicle model.">
              <div class="content-group mt16">
                <div class="row mt16">
                  <label for="x_studio_default_bike_state_id" string="Default Bike Stage" class="col-lg-4 o_light_label"/>
                  <field name="x_studio_default_bike_state_id" class="oe_inline" domain="[('id', 'in', x_studio_bike_state_ids)]"/>
                </div>
                <div class="row mt16">
                  <label for="x_studio_bike_state_ids" string="Allowed Bike Stages" class="col-lg-4 o_light_label"/>
                  <field name="x_studio_bike_state_ids" widget="many2many_tags" placeholder="Select bike stages..."/>
                </div>
              </div>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
